@model ProdutoModel

@{
    ViewData["Titulo"] = "Adicionar produto";
}

<style>
    
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-theme-gray text-white d-flex align-items-center">
            <h5 class="mb-0">Cadastrar produto</h5>
        </div>
        <div class="card-body">
            <form id="formProduto" method="post" enctype="multipart/form-data" asp-controller="Produto" asp-action="Adicionar">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Código de barra -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="codigoBarras" class="col-form-label">Codigo de barra</label>
                    </div>
                    <div class="col-md-4">
                        <input id="codigoBarras" type="text" asp-for="CodigoBarras" />
                    </div>
                    <div class="col-md-6">
                        <span asp-validation-for="CodigoBarras" class="text-danger"></span>
                        <span class="form-text">Informe o código de barras caso possúa.</span>
                    </div>
                </div>

                <!-- Descricao -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="descricao" class="col-form-label">Descrição</label>
                    </div>
                    <div class="col-md-4">
                        <input id="descricao" type="text" asp-for="Descricao" />
                    </div>
                    <div class="col-md-6">
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                        <span class="form-text">Informe a descrição do produto.</span>
                    </div>
                </div>

                <!-- Tipo de Movimento -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="tipoMovimento" class="col-form-label">Tipo movimento</label>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="TipoMovimento" id="entrada" value="1" checked>
                            <label class="form-check-label" for="entrada">Entrada</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="TipoMovimento" id="saida" value="0">
                            <label class="form-check-label" for="saida">Saída</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <span asp-validation-for="TipoMovimento" class="text-danger"></span>
                        <span class="form-text">Informe se o produto é de entrada ou saída.</span>
                    </div>
                </div>

                <!-- Preço de compra -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="precoCompra" class="col-form-label">Preço de compra | % lucro</label>
                    </div>
                    <div class="col-md-3">
                        <input id="precoCompra" type="text" asp-for="PrecoCompra" class="money" required />
                        <span asp-validation-for="PrecoCompra" class="text-danger"></span>
                    </div>
                    <div class="col-md-1">
                        <input id="margem" type="text" asp-for="MargemLucro" placeholder="%" onblur="return calcular();" />
                    </div>
                    <div class="col-md-6">
                        <span class="form-text">Informe o preço de compra e a margem que deseja obter sobre.</span>
                    </div>
                </div>

                <!-- Preço de venda -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="precoVenda" class="col-form-label">Preço de venda</label>
                    </div>
                    <div class="col-md-3">
                        <input id="precoVenda" type="text" asp-for="PrecoVenda" class="money" required />
                        <span asp-validation-for="PrecoCompra" class="text-danger"></span>
                    </div>
                    <div class="col-md-1"></div>
                    <div class="col-md-6">
                        <span class="form-text">O preço de venda será calcualado automaticamente com base na multiplicação (P.C x %).</span>
                    </div>
                </div>

                <!-- Unidade -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="unidade" class="col-form-label">Unidade</label>
                    </div>
                    <div class="col-md-4">
                        <select id="unidade" asp-for="UnidadeMedida" required>
                            <option value="">Selecione</option>
                        </select>
                        <span asp-validation-for="UnidadeMedida" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <span class="form-text">Informe a unidade de medida do produto.</span>
                    </div>
                </div>

                <!-- Estoque -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="estoque" class="col-form-label">Estoque</label>
                    </div>
                    <div class="col-md-4">
                        <input id="estoque" type="text" asp-for="Estoque" onkeypress="return somenteNumeros(this)" required />
                        <span asp-validation-for="Estoque" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <span class="form-text">Informe a quantidade do produto em estoque.</span>
                    </div>
                </div>

                <!-- Estoque mínimo -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="estoqueMin" class="col-form-label">Estoque mínimo</label>
                    </div>
                    <div class="col-md-4">
                        <input id="estoqueMin" type="text" asp-for="EstoqueMin" onkeypress="return somenteNumeros(this)" required />
                        <span asp-validation-for="EstoqueMin" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <span class="form-text">Informe a quantidade mínima que que produto pode ficar em estoque.</span>
                    </div>
                </div>

                <!-- Imagem -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="imagem" class="col-form-label">Imagem</label>
                    </div>
                    <div class="col-md-4">
                        <input type="file" id="imagem" name="imagemProduto" accept="image/*" />
                    </div>
                    <div class="col-md-6">
                        <span class="form-text">Selecione a imagem do produto caso necessário.</span>
                    </div>
                </div>

                <!-- Botões -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-auto">
                        <a class="button btn btn-warning w-100" asp-controller="Produto" asp-action="Index">
                            <span class="button__icon"><i class="bx bx-undo"></i></span>
                            <span class="button__text2">Voltar</span>
                        </a>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="button btn btn-mini btn-success w-100">
                            <span class="button__icon"><i class='bx bx-save'></i></span>
                            <span class="button__text2">Adicionar</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script type="text/javascript">

    // Função para calcular o lucro
    function calcLucro(precoCompra, margemLucro) {
        if ($("#precoCompra").val() == null || $("#precoCompra").val() == '') {
            Swal.fire("Atenção!", "Preencher valor da compra primeiro.", "warning");
            $('#margem').val('');
            $('#precoVenda').val('');
            $("#precoCompra").focus();
            return false;
        }

        var precoVenda = (precoCompra * (1 + (margemLucro / 100))).toFixed(2);
        var precoVendaFormatado = parseFloat(precoVenda).toLocaleString('pt-BR', {
            style: 'currency',
            currency: 'BRL',
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

        $('#precoVenda').val(precoVendaFormatado.replace('R$', '').trim());
    }

    function calcular() {
        var precoCompra = parseFloat($("#precoCompra").cleanVal().replace('.', '').replace(',', '.'));
        var margemLucro = parseFloat($("#margem").val().replace('%', ''));
        calcLucro(precoCompra, margemLucro);
    }

    $(document).ready(function () {
        $(".money").mask("#.##0,00", {reverse: true});
        $('#margem').mask('000,00', {reverse: true});

        // Carrega as unidades de medida do arquivo JSON
        $.getJSON('@Url.Content("~/json/unidades_medida.json")', function (data) {
            if (data && data.medidas && data.medidas.length > 0) {
                for (var i = 0; i < data.medidas.length; i++) {
                    $('#unidade').append(new Option(data.medidas[i].display + ' (' + data.medidas[i].code + ')', data.medidas[i].code));
                }
            } else {
                console.error('Arquivo JSON não possui as medidas esperadas.');
            }
        }).fail(function () {
            console.error("Erro ao carregar o arquivo JSON.");
        });

        $.validator.addMethod("extension", function (value, element, param) {
            var extension = value.split('.').pop().toLowerCase();
            return this.optional(element) || param.split('|').indexOf(extension) !== -1;
        }, "Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).");

        $('#formProduto').validate({
            rules: {
                'Descricao': { required: true },
                'PrecoCompra': { required: true },
                'PrecoVenda': { required: true },
                'UnidadeMedida': { required: true },
                'Estoque': { required: true },
                'imagemProduto': { extension: "jpg|jpeg|png|gif|bmp" }
            },
            messages: {
                'Descricao': { required: 'Campo requerido.' },
                'PrecoCompra': { required: 'Campo requerido.' },
                'PrecoVenda': { required: 'Campo requerido.' },
                'UnidadeMedida': { required: 'Campo requerido.' },
                'Estoque': { required: "Campo requerido" },
                'imagemProduto': { extension: 'Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).' }
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });
</script>