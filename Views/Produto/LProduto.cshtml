@using SIGES.Helpers
@using SIGES.ViewModel
@model ProdutoViewModel

@{
    ViewData["Titulo"] = "Produtos";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Produtos</h5>
    </div>
    <div class="span12" style="margin-left: 0">
        <div class="span3">
            @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "aProduto"))
            {
                <a role="button" class="button btn btn-mini btn-success" style="max-width: 100px" asp-controller="Produto" asp-action="Adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Produto</span>
                </a>
            }
            else
            {
                <a role="button" class="button btn btn-mini btn-secondary disabled" style="max-width: 100px" title="Você não tem permissão para adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Produto</span>
                </a>
            }
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content">
            <table id="tabela">
                <thead>
                    <tr>
                        <th style="text-align: center;">Cód</th>
                        <th>Cod. barra</th>
                        <th>Nome</th>
                        <th>Estoque</th>
                        <th>Preço</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Produtos == null || Model.Produtos.Count == 0)
                    {
                        <tr>
                            <td colspan="3">Nenhum produto cadastrado</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var produto in Model.Produtos)
                        {
                            <tr>
                                <td style="width: 5%; text-align: center;">@produto.Id</td>
                                <td style="width: 20%;">@produto.CodigoBarras</td>
                                <td style="width: 30%;">@produto.Descricao</td>
                                <td style="width: 10%;">@produto.Estoque</td>
                                <td style="width: 10%;">@produto.PrecoVenda.ToString("C")</td>
                                <td style="width: 15%;">
                                    <a href="#" data-entidade="ProdutoModel" data-id="@produto.Id" style="margin-right: 1%" class="btn-nwe7 btn-exibir-log text-decoration-none" title="Exibir histórico">
                                        <i class='bx bx-history'></i>
                                    </a>
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eProduto"))
                                    {
                                        <a asp-controller="Produto" asp-action="Editar" asp-route-id="@produto.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none" title="Editar produto">
                                            <i class="bx bx-edit bx-xs"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a role="button" class="btn-nwe3-disabled text-decoration-none disabled" style="margin-right: 1%" title="Você não tem permissão para editar">
                                            <i class="bx bx-edit bx-xs"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "dProduto"))
                                    {
                                        <a href="#modal-excluir" data-id="@produto.Id" role="button" data-bs-target="#modal-excluir" data-bs-toggle="modal" style="margin-right: 1%" class="btn-nwe4 text-decoration-none" title="Excluir categoria">
                                            <i class="bx bx-trash-alt bx-xs"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a role="button" class="btn-nwe3-disabled text-decoration-none disabled" style="margin-right: 1%" title="Você não tem permissão para excluir">
                                            <i class="bx bx-trash-alt bx-xs"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eProduto"))
                                    {
                                        <a href="#modal-atualizar-estoque" data-id="@produto.Id" data-estoque="@produto.Estoque" role="button" data-bs-target="#modal-atualizar-estoque"
                                            data-bs-toggle="modal" style="margin-right: 1%" class="btn-nwe5 text-decoration-none" title="Atualizar estoque">
                                            <i class="bx bx-plus-circle bx-xs"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a role="button" class="btn-nwe4-disabled text-decoration-none disabled" style="margin-right: 1%" title="Você não tem permissão para atualizar estoque">
                                            <i class="bx bx-plus-circle bx-xs"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<!-- Modal excluir -->
<div id="modal-excluir" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Produto" asp-action="Excluir">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Excluir produto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="idProduto" name="id" />
                    <h6 style="text-align: center">
                        Deseja realmente excluir este produto?
                    </h6>
                </div>
                <div class="modal-footer" style="display:flex;justify-content: center">
                    <button type="button" class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true">
                        <span class="button__icon"><i class="bx bx-x"></i></span>
                        <span class="button__text2">Cancelar</span>
                    </button>
                    <button type="submit" class="button btn btn-danger">
                        <span class="button__icon"><i class='bx bx-trash'></i></span>
                        <span class="button__text2">Excluir</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal atualizar estoque -->
<div id="modal-atualizar-estoque" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formEstoque" method="post" asp-controller="Produto" asp-action="AtualizarEstoque">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Atualizar estoque</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="control-group col-md-4">
                        <label for="estoqueAtual" class="control-label">Estoque Atual</label>
                        <div class="controls">
                            <input id="estoqueAtual" type="text" name="estoqueAtual" value="" readonly />
                        </div>
                    </div>

                    <div class="control-group col-md-4">
                        <label for="estoque" class="control-label">Adicionar Produtos</label>
                        <div class="controls">
                            <input type="hidden" id="idProduto" class="idProduto" name="id" value="" />
                            <input id="estoque" type="text" name="estoque" value="" required onkeypress="return somenteNumeros(this)" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="display:flex;justify-content: center">
                    <button class="button btn btn-primary">
                        <span class="button__icon"><i class="bx bx-sync"></i></span>
                        <span class="button__text2">Atualizar</span>
                    </button>
                    <button type="button" class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true">
                        <span class="button__icon"><i class="bx bx-x"></i></span>
                        <span class="button__text2">Cancelar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")

<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', 'a', function (event) {
            var produto = $(this).data('id');
            var estoque = $(this).data('estoque');
            $('.idProduto').val(produto);
            $('#estoqueAtual').val(estoque);
        });

        $('#formEstoque').validate({
            rules: {
                'estoque': { required: true }
            },
            messages: {
                'estoque': { required: 'Campo requerido.' }
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });
</script>