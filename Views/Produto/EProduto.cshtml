@model ProdutoModel

@{
    ViewData["Titulo"] = "Editar produto";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Editar produto</h5>
        </div>
        <div class="card-body">
            <form id="formProduto" method="post" enctype="multipart/form-data" asp-controller="Produto" asp-action="Editar">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <!-- Código de barra -->
                <div class="mb-3 col-md-2">
                    <label for="codigoBarras" class="form-label">Codigo de barra</label>
                    <input id="codigoBarras" type="text" asp-for="CodigoBarras" />
                    <span asp-validation-for="CodigoBarras" class="text-danger"></span>
                </div>

                <!-- Descricao -->
                <div class="mb-3 col-md-2">
                    <label for="descricao" class="form-label">Descrição</label>
                    <input id="descricao" type="text" asp-for="Descricao" required />
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <!-- Tipo de Movimento -->
                <div class="mb-3">
                    <label for="tipoMovimento" class="form-label">Tipo movimento</label><br />
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="TipoMovimento" id="entrada" value="1"
                        @if (Model.TipoMovimento.Equals(1))
                        {
                            <text>checked</text>
                        }>
                        <label class="form-check-label" for="entrada">Entrada</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="TipoMovimento" id="saida" value="0"
                        @if (Model.TipoMovimento.Equals(0))
                        {
                            <text>checked</text>
                        }>
                        <label class="form-check-label" for="saida">Saída</label>
                    </div>
                    <span asp-validation-for="TipoMovimento" class="text-danger"></span>
                </div>

                <div class="row">
                    <!-- Preço de compra -->
                    <div class="mb-3 col-md-2">
                        <label for="precoCompra" class="form-label">Preço de compra</label>
                        <input id="precoCompra" type="text" asp-for="PrecoCompra" class="money" required />
                        <span asp-validation-for="PrecoCompra" class="text-danger"></span>
                    </div>

                    <!-- Margem -->
                    <div class="mb-3 col-1">
                        <label for="margem" class="form-label">Margem</label>
                        <input id="margem" type="text" asp-for="MargemLucro" placeholder="%"
                               onblur="calcLucro($('#precoCompra').val().replace('.', '').replace(',', '.'), $('#margem').val().replace('.', '').replace(',', '.')); return false;" />
                        <span asp-validation-for="MargemLucro" class="text-danger"></span>
                    </div>

                    <div class="mb-3 col-4 d-flex align-content-end flex-wrap">
                        <strong>
                            <span style="color: red" id="errorAlert"></span>
                        </strong>
                    </div>
                </div>

                <!-- Preço da venda -->
                <div class="mb-3 col-md-2">
                    <label for="precoVenda" class="form-label">Preço de venda</label>
                    <input id="precoVenda" type="text" asp-for="PrecoVenda" class="money" required />
                    <span asp-validation-for="PrecoVenda" class="text-danger"></span>
                </div>

                <!-- Unidade -->
                <div class="mb-3 col-md-2">
                    <label for="unidade" class="form-label">Unidade</label>
                    <select id="unidade" asp-for="UnidadeMedida" required>
                        <option value="">Selecione</option>
                    </select>
                    <span asp-validation-for="UnidadeMedida" class="text-danger"></span>
                </div>

                <!-- Estoque -->
                <div class="mb-3 col-md-2">
                    <label for="estoque" class="form-label">Estoque</label>
                    <input id="estoque" type="text" asp-for="Estoque" onkeypress="return somenteNumeros(this)" required />
                    <span asp-validation-for="Estoque" class="text-danger"></span>
                </div>

                <!-- Estoque mínimo -->
                <div class="mb-3 col-md-2">
                    <label for="estoqueMin" class="form-label">Estoque mínimo</label>
                    <input id="estoqueMin" type="text" asp-for="EstoqueMin" onkeypress="return somenteNumeros(this)" />
                    <span asp-validation-for="EstoqueMin" class="text-danger"></span>
                </div>

                <!-- Imagem -->
                <div class="mb-3 col-md-4">
                    <label for="imagem" class="form-label">Imagem</label>
                    <input type="file" id="imagem" name="imagemProduto" accept="image/*" />
                    @if (Model.ImagemBlob != null)
                    {
                        <p class="mt-2">Imagem cadastrada. Selecione uma nova imagem para substituir a existente.</p>
                    }
                    else
                    {
                        <span class="text-danger mt-2">Nenhuma imagem cadastrada. É obrigatório adicionar uma imagem.</span>
                    }
                </div>

                <div class="mb-3 text-center">
                    @if (Model.ImagemBlob != null)
                    {
                        <img src="data:image/png;base64,@Convert.ToBase64String(Model.ImagemBlob)" id="previewImg" class="img-fluid rounded" alt="Imagem do produto" style="max-width: 200px;" />
                    }
                    else
                    {
                        <img src="" id="previewImg" class="img-fluid rounded" alt="Pré-visualização da imagem" style="max-width: 200px; display:none;" />
                    }
                </div>

                <!-- Botões -->
                <div class="d-flex justify-content-center">
                    <a title="Voltar" class="button btn btn-warning" asp-controller="Produto" asp-action="Index">
                        <span class="button__icon"><i class="bx bx-undo"></i></span>
                        <span class="button__text2">Voltar</span>
                    </a>
                    <button type="submit" class="button btn btn-mini btn-success">
                        <span class="button__icon"><i class='bx bx-save'></i></span>
                        <span class="button__text2">Atualizar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script type="text/javascript">

    function previewImage(event) {
        const img = document.getElementById('previewImg');
        if (event.target.files.length > 0) {
            img.src = URL.createObjectURL(event.target.files[0]);
            img.onload = () => {
                URL.revokeObjectURL(img.src); // Libera memória
                img.style.display = "block";
            };
        } else {
            img.style.display = "none";
        }
    }

    function calcLucro(precoCompra, margemLucro) {
        var precoVenda = (precoCompra * (1 + (margemLucro / 100))).toFixed(2);
        $('#precoVenda').val(precoVenda.replace(".", ","));
    }

    $("#margem").keyup(function() {
        if ($("#precoCompra").val() == null || $("#precoCompra").val() == '') {
            $('#errorAlert').text('Preencher valor da compra primeiro.').css("display", "inline").fadeOut(5000);
            $('#margem').val('');
            $('#precoVenda').val('');
            $("#precoCompra").focus();
        }
    });

    $(document).ready(function () {
        $(".money").mask("#.##0,00", {reverse: true});
        $('#margem').mask('000,00', {reverse: true});

        var valorSelecionado = '@Model.UnidadeMedida';

        // Carrega as unidades de medida do arquivo JSON
        $.getJSON('@Url.Content("~/json/unidades_medida.json")', function (data) {
            if (data && data.medidas && data.medidas.length > 0) {
                for (var i = 0; i < data.medidas.length; i++) {
                    $('#unidade').append(new Option(data.medidas[i].display + ' (' + data.medidas[i].code + ')', data.medidas[i].code));
                }

                if (valorSelecionado) {
                    $('#unidade').val(valorSelecionado);
                }
            } else {
                console.error('Arquivo JSON não possui as medidas esperadas.');
            }
        }).fail(function () {
            console.error("Erro ao carregar o arquivo JSON.");
        });

        $.validator.addMethod("extension", function (value, element, param) {
            var extension = value.split('.').pop().toLowerCase();
            return this.optional(element) || param.split('|').indexOf(extension) !== -1;
        }, "Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).");

        ConfiguracaoJsService.carregarConfiguracoes(function () {
            var controlaEstoque = parseInt(ConfiguracaoJsService.obterConfiguracao("control_estoque", 0));

            let required = true;
            let msgRequired = 'Campo estoque é obrigatório';

            if (controlaEstoque === 0) {
                required = false;
                msgRequired = '';
                $("#estoque").removeAttr("required");
            }
            else {
                $("#estoque").attr("required", "required");
            }

            $.validator.addMethod("extension", function (value, element, param) {
                var extension = value.split('.').pop().toLowerCase();
                return this.optional(element) || param.split('|').indexOf(extension) !== -1;
            }, "Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).");

            $('#formProduto').validate({
                rules: {
                    'Descricao': { required: true },
                    'PrecoCompra': { required: true },
                    'PrecoVenda': { required: true },
                    'UnidadeMedida': { required: true },
                    'Estoque': { required: required },
                    'imagemCategoria': { extension: "jpg|jpeg|png|gif|bmp" }
                },
                messages: {
                    'Descricao': { required: 'Campo descrição é obrigatório.' },
                    'PrecoCompra': { required: 'Campo preço de compra é obrigatório.' },
                    'PrecoVenda': { required: 'Campo preço de venda é obrigatório.' },
                    'UnidadeMedida': { required: 'Unidade deve ser selecionado.' },
                    'Estoque': { required: msgRequired },
                    'imagemCategoria': { extension: 'Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).' }
                },
                errorPlacement: function (error, element) {
                    element.attr("placeholder", error.text());
                },
                highlight: function (element, errorClass, validClass) {
                    $(element).addClass("is-invalid").removeClass("is-valid");
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).removeClass("is-invalid").addClass("is-valid");
                    $(element).attr("placeholder", "");
                }
            });

            console.log("Required =", required);
            console.log("msgRequired =", msgRequired);
            const requiredFields = document.querySelectorAll("[required]");
                requiredFields.forEach((field) => {
                    const label = field.closest("form").querySelector(`label[for='${field.id}']`);
                    if (label && !label.innerHTML.includes("*")) {
                        label.innerHTML += ' <span class="text-danger">*</span>';
                    }
                });
        });
    });
</script>