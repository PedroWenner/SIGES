@using SIGES.Helpers
@using SIGES.ViewModel
@model OsEmailViewModel

@{
    ViewData["Titulo"] = "OS";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Ordens de serviço</h5>
    </div>
    <div class="col-lg-12 col-md-12" style="margin-left: 0">
        <div class="col-md-2">
            @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "aOs"))
            {
                <a role="button" class="button btn btn-mini btn-success w-100" asp-controller="Ordem" asp-action="Adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Ordem de serviço</span>
                </a>
            }
            else
            {
                <a role="button" class="button btn btn-mini btn-secondary disabled" title="Você não tem permissão para adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Ordem de serviço</span>
                </a>
            }
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content">
            <div class="table-responsive">
                <table id="tabela">
                    <thead>
                        <tr>
                            <th>Nº</th>
                            <th>Cliente</th>
                            <th>Responsável</th>
                            <th>Data inicial</th>
                            <th>Data final</th>
                            <th>Venc. garantia</th>
                            <th>Valor total</th>
                            <th>Valor do desconto</th>
                            <th>V.T (faturado)</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrdemServicos == null || Model.OrdemServicos.Count == 0)
                        {
                            <tr>
                                <td colspan="11">Nenhuma ordem de serviço cadastrado</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var os in Model.OrdemServicos)
                            {
                                string garantia = os?.Garantia?.ToString() ?? "0";
                                DateTime dtFinal = os?.DataFinal ?? DateTime.Now;
                                DateTime vencGarantia = dtFinal.AddDays(double.Parse(string.IsNullOrEmpty(garantia) ? "0" : garantia));

                                string cor = string.Empty;
                                switch (os?.Status)
                                {
                                    case "Aberto":
                                        cor = "text-bg-primary";
                                        break;
                                    case "Em Andamento":
                                        cor = "text-bg-secondary";
                                        break;
                                    case "Orçamento":
                                        cor = "text-bg-info";
                                        break;
                                    case "Negociação":
                                        cor = "text-bg-warning";
                                        break;
                                    case "Cancelado":
                                        cor = "text-bg-danger";
                                        break;
                                    case "Finalizado":
                                        cor = "text-bg-dark";
                                        break;
                                    case "Faturado":
                                        cor = "text-bg-primary";
                                        break;
                                    case "Aguardando Peças":
                                        cor = "text-bg-light";
                                        break;
                                    case "Aprovado":
                                        cor = "text-bg-success";
                                        break;
                                    default:
                                        cor = "text-bg-primary";
                                        break;
                                }

                                string corGarantia = "";
                                if (!string.IsNullOrEmpty(os?.Garantia))
                                {
                                    if (vencGarantia >= DateTime.Now)
                                    {
                                        corGarantia = "text-bg-success";
                                    }
                                    else
                                    {
                                        corGarantia = "text-bg-danger";
                                    }
                                }

                                <tr>
                                    <td>@os?.Id</td>
                                    <td>@os?.Clientes?.Nome</td>
                                    <td>@os?.Usuarios?.Nome</td>
                                    <td>@os?.DataInicial?.ToString("dd/MM/yyyy")</td>
                                    <td>@os?.DataFinal?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(os?.Garantia))
                                        {
                                            <span class="badge rounded-pill @corGarantia">
                                                @vencGarantia.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                    </td>
                                    <td>R$ @os?.ValorTotal.ToString("N2")</td>
                                    <td>R$ @os?.Desconto.ToString("N2")</td>
                                    <td>R$ @os?.ValorDesconto.ToString("N2")</td>
                                    <td>
                                        <span class="badge rounded-pill @cor">
                                            @os?.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vOs"))
                                        {
                                            <a asp-controller="Ordem" asp-action="Visualizar" asp-route-id="@os?.Id" style="margin-right: 1%" class="btn-nwe text-decoration-none">
                                                <i class="bx bx-show bx-xs"></i>
                                            </a>
                                            <a asp-controller="Relatorio" asp-action="Imprimir" asp-route-id="@os?.Id" asp-route-tipo="a4" target="_blank"
                                               style="margin-right: 1%" class="btn-nwe6 text-decoration-none" title="Imprimir A4">
                                                <i class="bx bx-printer bx-xs"></i>
                                            </a>
                                            <a asp-controller="Relatorio" asp-action="Imprimir" asp-route-id="@os?.Id" asp-route-tipo="termica" target="_blank"
                                                style="margin-right: 1%" class="btn-nwe6 text-decoration-none" title="Imprimir Não Fiscal">
                                                <i class="bx bx-printer bx-xs"></i>
                                            </a>
                                        }
                                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eOs"))
                                        {
                                            @if (ConfiguracaoHelper.ObterValor("control_editos") == "1")
                                            {
                                                <a asp-controller="Ordem" asp-action="Editar" asp-route-id="@os?.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none">
                                                    <i class="bx bx-edit bx-xs"></i>
                                                </a>
                                            }
                                        }
                                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "dOs"))
                                        {
                                            @if (ConfiguracaoHelper.ObterValor("control_editos") == "1")
                                            {
                                                <a href="#modal-excluir" data-id="@os?.Id" role="button" data-bs-target="#modal-excluir" data-bs-toggle="modal"
                                                    style="margin-right: 1%" class="btn-nwe4 text-decoration-none" title="Excluir os">
                                                    <i class="bx bx-trash-alt bx-xs"></i>
                                                </a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal excluir -->
<div id="modal-excluir" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Arquivo" asp-action="Excluir">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Excluir arquivo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="idDocumento" name="id" />
                    <h6 style="text-align: center">
                        Deseja realmente excluir este arquivo?
                    </h6>
                </div>
                <div class="modal-footer" style="display:flex;justify-content: center">
                    <button type="button" class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true">
                        <span class="button__icon"><i class="bx bx-x"></i></span>
                        <span class="button__text2">Cancelar</span>
                    </button>
                    <button type="submit" class="button btn btn-danger">
                        <span class="button__icon"><i class='bx bx-trash'></i></span>
                        <span class="button__text2">Excluir</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")

<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', 'a.btn-nwe4', function () {
            var idDocumento = $(this).data('id');
            $('#idDocumento').val(idDocumento);
        });
    });
</script>