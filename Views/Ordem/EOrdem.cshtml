<script src="~/js/jquery.validate.js"></script>
<script src="~/trumbowyg/dist/trumbowyg.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontsize/trumbowyg.fontsize.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontfamily/trumbowyg.fontfamily.min.js"></script>
<script src="~/trumbowyg/dist/langs/pt_br.js"></script>
<script src="~/js/editarOs.js"></script>
<script>
    $(document).on("click", ".btn-remover-anexo", function (e) {
        e.preventDefault();
        var fileName = $(this).data("id");

        Swal.fire({
            title: "Tem certeza?",
            text: "Essa ação não poderá ser desfeita!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Sim, excluir!",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                $("#progressBarAnexos").removeClass("d-none");

                $.ajax({
                    type: "POST",
                    url: `/os/excluir-anexo/${fileName}`,
                    success: function (response) {
                        if (response.status === "success") {
                            Swal.fire("Excluído!", response.message, "success");
                            carregarAnexos(@Model?.Os?.Id);
                        } else {
                            Swal.fire("Erro!", response.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Erro!", "Erro ao excluir arquivo.", "error");
                    },
                    complete: function () {
                        $("#progressBarAnexos").addClass("d-none");
                    }
                });
            }
        });
    });

    $('#recebido').click(function(event) {
        var flag = $(this).is(':checked');
        if (flag == true) {
            $('#divRecebimento').show();
            $('#recebido').val("1");
        } else {
            $('#divRecebimento').hide();
            $('#recebido').val("0");
        }
    });

    $("#formFaturar").validate({
        rules: {
            Descricao: {
                required: true
            },
            Cliente: {
                required: true
            },
            Valor: {
                required: true
            },
            FaturarDesconto: {
                required: true
            },
            DataVencimento: {
                required: true
            }

        },
        messages: {
            Descricao: {
                required: 'Campo Requerido.'
            },
            Cliente: {
                required: 'Campo Requerido.'
            },
            Valor: {
                required: 'Campo Requerido.'
            },
            FaturarDesconto: {
                required: 'Campo Requerido.'
            },
            DataVencimento: {
                required: 'Campo Requerido.'
            }
        },
        submitHandler: function (form) {
            var dados = $(form).serializeArray();
            var jsonData = {};

            $.each(dados, function (index, field) {
                if (field.name === 'DataVencimento' || field.name === 'DataRecebimento') {
                    jsonData[field.name] = formatarDataParaAPI(field.value);
                } else if (field.name === 'ValorTotal' || field.name === 'ValorDesconto') {
                    jsonData[field.name] = formatarDecimalParaAPI(field.value);
                } else {
                    jsonData[field.name] = field.value;
                }
            });

            $('#loading-spinner').show();
            $('#btn-faturar').prop('disabled', true);

            console.log(jsonData);
           
            $.ajax({
                type: "POST",
                url: "/api/v1/faturar",
                contentType: "application/json",
                data: JSON.stringify(jsonData),
                dataType: 'json',
                success: function (response) {
                    if (response.acao === "success") {
                        setTimeout(function () {
                            $('#loading-spinner').hide();
                            $('#btn-faturar').prop('disabled', false);
                            $('#modal-faturar').hide();

                            Swal.fire({
                                title: response.status,
                                text: response.message,
                                icon: response.acao,
                                confirmButtonText: 'OK',
                                didOpen: () => {
                                    document.querySelector('#sidebar').style.position = 'static';
                                },
                                didClose: () => {
                                    document.querySelector('#sidebar').style.position = 'fixed';
                                }
                            }).then(() => {
                                location.reload();
                            });
                        }, 1500);
                    } else {
                        $('#loading-spinner').hide();
                        $('#btn-faturar').prop('disabled', false);
                        $('#modal-faturar').hide();

                        Swal.fire(response.status, response.message, response.acao).then(() => {
                            location.reload();
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Erro na requisição:", xhr.responseText);
                    Swal.fire({
                        icon: "error",
                        title: "Erro",
                        text: "Erro ao enviar os dados: " + xhr.responseText
                    });
                }
            });

            return false;
        }
    });

    function formatarDecimalParaAPI(valor) {
        return valor.replace(/\./g, '').replace(',', '.');
    }

    function formatarDataParaAPI(data) {
        if (data === '')
            return null;

        var partes = data.split('/');
        var dia = partes[0];
        var mes = partes[1];
        var ano = partes[2];

        return `${ano}-${mes}-${dia}`;
    }
</script>