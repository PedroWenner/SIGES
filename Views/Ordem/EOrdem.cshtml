@using SIGES.Helpers
@using SIGES.Interfaces
@model OsEmailViewModel

@{
    ViewData["Titulo"] = "Editar OS";
    decimal total = 0;
    decimal totalServicos = 0;
    decimal valorTotalOs = Model.Produtos.Sum(x => x.SubTotal) + Model.Servicos.Sum(x => x.SubTotal ?? 0);
}

<link rel="stylesheet" href="~/trumbowyg/dist/ui/trumbowyg.css">

<style>
    .custom-counter {
        display: flex;
        align-items: center;
        border: 1px solid #ddd;
        border-radius: 5px;
        background-color: #fff;
        max-width: 180px;
        justify-content: space-between;
        transition: border 0.3s ease;
    }

    .custom-counter:focus-within {
        border: 1px solid #aaa;
    }

    .custom-counter input[type="text"] {
        border: none;
        outline: none;
        width: 60px;
        text-align: center;
        font-size: 14px;
        color: #333;
        background: transparent;
    }

    .custom-counter input::placeholder {
        color: #bbb;
        font-style: italic;
    }

    .counter-buttons {
        display: flex;
        gap: 8px;
        padding-right: 10px;
    }

    .counter-buttons button {
        background: none;
        border: none;
        color: #aaa;
        font-size: 18px;
        cursor: pointer;
        transition: color 0.3s ease;
        padding: 0;
    }

    .counter-buttons button:hover {
        color: #333;
    }

    .counter-buttons button:disabled {
        color: #ddd;
        cursor: default;
    }

    #ui-datepicker-div {
        z-index: 999 !important;
    }

    .card-custom {
        height: 250px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .card-custom:hover {
        transform: scale(1.05);
        box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease-in-out;
    }

    .card-body-custom {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .card-custom img {
        width: 100%;
        height: 120px;
        object-fit: cover;
    }

    .text-truncate-custom {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Editar ordem de serviço</h5>
        </div>
        <div class="card-body">

            <div class="buttons d-flex flex-wrap gap-2">
                @if (Model.Os.faturado == 0)
                {
                    <a href="#modal-faturar" id="btn-faturar" role="button" data-toggle="modal" class="button btn btn-mini btn-danger">
                        <span class="button__icon"><i class='bx bx-dollar'></i></span>
                        <span class="button__text">Faturar</span>
                    </a>
                }

                <a class="button btn btn-mini btn-primary" asp-controller="Ordem" asp-action="Visualizar" asp-route-id="@Model.Os.Id">
                    <span class="button__icon"><i class="bx bx-show"></i></span>
                    <span class="button__text">Visualizar OS</span>
                </a>
                <div class="button-container">
                    <a class="button btn btn-mini btn-secondary">
                        <span class="button__icon"><i class="bx bx-printer"></i></span>
                        <span class="button__text">Imprimir</span>
                    </a>
                    <div class="cascading-buttons">
                        <a target="_blank" class="button btn btn-mini btn-secondary" asp-controller="Relatorio" asp-action="Imprimir" asp-route-id="@Model.Os.Id">
                            <span class="button__icon"><i class='bx bx-file'></i></span>
                            <span class="button__text">Papel A4</span>
                        </a>
                        <a target="_blank" class="button btn btn-mini btn-secondary" href="#">
                            <span class="button__icon"><i class='bx bx-receipt'></i></span>
                            <span class="button__text">Cupom 80mm</span>
                        </a>
                        @if (Model.Os.GarantiasId != null)
                        {
                            <a target="_blank" class="button btn btn-mini btn-secondary" href="#">
                                <span class="button__icon"><i class="bx bx-paperclip"></i></span>
                                <span class="button__text">Termo Garantia</span>
                            </a>
                        }
                    </div>
                </div>
                @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eOs") && !string.IsNullOrEmpty(Model.Os?.Clientes?.Telefone))
                {
                    <button class="button btn btn-mini btn-success" id="enviarWhatsApp" data-id="@Model.Os.Id" data-tipo="nao-pix">
                        <span class="button__icon"><i class="bx bxl-whatsapp"></i></span>
                        <span class="button__text">WhatsApp</span>
                    </button>
                }
                @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eOs") && !string.IsNullOrEmpty(Model.Os?.Clientes?.Email) && !string.IsNullOrEmpty(Model.Emitente?.Email))
                {
                    <a class="button btn btn-mini btn-warning" id="enviar-email" data-id="@Model.Os.Id">
                        <span class="button__icon"><i class="bx bx-envelope"></i></span>
                        <span class="button__text">Via e-mail</span>
                    </a>
                }
            </div>

            <ul class="nav nav-tabs mt-3" id="myTabOs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#os-tab-pane">Detalhes da OS</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#desconto-tab-pane">Descontos</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#produtos-tab-pane">Produtos</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#servicos-tab-pane">Serviços</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#anexos-tab-pane">Anexos</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#anotacao-tab-pane">Anotações</button>
                </li>
            </ul>

            <div class="tab-content mt-3">
                <div class="tab-pane fade show active" id="os-tab-pane" tabindex="0">
                    <h4>N° OS: @Model.Os?.Id.ToString("D4")</h4>

                    <form id="formOs" method="post" asp-controller="Ordem" asp-action="Editar">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Os.Id" />

                        <div class="row">
                            <div class="col-6">
                                <label for="cliente" class="form-label">Cliente</label>
                                <input id="cliente" type="text" placeholder="Digite o nome do cliente" name="cliente" required value="@Model.Os?.Clientes?.Nome" />
                                <input id="cliente-id" type="hidden" asp-for="Os.ClientesId" />
                                <span asp-validation-for="Os.ClientesId" class="text-danger"></span>
                            </div>
                            <div class="col-6">
                                <label for="tecnico" class="form-label">Técnico / Responsável</label>
                                <input id="tecnico" type="text" placeholder="Técnico / Responsável" required name="tecnico" value="@Model.Os?.Usuarios?.Nome" />
                                <input id="usuario-id" type="hidden" asp-for="Os.UsuariosId" />
                                <span asp-validation-for="Os.UsuariosId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-3">
                                <label for="status" class="form-label">Status</label>
                                <select asp-for="Os.Status" id="status" required>
                                    <option value="Orçamento">Orçamento</option>
                                    <option value="Aberto">Aberto</option>
                                    <option value="Em Andamento">Em Andamento</option>
                                    <option value="Finalizado">Finalizado</option>
                                    <option value="Cancelado">Cancelado</option>
                                    <option value="Aguardando Peças">Aguardando Peças</option>
                                    <option value="Aprovado">Aprovado</option>
                                </select>
                                <span asp-validation-for="Os.Status" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label for="data-inicial" class="form-label">Data inicial</label>
                                <input id="data-inicial" type="date" asp-for="Os.DataInicial" required class="datetime" />
                                <span asp-validation-for="Os.DataInicial" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label for="data-final" class="form-label">Data final</label>
                                <input id="data-final" type="date" asp-for="Os.DataFinal" class="datetime" required />
                                <span asp-validation-for="Os.DataFinal" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label for="garantia" class="form-label">Garantia (dias)</label>
                                <div class="custom-counter">
                                    <input id="garantia" type="text" asp-for="Os.Garantia" onkeypress="return somenteNumeros(this)" />
                                    <div class="counter-buttons">
                                        <button id="btn-decrement-garantia" type="button" onclick="decrement('btn-decrement-servico', 'servico-quantidade');">–</button>
                                        <button id="btn-increment-garantia" type="button" onclick="increment('btn-decrement-servico', 'servico-quantidade');">+</button>
                                    </div>
                                </div>
                                <span asp-validation-for="Os.Garantia" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label for="garantias" class="form-label">Termo de garantia</label>
                                <input id="garantias" type="text" value="@Model.Os?.Garantias?.RefGarantia" />
                                <input id="garantias-id" type="hidden" asp-for="Os.GarantiasId" />
                                <span asp-validation-for="Os.GarantiasId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <h6>Descrição produto/serviço</h6>
                                <textarea asp-for="Os.DescricaoProduto" id="descricao-produto"></textarea>
                            </div>
                            <div class="col-md-6">
                                <h6>Defeito</h6>
                                <textarea asp-for="Os.Defeito" id="defeito"></textarea>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <h6>Observações</h6>
                                <textarea asp-for="Os.Observacoes" id="observacoes"></textarea>
                            </div>
                            <div class="col-md-6">
                                <h6>Laudo técnico</h6>
                                <textarea asp-for="Os.LaudoTecnico" id="laudo-tecnico"></textarea>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex justify-content-center mt-4">
                            <a title="Voltar" class="button btn btn-warning" asp-controller="Ordem" asp-action="Index">
                                <span class="button__icon"><i class="bx bx-undo"></i></span>
                                <span class="button__text2">Voltar</span>
                            </a>
                            <button type="submit" class="button btn btn-mini btn-primary">
                                <span class="button__icon"><i class='bx bx-sync'></i></span>
                                <span class="button__text2">Atualizar</span>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="tab-pane fade show" id="desconto-tab-pane" tabindex="1">
                    <div class="container-fluid mt-3">
                        <div class="row">
                            <div class="col-12">
                                <div class="text-secondary-emphasis bg-light-subtle border border-secondary-subtle rounded-3 p-3">
                                    <form id="form-desconto" method="post">
                                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                        <input type="hidden" name="Id" value="@Model.Os?.Id" />

                                        <div class="row g-3">
                                            <div class="col-lg-2 col-md-3">
                                                <label for="valor-total-os" class="form-label">Valor total da OS:</label>
                                                <input id="valor-total-os" type="text" placeholder="0,00" readonly value="@valorTotalOs.ToString("N2")" />
                                            </div>

                                            <div class="col-lg-1 col-md-1">
                                                <label for="tipo-desconto" class="form-label">Preço</label>
                                                <select id="tipo-desconto" name="TipoDesconto" onchange="calcularDesconto(); return false;">
                                                    <option value="real">R$</option>
                                                    <option value="porcento">%</option>
                                                </select>
                                            </div>

                                            <div class="col-lg-1 col-md-2">
                                                <label for="desconto" class="form-label">Desconto</label>
                                                <input id="desconto" type="text" name="Desconto" placeholder="0,00" class="money" onchange="calcularDesconto(); return false;" required />
                                            </div>

                                            <div class="col-lg-3 col-md-2">
                                                <label for="valor-desconto" class="form-label">Total com desconto</label>
                                                <input id="valor-desconto" type="text" name="ValorDesconto" placeholder="0,00" class="money" required />
                                            </div>

                                            <div class="col-lg-3 col-md-12 d-flex align-items-end">
                                                <button type="submit" class="button btn btn-mini btn-success" style="margin-bottom: 0px!important;">
                                                    <span class="button__icon"><i class='bx bx-plus'></i></span>
                                                    <span class="button__text2">Aplicar</span>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade show" id="produtos-tab-pane" tabindex="2">
                    <div class="container-fluid mt-3">
                        <div class="row">
                            <div class="col-12">
                                <div class="text-secondary-emphasis bg-light-subtle border border-secondary-subtle rounded-3 p-3">
                                    <form id="formProdutos" method="post">
                                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                        <input type="hidden" name="OsId" value="@Model.Os?.Id" />

                                        <div class="row g-3">
                                            <div class="col-lg-5 col-md-6">
                                                <label for="produto" class="form-label">Produto</label>
                                                <input id="produto" type="text" placeholder="Digite o nome do produto" />
                                                <input id="produto-id" type="hidden" name="ProdutosId" />
                                            </div>

                                            <div class="col-lg-2 col-md-3">
                                                <label for="produto-preco" class="form-label">Preço</label>
                                                <input id="produto-preco" type="text" name="Preco" class="money" placeholder="Preço" />
                                            </div>

                                            <div class="col-lg-2 col-md-3">
                                                <label for="produto-quantidade" class="form-label">Quantidade</label>
                                                <div class="custom-counter">
                                                    <input id="produto-quantidade" type="text" name="Quantidade" onkeypress="return somenteNumeros(this)" />
                                                    <div class="counter-buttons">
                                                        <button id="btn-decrement-produto" type="button" onclick="decrement('btn-decrement-produto', 'produto-quantidade');">–</button>
                                                        <button id="btn-increment-produto" type="button" onclick="increment('btn-decrement-produto', 'produto-quantidade');">+</button>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-12 d-flex align-items-end">
                                                <button type="submit" class="button btn btn-mini btn-success" style="margin-bottom: 0px!important;">
                                                    <span class="button__icon"><i class='bx bx-plus'></i></span>
                                                    <span class="button__text2">Adicionar</span>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div id="progressBarProdutos" class="progress mt-4 d-none" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%;"></div>
                                </div>

                                <div class="table-responsive mt-3">
                                    <table class="tblProdutos" id="tabela">
                                        <thead>
                                            <tr>
                                                <th class="text-left" style="width: 70%">Produto</th>
                                                <th style="width: 5%" class="text-center">Quantidade</th>
                                                <th class="text-right" style="width: 10%">Preço unit.</th>
                                                <th class="text-right" style="width: 5%">Ações</th>
                                                <th class="text-right" style="width: 10%">Sub-total</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var p in Model.Produtos)
                                            {
                                                total += p.SubTotal;
                                                <tr>
                                                    <td class="text-left">@p.Produtos?.Descricao</td>
                                                    <td class="text-center">@p.Quantidade</td>
                                                    <td class="text-right">R$ @(p.Preco?.ToString("N2") ?? p.Produtos?.PrecoVenda.ToString("N2"))</td>
                                                    <td class="text-right">
                                                        @if (Model.Os?.Status != "cancelado")
                                                        {
                                                            <a data-id="@p.Id" role="button" style="margin-right: 1%" class="btn-remover btn-nwe4 text-decoration-none" title="Excluir produto">
                                                                <i class="bx bx-trash-alt bx-xs"></i>
                                                            </a>
                                                        }
                                                    </td>
                                                    <td class="text-right">R$ @p.SubTotal.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="4" class="text-end">
                                                    <strong>Total:</strong>
                                                </td>
                                                <td>
                                                    <div class="text-center">
                                                        <strong>
                                                            R$ @total.ToString("N2")
                                                            <input type="hidden" id="total-produto" value="@total.ToString("N2")">
                                                        </strong>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade show" id="servicos-tab-pane" tabindex="3">
                    <div class="container-fluid mt-3">
                        <div class="row">
                            <div class="col-12">
                                <div class="text-secondary-emphasis bg-light-subtle border border-secondary-subtle rounded-3 p-3">
                                    <form id="formServicos" method="post">
                                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                        <input type="hidden" name="OsId" value="@Model.Os?.Id" />

                                        <div class="row g-3">
                                            <div class="col-lg-5 col-md-6">
                                                <label for="servico" class="form-label">Serviço</label>
                                                <input id="servico" type="text" placeholder="Digite o nome do serviço" />
                                                <input id="servico-id" type="hidden" name="ServicosId" />
                                            </div>

                                            <div class="col-lg-2 col-md-3">
                                                <label for="servico-preco" class="form-label">Preço</label>
                                                <input id="servico-preco" type="text" name="Preco" class="money" placeholder="Preço" />
                                            </div>

                                            <div class="col-lg-2 col-md-3">
                                                <label for="servico-quantidade" class="form-label">Quantidade</label>
                                                <div class="custom-counter">
                                                    <input id="servico-quantidade" type="text" name="Quantidade" onkeypress="return somenteNumeros(this)" />
                                                    <div class="counter-buttons">
                                                        <button id="btn-decrement-servico" type="button" onclick="decrement('btn-decrement-servico', 'servico-quantidade');">–</button>
                                                        <button id="btn-increment-servico" type="button" onclick="increment('btn-decrement-servico', 'servico-quantidade');">+</button>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-3 col-md-12 d-flex align-items-end">
                                                <button type="submit" class="button btn btn-mini btn-success" style="margin-bottom: 0px!important;">
                                                    <span class="button__icon"><i class='bx bx-plus'></i></span>
                                                    <span class="button__text2">Adicionar</span>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div id="progressBarServicos" class="progress mt-4 d-none" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%;"></div>
                                </div>

                                <div class="table-responsive mt-3">
                                    <table class="tblServicos" id="tabela">
                                        <thead>
                                            <tr>
                                                <th class="text-left" style="width: 70%">Serviço</th>
                                                <th style="width: 5%" class="text-center">Quantidade</th>
                                                <th class="text-right" style="width: 10%">Preço unit.</th>
                                                <th class="text-right" style="width: 5%">Ações</th>
                                                <th class="text-right" style="width: 10%">Sub-total</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var s in Model.Servicos)
                                            {
                                                totalServicos += s.SubTotal ?? 0;
                                                <tr>
                                                    <td class="text-left">@s.Servicos?.Nome</td>
                                                    <td class="text-center">@s.Quantidade</td>
                                                    <td class="text-right">R$ @(s.Preco?.ToString("N2") ?? s.Servicos?.Valor.ToString("N2"))</td>
                                                    <td class="text-right">
                                                        @if (Model.Os?.Status != "cancelado")
                                                        {
                                                            <a data-id="@s.Id" role="button" style="margin-right: 1%" class="btn-remover-servico btn-nwe4 text-decoration-none" title="Excluir serviço">
                                                                <i class="bx bx-trash-alt bx-xs"></i>
                                                            </a>
                                                        }
                                                    </td>
                                                    <td class="text-right">R$ @s.SubTotal?.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="4" class="text-end">
                                                    <strong>Total:</strong>
                                                </td>
                                                <td>
                                                    <div class="text-center">
                                                        <strong>
                                                            R$ @totalServicos.ToString("N2")
                                                            <input type="hidden" id="total-servico" value="@totalServicos.ToString("N2")">
                                                        </strong>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade show" id="anexos-tab-pane" tabindex="4">
                    <div class="container-fluid mt-3">
                        <div class="row">
                            <div class="col-12">
                                <div class="text-secondary-emphasis bg-light-subtle border border-secondary-subtle rounded-3 p-3">
                                    <form id="formAnexos" method="post" enctype="multipart/form-data" accept-charset="utf-8">
                                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                        <input type="hidden" name="OsId" value="@Model.Os?.Id" />

                                        <div class="row g-3">
                                            <div class="col-lg-8 col-md-9">
                                                <label for="anexo" class="form-label">Anexo</label>
                                                <input id="anexo" type="file" name="userfile" multiple />
                                                <small class="form-text text-muted">(Arquivos suportados: .jpg, .png, .gif, .jpeg, .JPG, .PNG, .GIF, .JPEG, .pdf, .PDF, .cdr, .CDR, .docx, .DOCX, .txt)</small>
                                            </div>

                                            <div class="col-lg-3 col-md-12 d-flex align-items-center">
                                                <button type="submit" class="button btn btn-mini btn-success" style="margin-bottom: 0px!important;">
                                                    <span class="button__icon"><i class='bx bx-paperclip'></i></span>
                                                    <span class="button__text2">Anexar</span>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div id="progressBarAnexos" class="progress mt-4 d-none" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%;"></div>
                                </div>

                                <div class="row mt-3" id="divAnexos">
                                    @if (Model.Anexos != null && Model.Anexos.Any())
                                    {
                                        @foreach (var anexo in Model.Anexos)
                                        {
                                            var isImage = anexo.FileType == "image";
                                            var thumbnail = isImage ? anexo.Url : "/img/icon-file.png";

                                            <div class="col-6 col-sm-4 col-md-3 col-lg-2 mb-3">
                                                <div class="card card-custom text-center shadow-sm">
                                                    <a href="@anexo.Url" target="_blank" class="d-block p-2">
                                                        <img src="@thumbnail" alt="Anexo" class="img-fluid rounded" style="max-height: 120px;">
                                                    </a>
                                                    <div class="card-body card-body-custom p-2">
                                                        <small class="d-block text-truncate text-truncate-custom" style="max-width: 100px;">@anexo.FileName</small>
                                                        <div class="d-flex justify-content-center gap-2 mt-2">
                                                            <a href="/os/download/@anexo.FileName" class="btn btn-sm btn-secondary" title="Baixar">
                                                                <i class="fas fa-download"></i>
                                                            </a>
                                                            <a role="button" href="/os/excluir-anexo/@anexo.FileName" class="btn btn-sm btn-danger btn-remover-anexo" data-id="@anexo.FileName" title="Remover">
                                                                <i class="bx bx-trash"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="col-12 text-center">
                                            <p class="text-muted">Nenhum anexo disponível.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade show" id="anotacao-tab-pane" tabindex="5">
                    <div class="container-fluid mt-3">
                        <div class="row">
                            <div class="buttons d-flex flex-wrap gap-2">
                                <a title="Adicionar anotação" class="button btn btn-mini btn-success btn-adicionar-anotacao" href="#modal-adicionar-anotacao"
                                    role="button" data-bs-target="#modal-adicionar-anotacao" data-bs-toggle="modal">
                                    <span class="button__icon"><i class="bx bx-plus"></i></span>
                                    <span class="button__text">Adicionar anotação</span>
                                </a>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="table-responsive mt-3">
                                    <table class="tblAnotacoes" id="tabela">
                                        <thead>
                                            <tr>
                                                <th class="text-left" style="width: 15%">Data/Hora</th>
                                                <th class="text-left" style="width: 80%">Anotação</th>
                                                <th class="text-left" style="width: 5%">Ações</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var a in Model.Anotacoes)
                                            {
                                                <tr>
                                                    <td class="text-left">@a.DataHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                                    <td class="text-left">@a.Anotacao</td>
                                                    <td class="text-left">
                                                        @if (Model.Os?.Status != "cancelado")
                                                        {
                                                            <a data-id="@a.Id" role="button" style="margin-right: 1%" class="btn-remover-anotacao btn-nwe4 text-decoration-none" title="Excluir anotação">
                                                                <i class="bx bx-trash-alt bx-xs"></i>
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal-adicionar-anotacao" class="modal fade" tabindex="-1" aria-labelledby="mymodallabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="form-adicionar-anotacao" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Adicionar anotação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="OsId" name="OsId" value="@Model.Os?.Id" />
                    <div class="row g-3">
                        <div id="progressBarAnotacao" class="progress mt-4 d-none" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%;"></div>
                        </div>

                        <div class="col-lg-12 col-md-12">
                            <label for="anotacao" class="form-label">Anotação</label>
                            <textarea id="anotacao" type="text" name="Anotacao"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="display:flex;justify-content: center">
                    <button type="button" class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true">
                        <span class="button__icon"><i class="bx bx-x"></i></span>
                        <span class="button__text2">Cancelar</span>
                    </button>
                    <button type="submit" class="button btn btn-success">
                        <span class="button__icon"><i class='bx bx-plus'></i></span>
                        <span class="button__text2">Adicionar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script src="~/trumbowyg/dist/trumbowyg.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontsize/trumbowyg.fontsize.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontfamily/trumbowyg.fontfamily.min.js"></script>
<script src="~/trumbowyg/dist/langs/pt_br.js"></script>
<script src="~/js/editarOs.js"></script>
<script>
    $(document).on("click", ".btn-remover-anexo", function (e) {
        e.preventDefault();
        var fileName = $(this).data("id");

        Swal.fire({
            title: "Tem certeza?",
            text: "Essa ação não poderá ser desfeita!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Sim, excluir!",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                $("#progressBarAnexos").removeClass("d-none");

                $.ajax({
                    type: "POST",
                    url: `/os/excluir-anexo/${fileName}`,
                    success: function (response) {
                        if (response.status === "success") {
                            Swal.fire("Excluído!", response.message, "success");
                            console.log(@Model?.Os?.Id);
                            carregarAnexos(@Model?.Os?.Id);
                        } else {
                            Swal.fire("Erro!", response.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Erro!", "Erro ao excluir arquivo.", "error");
                    },
                    complete: function () {
                        $("#progressBarAnexos").addClass("d-none");
                    }
                });
            }
        });
    });
</script>