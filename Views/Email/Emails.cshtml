@using SIGES.Helpers
@using SIGES.ViewModel
@model EmailViewModel

@{
    ViewData["Titulo"] = "Fila de e-mails";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Lista de envio de e-mails</h5>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content table-responsive">
            <table id="tabela">
                <thead>
                    <tr>
                        <th class="text-start">Código</th>
                        <th class="text-start">Para</th>
                        <th class="text-start">Status</th>
                        <th class="text-start">Data</th>
                        <th class="text-start">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Emails == null || Model.Emails.Count == 0)
                    {
                        <tr>
                            <td colspan="5">Nenhum e-mail na fila</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var email in Model.Emails)
                        {
                            var status = new Dictionary<string, string>
                            {
                                { "pending", "<span class='badge rounded-pill text-bg-secondary'>Pendente</span>" },
                                { "sending", "<span class='badge rounded-pill text-bg-info'>Enviando</span>" },
                                { "sent", "<span class='badge rounded-pill text-bg-success'>Enviado</span>" },
                                { "failed", "<span class='badge rounded-pill text-bg-warning'>Falhou</span>" }
                            };
                            <tr>
                                <td class="text-start">@email.Id</td>
                                <td class="text-start">@email.To</td>
                                <td class="text-start">@Html.Raw(status[email.Status])</td>
                                <td class="text-start">@email.Date.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="text-start">
                                    <a data-id="@email.Id" role="button" style="margin-right: 1%" class="btn-remover btn-nwe4 text-decoration-none" title="Excluir item">
                                        <i class="bx bx-trash-alt bx-xs"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalSpinner")


<script type="text/javascript">
    $(document).ready(function () {
        $(document).on("click", ".btn-remover", function (event) {
            event.preventDefault();

            var email_id = $(this).data("id");
            var texto = 'Você deseja remover este e-mail da fila?';

            Swal.fire({
                title: "Tem certeza?",
                text: texto,
                icon: "warning",
                showCancelButton: true,
                cancelButtonText: "Cancelar",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Sim, remover!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $("#modal-spinner").modal('show');

                    $.ajax({
                        type: "POST",
                        url: "/emails/excluir/" + email_id,
                        data: { id: email_id },
                        dataType: "json",
                        success: function (response) {
                            if (response.result) {
                                setTimeout(function () {
                                    $("#modal-spinner").modal('hide');
                                    Swal.fire({
                                        title: "Removido!",
                                        text: response.message,
                                        icon: "success",
                                        didOpen: () => {
                                            document.querySelector('#sidebar').style.position = 'static';
                                        },
                                        didClose: () => {
                                            document.querySelector('#sidebar').style.position = 'fixed';
                                        }
                                    }).then(() => {
                                        location.reload();
                                    });
                                }, 1500);
                            } else {
                                setTimeout(function () {
                                    $("#modal-spinner").modal('hide');
                                    Swal.fire("Erro!", response.message, "error");
                                }, 1500);
                            }
                        },
                        error: function (xhr, status, error) {
                            $("#modal-spinner").modal('hide');
                            console.error("Erro na requisição:", xhr.responseText); // Log do erro
                            Swal.fire({
                                icon: "error",
                                title: "Erro",
                                text: "Erro ao enviar os dados: " + xhr.responseText
                            });
                        }
                    });
                }
            });
        });
    });
</script>