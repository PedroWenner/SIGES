@using SIGES.Helpers
@using SIGES.ViewModel
@model ArquivoViewModel

@{
    ViewData["Titulo"] = "Arquivos";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Arquivos</h5>
    </div>
    <div class="span12" style="margin-left: 0">
        <div class="span3">
            @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "aArquivo"))
            {
                <a role="button" class="button btn btn-mini btn-success" style="max-width: 100px" asp-controller="Arquivo" asp-action="Adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Arquivo</span>
                </a>
            }
            else
            {
                <a role="button" class="button btn btn-mini btn-secondary disabled" style="max-width: 100px" title="Você não tem permissão para adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Arquivo</span>
                </a>
            }
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content">
            <table id="tabela">
                <thead>
                    <tr>
                        <th width="5%">#</th>
                        <th width="10%">Miniatura</th>
                        <th width="10%">Nome</th>
                        <th width="8%">Data</th>
                        <th>Descrição</th>
                        <th width="8%">Tamanho</th>
                        <th width="5%">Extensão</th>
                        <th width="14%">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Arquivos == null || Model.Arquivos.Count == 0)
                    {
                        <tr>
                            <td colspan="8">Nenhum arquivo cadastrado</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var archive in Model.Arquivos)
                        {
                            <tr>
                                <td>@archive.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(archive.Path) &&
                                   (archive.Tipo == ".jpg" || archive.Tipo == ".jpeg" || archive.Tipo == ".png" || archive.Tipo == ".gif" || archive.Tipo == ".bmp"))
                                    {
                                        <a href="@archive.Url" target="_blank">
                                            <img src="@archive.Url" style="width: 50px; height: 50px; object-fit: cover;" alt="Miniatura" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>@archive.Documento</td>
                                <td>@archive.Cadastro?.ToString("dd/MM/yyyy")</td>
                                <td>@archive.Descricao</td>
                                <td>@archive.Tamanho</td>
                                <td>@archive.Tipo</td>
                                <td>
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vArquivo"))
                                    {
                                        <a asp-controller="Arquivos" asp-action="Download" asp-route-id="@archive.Id" style="margin-right: 1%" class="btn-nwe text-decoration-none" title="Baixar arquivo">
                                            <i class="bx bx-download bx-xs"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eArquivo"))
                                    {
                                        <a asp-controller="Arquivos" asp-action="Editar" asp-route-id="@archive.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none" title="Editar">
                                            <i class="bx bx-edit bx-xs"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "dCategoria"))
                                    {
                                        <a href="#modal-excluir" data-id="@archive.Id" role="button" data-bs-target="#modal-excluir" data-bs-toggle="modal" style="margin-right: 1%" class="btn-nwe4 text-decoration-none" title="Excluir arquivo">
                                            <i class="bx bx-trash-alt bx-xs"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            
        </div>
    </div>
</div>

<!-- Modal excluir -->
<div id="modal-excluir" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Arquivo" asp-action="Excluir">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Excluir arquivo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="idDocumento" name="id" />
                    <h6 style="text-align: center">
                        Deseja realmente excluir este arquivo?
                    </h6>
                </div>
                <div class="modal-footer" style="display:flex;justify-content: center">
                    <button type="button" class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true">
                        <span class="button__icon"><i class="bx bx-x"></i></span>
                        <span class="button__text2">Cancelar</span>
                    </button>
                    <button type="submit" class="button btn btn-danger">
                        <span class="button__icon"><i class='bx bx-trash'></i></span>
                        <span class="button__text2">Excluir</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")

<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', 'a.btn-nwe4', function () {
            var idDocumento = $(this).data('id');
            $('#idDocumento').val(idDocumento);
        });
    });
</script>