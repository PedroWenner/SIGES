@model ArquivoModel

@{
    ViewData["Titulo"] = "Adicionar arquivo";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Cadastro de arquivo</h5>
        </div>
        <div class="card-body">
            <form id="formArquivo" method="post" enctype="multipart/form-data" asp-controller="Arquivo" asp-action="Adicionar">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label for="arquivoFile" class="form-label">Arquivo</label>
                    <input type="file" id="arquivoFile" name="userfile" accept=".txt,.pdf,.gif,.png,.jpg,.jpeg" required />
                    <small class="form-text text-muted">(Arquivos suportados: .txt, .pdf, .gif, .png, .jpg, .jpeg)</small>
                </div>

                <div class="mb-3">
                    <label for="documento" class="form-label">Nome do Arquivo</label>
                    <input id="documento" type="text" asp-for="Documento" required />
                    <span asp-validation-for="Documento" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="descricao" class="form-label">Descrição</label>
                    <textarea id="descricao" asp-for="Descricao" class="form-control"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="mb-3 col-md-2">
                    <label for="cadastro" class="form-label">Data de cadastro</label>
                    <input id="cadastro" type="date" asp-for="Cadastro" class="datetime" required />
                    <span asp-validation-for="Cadastro" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-center">
                    <a title="Voltar" class="button btn btn-warning" asp-controller="Arquivo" asp-action="Index">
                        <span class="button__icon"><i class="bx bx-undo"></i></span>
                        <span class="button__text2">Voltar</span>
                    </a>
                    <button type="submit" class="button btn btn-mini btn-success">
                        <span class="button__icon"><i class='bx bx-save'></i></span>
                        <span class="button__text2">Adicionar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('#formArquivo').validate({
            rules: {
                'Documento': { required: true },
                'userfile': { required: true, extension: "txt|pdf|gif|png|jpg|jpeg" },
                'Cadastro': { required: true }
            },
            messages: {
                'Documento': { required: 'Campo nome do arquivo é obrigatório.' },
                'userfile': {
                    required: 'Obrigatório selecionar um arquivo.',
                    extension: 'Por favor, insira um arquivo com uma extensão válida (txt, pdf, gif, png, jpg, jpeg).'
                },
                'Cadastro': { required: 'Campo data de cadastro é obrigatório.' }
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });
</script>