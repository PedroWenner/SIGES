@model ServicoModel

@{
    ViewData["Titulo"] = "Adicionar serviço";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Cadastrar serviço</h5>
        </div>
        <div class="card-body">
            <form id="formServico" method="post" asp-controller="Servico" asp-action="Adicionar">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Nome -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="nome" class="col-form-label">Nome</label>
                    </div>
                    <div class="col-md-4">
                        <input id="nome" type="text" asp-for="Nome" required />
                    </div>
                    <div class="col-md-6">
                        <span asp-validation-for="Nome" class="text-danger"></span>
                        <span class="form-text">Informe o código do serviço.</span>
                    </div>
                </div>

                <!-- Preço -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="valor" class="col-form-label">Valor</label>
                    </div>
                    <div class="col-md-4">
                        <input id="valor" type="text" asp-for="Valor" class="money" required />
                    </div>
                    <div class="col-md-6">
                        <span asp-validation-for="Valor" class="text-danger"></span>
                        <span class="form-text">Informe o valor do serviço.</span>
                    </div>
                </div>
                
                <!-- Descrição -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="descricao" class="col-form-label">Descrição</label>
                    </div>
                    <div class="col-md-4">
                        <input id="descricao" type="text" asp-for="Descricao" />
                    </div>
                    <div class="col-md-6">
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                        <span class="form-text">Informe a descrição do serviço.</span>
                    </div>
                </div>

                <!-- Botões -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-auto">
                        <a class="button btn btn-warning w-100" asp-controller="Servico" asp-action="Index">
                            <span class="button__icon"><i class="bx bx-undo"></i></span>
                            <span class="button__text2">Voltar</span>
                        </a>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="button btn btn-mini btn-success w-100">
                            <span class="button__icon"><i class='bx bx-save'></i></span>
                            <span class="button__text2">Adicionar</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
        $(".money").mask("#.##0,00", {reverse: true});

        $('#formServico').validate({
            rules: {
                'Nome': { required: true },
                'Valor': { required: true }
            },
            messages: {
                'Nome': { required: 'Campo nome é obrigatório.' },
                'Valor': { required: 'Campo valor é obrigatório.' }
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });
</script>