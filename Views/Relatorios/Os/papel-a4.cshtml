                        <div class="contatoEmitente">
                            <span style="font-weight: bold;">
                                Tel: @Model.Emitente.Telefone
                            </span>
                            <br />
                            <span style="font-weight: bold;">
                                @Model.Emitente.Email
                            </span>
                            <br />
                            <span style="word-break: break-word;">
                                Responsável: <b>@User?.Identity?.Name?.ToString()</b>
                                <br />
                            </span>
                        </div>
                    }
                </header>
                <section>
                    <div class="title">
                        ORDEM DE SERVIÇO #@Model.Os.Id.ToString("D4")
                        <span class="emissao">Emissão: @DateTime.Now.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="subtitle">ANEXO(S)</div>
                    <div class="dados">
                        <div style="width: 100%; display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap;">
                            @foreach(var a in Model.Anexos)
                            {
                                var isImage = a.FileType == "image";
                                var thumbnail = isImage ? a.Url : "/img/icon-file.png";

                                <img src="@thumbnail" alt="Anexo" class="img-fluid rounded" style="max-height: 120px;">
                            }
                        </div>
                    </div>
                </section>
            </div>
        }
    </div>
    <script type="text/javascript">
        window.print();
    </script>
</body>
</html>