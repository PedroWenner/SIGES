@using SIGES.Helpers

<style>

    #sidebar {
        color: white;
        transition: width 0.3s;
    }

    #sidebar .nav-link {
        color: white;
        display: flex;
        align-items: center;
        white-space: nowrap;
    }

    #sidebar li .icon, #sidebar li .title {
        color: white;
    }

    #sidebar li a:hover .iconX,
    #sidebar li a:hover .title {
        color: white;
    }

    #sidebar li.active {
        background: #ccc;
    }

    #sidebar li.active .iconX,
    #sidebar li.active .title {
        color: #04395b;
    }

    #sidebar li.active:hover .iconX,
    #sidebar li.active:hover .title {
        color: black;
    }

    .dropdown-item-custom:hover {
        color: black !important;
        border-radius: 0px!important;
    }

    .expand-icon {
        transition: transform 0.3s ease-in-out;
        font-size: 16px;
        color: #6c757d;
        margin-left: auto;
    }

    .nav-item .nav-link[aria-expanded="true"] .expand-icon {
        transform: rotate(180deg);
    }

    .nav-item .nav-link:hover .expand-icon {
        color: #6c757d;
    }

    #sidebar.open .expand-icon {
        font-size: 14px;
        transform: rotate(-90deg);
    }

    #sidebar.open .expand-icon {
        display: none;
    }

    #sidebar .expand-icon {
        display: inline-block;
    }
</style>

<link href="~/css/site.css" rel="stylesheet" />

<!--sidebar-menu-->
<nav id="sidebar" class="bg-theme-gray">
    <div id="newlog">
        <div class="icon2">
            <img src="~/img/01.png">
        </div>
    </div>
    <a href="#" class="visible-phone">
        <div class="mode">
            <div class="moon-menu">
                <i class='bx bx-chevron-right iconX open-2'></i>
                <i class='bx bx-chevron-left iconX close-2'></i>
            </div>
        </div>
    </a>

    <!-- Start Pesquisar-->
    <li class="search-box">
        <form style="display: flex" action="#">
            <button style="background:transparent;border:transparent" type="submit" title="">
                <i class='bx bx-search iconX'></i>
            </button>
            <input style="background:transparent;color:#313030;border:transparent;border-radius: 0px;" type="search" name="termo" placeholder="Pesquise aqui...">
            <span class="title-tooltip">Pesquisar</span>
        </form>
    </li>
    <!-- End Pesquisar-->

    <div class="menu-bar">
        <div class="menu">
            <ul class="menu-links" style="position: relative;">

                <!--Bloco home-->
                <li title="Início" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Home" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                    <a href="/">
                        <i class='bx bx-home-alt iconX'></i>
                        <span class="title">Início</span>
                        <span class="title-tooltip">Início</span>
                    </a>
                </li>

                <!-- Bloco Cadastro com Itens Dentro -->
                <li class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex justify-content-between align-items-center"
                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div style="display: inline-flex;">
                            <i class='bx bx-folder-open iconX'></i>
                            <span class="title">Cadastro</span>
                            <span class="title-tooltip">Cadastro</span>
                        </div>
                        <i class="bx bx-chevron-down expand-icon"></i>
                    </a>
                    <ul class="dropdown-menu" id="submenuCadastro" style="padding: 0px!important;">
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vCliente"))
                        {
                            <li>
                                <a asp-controller="Cliente" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class="fas fa-users"></i> Clientes
                                    <span class="title-tooltip">Clientes</span>
                                </a>
                            </li>
                        }
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vCategoria"))
                        {
                            <li>
                                <a asp-controller="Categoria" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class="fas fa-project-diagram"></i> Categorias
                                    <span class="title-tooltip">Categorias</span>
                                </a>
                            </li>
                        }
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vProduto"))
                        {
                            <li>
                                <a asp-controller="Produto" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class="fas fa-user-tag"></i> Produtos
                                    <span class="title-tooltip">Produtos</span>
                                </a>
                            </li>
                        }
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vServico"))
                        {
                            <li>
                                <a asp-controller="Servicos" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class="fas fa-toolbox"></i> Serviços
                                    <span class="title-tooltip">Serviços</span>
                                </a>
                            </li>
                        }
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vGarantia"))
                        {
                            <li>
                                <a asp-controller="Garantia" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class="fas fa-file-upload"></i> Termos de garantia
                                    <span class="title-tooltip">Termos de garantia</span>
                                </a>
                            </li>
                        }
                    </ul>
                </li>

                @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vVenda"))
                {
                    <!--Bloco de Vendas-->
                    <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Venda" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                        <a asp-controller="Venda" asp-action="Index">
                            <i class='bx bx-cart-alt iconX'></i>
                            <span class="title">Vendas</span>
                            <span class="title-tooltip">Vendas</span>
                        </a>
                    </li>
                }

                @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vOs"))
                {
                    <!--Bloco de OS-->
                    <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Ordem" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                        <a asp-controller="Ordem" asp-action="Index">
                            <i class='bx bx-file iconX'></i>
                            <span class="title">Ordens de serviço</span>
                            <span class="title-tooltip">Ordens de serviço</span>
                        </a>
                    </li>
                }

                @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vArquivo"))
                {
                    <!--Bloco de OS-->
                    <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Arquivo" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                        <a asp-controller="Arquivo" asp-action="Index">
                            <i class='bx bx-box iconX'></i>
                            <span class="title">Arquivos</span>
                            <span class="title-tooltip">Arquivos</span>
                        </a>
                    </li>
                }

                @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vLancamento"))
                {
                    <!--Bloco de Lancamentos-->
                    <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Lancamento" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                        <a asp-controller="Lancamento" asp-action="Index">
                            <i class='bx bx-bar-chart-alt-2 iconX'></i>
                            <span class="title">Lançamentos</span>
                            <span class="title-tooltip">Lançamentos</span>
                        </a>
                    </li>
                }

                @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vCobranca"))
                {
                    <!--Bloco de Lancamentos-->
                    <li class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Cobranca" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                        <a asp-controller="Cobranca" asp-action="Index">
                            <i class='bx bx-dollar-circle iconX'></i>
                            <span class="title">Cobranças</span>
                            <span class="title-tooltip">Cobranças</span>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <div class="botton-content">
            <li class="">
                <a asp-controller="Login" asp-action="Logout">
                    <i class='bx bx-log-out-circle iconX'></i>
                    <span class="title">Sair</span>
                    <span class="title-tooltip">Sair</span>
                </a>
            </li>
        </div>
    </div>
</nav>
<!--End sidebar-menu-->