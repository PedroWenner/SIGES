<!--sidebar-menu-->
<nav id="sidebar">
    <div id="newlog">
        <div class="icon2">
            <img src="">
        </div>
        <div class="title1">
            
        </div>
    </div>
    <a href="#" class="visible-phone">
        <div class="mode">
            <div class="moon-menu">
                <i class='bx bx-chevron-right iconX open-2'></i>
                <i class='bx bx-chevron-left iconX close-2'></i>
            </div>
        </div>
    </a>
    <!-- Start Pesquisar-->
    <li class="search-box">
        <form style="display: flex" action="#">
            <button style="background:transparent;border:transparent" type="submit" title="">
                <i class='bx bx-search iconX'></i>
            </button>
            <input style="background:transparent;color:#313030;border:transparent" type="search" name="termo" placeholder="Pesquise aqui...">
            <span class="title-tooltip">Pesquisar</span>
        </form>
    </li>
    <!-- End Pesquisar-->

    @{
        var routesDashboard = new List<string> { "/", "/dashboard", "/dashboard/" };
        var routesLancamento = new List<string> { "/dashboard/lancamentos/", "/dashboard/lancamentos", "/dashboard/lancamentos/adicionar" };
        var routesPedidos = new List<string> { "/dashboard/pedidos/", "/dashboard/pedidos", "/dashboard/pedidos/adicionar", "/dashboard/pedidos/editar", "/dashboard/pedidos/visualizar" };
        var routesProdutos = new List<string> { "/dashboard/produtos/", "/dashboard/produtos", "/dashboard/produtos/adicionar", "/dashboard/produtos/editar", "/dashboard/produtos/visualizar" };
        var routesCatalogo = new List<string> { "/dashboard/catalogo/", "/dashboard/catalogo", "/dashboard/catalogo/adicionar", "/dashboard/catalogo/editar", "/dashboard/catalogo/visualizar" };
        var routesClient = new List<string> { "/dashboard/clientes/", "/dashboard/clientes", "/dashboard/clientes/adicionar", "/dashboard/clientes/editar", "/dashboard/clientes/visualizar" };
        var routesHist = new List<string> { "/dashboard/historico/", "/dashboard/historico" };
        var routesStats = new List<string> { "/dashboard/estatistica/", "/dashboard/estatistica" };
        var routesUsers = new List<string> { "/dashboard/usuarios/", "/dashboard/usuarios", "/dashboard/usuarios/adicionar", "/dashboard/usuarios/editar", "/dashboard/usuarios/visualizar" };
        var routesHelp = new List<string> { "/dashboard/ajuda/", "/dashboard/ajuda" };
    }

    <div class="menu-bar">
        <div class="menu">
            <ul class="menu-links" style="position: relative;">

                <!--Bloco home-->
                <li class="@(routesDashboard.Contains(ViewContext.HttpContext.Request.Path) ? "active" : "")" title="Início">
                    <a href="/">
                        <i class='bx bx-home-alt iconX'></i>
                        <span class="title nav-title">Início</span>
                        <span class="title-tooltip">Início</span>
                    </a>
                </li>

                <!--Bloco de pedidos-->
                <li class="@(routesPedidos.Contains(ViewContext.HttpContext.Request.Path) ? "active" : "")" title="Pedidos">
                    <a href="#">
                        <i class='bx bx-bell iconX'></i>
                        <span class="title">Pedidos</span>
                        <span class="title-tooltip">Pedidos</span>
                    </a>
                </li>

                <!--Bloco de produtos-->
                <li class="@(routesProdutos.Contains(ViewContext.HttpContext.Request.Path) ? "active" : "")" title="Produtos">
                    <a href="#">
                        <i class='bx bx-shape-square iconX'></i>
                        <span class="title">Produtos</span>
                        <span class="title-tooltip">Produtos</span>
                    </a>
                </li>

                <!--Bloco do clientes-->
                <li class="@(routesClient.Contains(ViewContext.HttpContext.Request.Path) ? "active" : "")" title="Clientes">
                    <a href="#">
                        <i class='bx bx-user iconX'></i>
                        <span class="title">Clientes</span>
                        <span class="title-tooltip">Clientes</span>
                    </a>
                </li>

                <!--Bloco do Usuários-->
                <li class="@(routesUsers.Contains(ViewContext.HttpContext.Request.Path) ? "active" : "")" title="Usuários">
                    <a asp-controller="Usuario" asp-action="Index">
                        <i class='bx bx-group iconX'></i>
                        <span class="title">Usuários</span>
                        <span class="title-tooltip">Usuários</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="botton-content">
            <li class="">
                <a asp-controller="Login" asp-action="Logout">
                    <i class='bx bx-log-out-circle iconX'></i>
                    <span class="title">Sair</span>
                    <span class="title-tooltip">Sair</span>
                </a>
            </li>
        </div>
    </div>
</nav>
<!--End sidebar-menu-->