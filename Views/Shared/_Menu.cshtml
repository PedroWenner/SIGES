@using SIGES.Helpers

<style>
    .dropdown-item-custom:hover {
        color: black!important;
        background: none!important;
    }

    .expand-icon {
        transition: transform 0.3s ease-in-out;
        font-size: 16px;
        color: #6c757d;
        margin-left: auto;
    }

    .nav-item .nav-link[aria-expanded="true"] .expand-icon {
        transform: rotate(180deg);
    }

    .nav-item .nav-link:hover .expand-icon {
        color: #6c757d;
    }

    #sidebar.open .expand-icon {
        font-size: 14px;
        transform: rotate(-90deg);
    }

    #sidebar.open .expand-icon {
        display: none;
    }

    #sidebar .expand-icon {
        display: inline-block;
    }
</style>

<!--sidebar-menu-->
<nav id="sidebar">
    <div id="newlog">
        <div class="icon2">
            <img src="~/img/AlcaLogo1.png">
        </div>
        <div class="title1">

        </div>
    </div>
    <a href="#" class="visible-phone">
        <div class="mode">
            <div class="moon-menu">
                <i class='bx bx-chevron-right iconX open-2'></i>
                <i class='bx bx-chevron-left iconX close-2'></i>
            </div>
        </div>
    </a>
    <!-- Start Pesquisar-->
    <li class="search-box">
        <form style="display: flex" action="#">
            <button style="background:transparent;border:transparent" type="submit" title="">
                <i class='bx bx-search iconX'></i>
            </button>
            <input style="background:transparent;color:#313030;border:transparent" type="search" name="termo" placeholder="Pesquise aqui...">
            <span class="title-tooltip">Pesquisar</span>
        </form>
    </li>
    <!-- End Pesquisar-->

    <div class="menu-bar">
        <div class="menu">
            <ul class="menu-links" style="position: relative;">

                <!--Bloco home-->
                <li title="Início" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Home" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                    <a href="/">
                        <i class='bx bx-home-alt iconX'></i>
                        <span class="title nav-title">Início</span>
                        <span class="title-tooltip">Início</span>
                    </a>
                </li>

                <!-- Bloco Cadastro com Itens Dentro -->
                <li class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex justify-content-between align-items-center"
                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div style="display: inline-flex;">
                            <i class='bx bx-folder-open iconX'></i>
                            <span class="title">Cadastro</span>
                        </div>
                        <i class="bx bx-chevron-down expand-icon"></i>
                    </a>
                    <ul class="dropdown-menu" id="submenuCadastro" style="padding: 5px 20px 5px 0px!important;">
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vCliente"))
                        {
                            <li>
                                <a asp-controller="Cliente" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class='bx bx-user iconX'></i> Clientes
                                </a>
                            </li>
                        }
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vUsuario"))
                        {
                            <li>
                                <a asp-controller="Usuario" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class='bx bx-group iconX'></i> Usuários
                                </a>
                            </li>
                        }
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vCategoria"))
                        {
                            <li>
                                <a asp-controller="Categoria" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class='bx bx-category iconX'></i> Categorias
                                </a>
                            </li>
                        }
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vProduto"))
                        {
                            <li>
                                <a asp-controller="Produto" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class='bx bx-basket iconX'></i> Produtos
                                </a>
                            </li>
                        }
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vServico"))
                        {
                            <li>
                                <a asp-controller="Servicos" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class='bx bx-wrench iconX'></i> Serviços
                                </a>
                            </li>
                        }
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vGarantia"))
                        {
                            <li>
                                <a asp-controller="Garantia" asp-action="Index" class="dropdown-item dropdown-item-custom">
                                    <i class='bx bx-receipt iconX'></i> Termos de garantia
                                </a>
                            </li>
                        }
                    </ul>
                </li>

                @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vOs"))
                {
                    <!--Bloco de OS-->
                    <li title="OS" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Ordem" && ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                        <a asp-controller="Ordem" asp-action="Index">
                            <i class='bx bx-file iconX'></i>
                            <span class="title">Ordens de serviço</span>
                            <span class="title-tooltip">Ordens</span>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <div class="botton-content">
            <li class="">
                <a asp-controller="Login" asp-action="Logout">
                    <i class='bx bx-log-out-circle iconX'></i>
                    <span class="title">Sair</span>
                    <span class="title-tooltip">Sair</span>
                </a>
            </li>
        </div>
    </div>
</nav>
<!--End sidebar-menu-->