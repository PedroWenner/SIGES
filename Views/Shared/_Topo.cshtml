@using SIGES.Helpers
<!-- Top Header Menu -->
<div class="navbar navbar-expand-lg navbar-inverse navebarn">
    <div id="user-nav" class="">
        <div class="container-fluid">
            <!-- User Navigation -->
            <ul class="navbar-nav ms-auto">
                <!-- User Dropdown -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bx bx-user-circle iconN"></i>
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="userDropdown">
                        <li>
                            <a class="dropdown-item" href="#" target="_blank" title="Área do cliente">Área do cliente</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Sistema" asp-action="MinhaConta" title="Meu perfil">Meu perfil</a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Login" asp-action="Logout" title="Sair do sistema">
                                <i class="bx bx-log-out-circle"></i>Sair do sistema
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Relatórios Dropdown -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="reportsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bx bx-pie-chart-alt-2 iconN"></i>
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="reportsDropdown">
                        <li><a class="dropdown-item" href="@Url.Content("/Relatorios/RelClientes?handler=GeneratePdf")" target="_blank">Clientes</a></li>
                        <li><a class="dropdown-item" href="@Url.Content("/dashboard/produtos")">Produtos</a></li>
                        <li><a class="dropdown-item" href="#">Pedidos</a></li>
                    </ul>
                </li>

                <!-- Configurações Dropdown -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="settingsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bx bx-cog iconN"></i>
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="settingsDropdown">
                        <li><a class="dropdown-item" asp-controller="Sistema" asp-action="Index">Sistema</a></li>
                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vUsuario"))
                        {
                            <li><a class="dropdown-item" asp-controller="Usuario" asp-action="Index">Usuários</a></li>
                        }
                        <li><a class="dropdown-item" asp-controller="Emitente" asp-action="Index">Emitente</a></li>
                        <li><a class="dropdown-item" asp-controller="Permissao" asp-action="Index">Permissões</a></li>
                        <li><a class="dropdown-item" asp-controller="Log" asp-action="Index">Auditoria</a></li>
                        <li><a class="dropdown-item" asp-controller="Email" asp-action="Index">E-mails</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>

    <!-- User Section -->
    <div id="userr" style="padding-right:45px;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;">
        <div class="user-names userT0 me-4">
            @SaudeHelper.ObterSaudacao(),
        </div>
        <div class="userT me-4">
            @{
                string name = User.Identity.Name.ToString();
                string[] words = name.Split(' ');
            }
            @words[0]
        </div>

        <section style="display:block;position:absolute;right:5px">
            <div class="profile">
                <div class="profile-img">
                    @{
                        var userImage = Context.Session.GetString("UserImage");
                        if (!string.IsNullOrEmpty(userImage))
                        {
                            <a asp-controller="Sistema" asp-action="MinhaConta">
                                <img src="data:image/png;base64,@userImage" alt="Foto do Usuário" style="width: 100%; height: 100%;">
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Sistema" asp-action="MinhaConta">
                                <img src="~/img/User.png" alt="Usuário" style="width: 100%; height: 100%;">
                            </a>
                        }
                    }
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Search Bar -->
<div id="search" class="d-none">
    <form class="d-flex p-2 border">
        <input class="form-control" type="text" name="termo" placeholder="Pesquisar..." aria-label="Pesquisar">
        <button class="btn btn-outline-secondary" type="submit" title="Pesquisar">
            <i class="fas fa-search"></i>
        </button>
    </form>
</div>
