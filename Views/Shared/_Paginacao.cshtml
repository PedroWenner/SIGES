@using SIGES.Classes
@model Paginacao<UsuarioModel>

<style type="text/css">
    .custom-pagination .page-item .page-link {
        color: #6c757d; /* Cor padrão do texto */
        background-color: #ffffff; /* Fundo branco */
        border: 1px solid #dee2e6; /* Borda leve */
        padding: 0.15rem 0.45rem; /* Espaçamento maior */
        border-radius: 5px; /* Borda arredondada */
        transition: all 0.2s ease-in-out; /* Transição suave */
    }

    .custom-pagination .page-item.active .page-link {
        background-color: #999; /* Fundo preto */
        color: #ffffff; /* Texto branco */
        border-color: #dee2e6; /* Borda preta */
    }

    .custom-pagination .page-item .page-link:hover {
        background-color: #f8f9fa; /* Fundo cinza claro no hover */
        color: #000000; /* Texto preto */
        border-color: #dee2e6; /* Borda leve */
    }

    .custom-pagination .page-item:first-child .page-link,
    .custom-pagination .page-item:last-child .page-link {
        font-weight: bold; /* "Previous" e "Next" com destaque */
    }

    .custom-pagination .page-item {
        margin: 0 5px; /* Espaçamento entre os botões */
    }
</style>

<nav aria-label="Paginação">
    <ul class="pagination custom-pagination justify-content-center pagination-sm">
        <!-- Botão "Primeiro" -->
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" href="?pagina=1" aria-label="Primeira" tabindex="-1">
                    Primeiro
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                    Primeiro
                </a>
            </li>
        }

        <!-- Botões de Página -->
        @for (int i = 1; i <= Model.TotalPaginas; i++)
        {
            if (i == Model.PaginaAtual)
            {
                <li class="page-item active" aria-current="page">
                    <a class="page-link" href="#">@i</a>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="?pagina=@i">@i</a>
                </li>
            }
        }

        <!-- Botão "Último" -->
        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" href="?pagina=@Model.TotalPaginas" aria-label="Última">
                    Último
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                    Último
                </a>
            </li>
        }
    </ul>
</nav>