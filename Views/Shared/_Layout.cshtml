@using global::SIGES.Classes
@using global::SIGES.Helpers

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Titulo"] - SIGES</title>
    <link rel="shortcut icon" type="image/png" />

    <link rel="stylesheet" href="@Url.Content("~/bootstrap-5.3.3/css/bootstrap.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/matrix-style.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/matrix-media.css")" />
    <link rel="stylesheet" href="@Url.Content("~/font-awesome/css/font-awesome.css")" />

    <link rel="stylesheet" href="@Url.Content("~/css/datatables-2.1.8.css")" />
    @* <link rel="stylesheet" href="@Url.Content("~/css/fullcalendar.css")" /> *@

    <link rel="stylesheet" href="@Url.Content("~/css/tema-white.css")" />

    <link href='https://fonts.googleapis.com/css?family=Open+Sans:400,700,800' rel='stylesheet' type='text/css'>
    <link href='https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;400;500;700&display=swap' rel='stylesheet' type='text/css'>
    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css' rel='stylesheet'>

    <script src="@Url.Content("~/js/jquery-3.7.1.min.js")"></script>
    <script src="@Url.Content("~/js/shortcut.js")"></script>
    <script src="@Url.Content("~/js/funcoesGlobal.js")"></script>
    <script src="@Url.Content("~/js/sweetalert.min.js")"></script>

    <script src="@Url.Content("~/js/datatables-2.1.8.js")"></script>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="~/js/modernizr.js"></script>
    <script src="~/js/nanoscroller.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="~/js/shotcuts.js" type="text/javascript"></script>
    <script src="~/js/custom.js" type="text/javascript"></script>

    <style type="text/css">
        .dataTables_wrapper {
            height: 600px
        }

        .select2-search__field {
            padding: 15px !important;
        }

        .help-block-personal {
            margin-top: 5px;
            color: #b94a48;
        }

        .cabecalho {
            text-align: center !important;
        }

        .control-group.error .help-inline {
            display: flex;
        }

        .form-horizontal .control-group {
            border-bottom: 1px solid #ffffff;
        }

        .form-horizontal .controls {
            padding-bottom: 8px 0;
        }

        .nopadding {
            padding: 0 20px !important;
            margin-right: 20px;
        }

        .situacao-ativo {
            background: linear-gradient(270deg, #15b698, #62eba6);
            color: white;
            box-shadow: 0 5px 10px rgb(0 0 0 / 8%);
        }

        .situacao-inativo {
            background: linear-gradient(270deg, #e72727, #fd9eb1);
            color: white;
            box-shadow: 0 5px 10px rgb(0 0 0 / 8%);
        }

        .situacao-fazendo {
            background: linear-gradient(270deg, #2790e7, #256288);
            color: white;
            box-shadow: 0 5px 10px rgb(0 0 0 / 8%);
        }

        .cardBox .card {
            border: none !important;
            flex-direction: row !important;
        }

        .dt-search {
            margin-bottom: 20px;
        }

        .dt-length {
            margin-bottom: 20px;
        }
    </style>

    <style>
        .dt-paging {
            display: flex;
            justify-content: center; /* Centraliza horizontalmente */
            align-items: center; /* Centraliza verticalmente, caso necessário */
            margin-top: 1rem !important; /* Espaçamento superior opcional */
        }

        /* Estilo padrão dos botões de paginação */
        .dt-paging .page-item .page-link {
            color: #6c757d; /* Cor padrão do texto */
            background-color: #ffffff; /* Fundo branco */
            border: 1px solid #dee2e6; /* Borda leve */
            padding: 0.15rem 0.45rem; /* Espaçamento maior */
            border-radius: 5px; /* Borda arredondada */
            transition: all 0.2s ease-in-out; /* Transição suave */
            font-size: 0.7rem;
        }

        /* Estilo para o botão ativo */
        .dt-paging .page-item.active .page-link {
            background-color: #999; /* Fundo preto */
            color: #ffffff; /* Texto branco */
            border-color: #dee2e6; /* Borda preta */
        }

        /* Estilo no hover */
        .dt-paging .page-item .page-link:hover {
            background-color: #f8f9fa; /* Fundo cinza claro no hover */
            color: #000000; /* Texto preto */
            border-color: #dee2e6; /* Borda leve */
        }

        /* Botões "Primeiro" e "Último" com destaque */
        .dt-paging .page-item:first-child .page-link,
        .dt-paging .page-item:last-child .page-link {
            font-weight: bold; /* Destaque para "Primeiro" e "Último" */
        }

        /* Espaçamento entre os botões */
        .dt-paging .page-item {
            margin: 0 5px; /* Espaçamento entre os botões */
        }
    </style>

    <style>
        input.is-invalid::placeholder {
            color: #dc3545; /* Vermelho para erro */
            opacity: 0.8; /* Garante que o placeholder seja totalmente visível */
            font-size: 12px;
        }
    </style>
</head>
<body>
    @await Html.PartialAsync("_Topo")
    @await Html.PartialAsync("_Menu")

    <div id="content">
        <div id="content-header">
            <div></div>
            <div id="breadcrumb">
                @Html.Raw(BreadcrumbHelper.GerarBreadcrumb(ViewContext))
            </div>
        </div>
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">
                    @RenderBody()

                    @if (TempData["Success"] != null)
                    {
                        <script type="text/javascript">
                            Swal.fire({
                                position: 'center',
                                icon: 'success',
                                text: '@Html.Raw(TempData["Success"])',
                                showConfirmButton: true,
                                timer: 4000
                            });
                        </script>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <script type="text/javascript">
                            Swal.fire({
                                position: 'center',
                                icon: 'error',
                                text: '@Html.Raw(TempData["Error"])',
                                showConfirmButton: true,
                                timer: 4000
                            });
                        </script>
                    }

                    @if (TempData["Warning"] != null)
                    {
                        <script type="text/javascript">
                            Swal.fire({
                                position: 'center',
                                icon: 'warning',
                                text: '@Html.Raw(TempData["Warning"])',
                                showConfirmButton: true,
                                timer: 4000
                            });
                        </script>
                    }

                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_Rodape")

    <script src="~/bootstrap-5.3.3/js/bootstrap.bundle.js"></script>

    <script charset="ISO-8859-1" src="~/js/datatableJs.js" type="text/javascript"></script>
    <script charset="ISO-8859-1" src="~/js/logJs.js" type="text/javascript"></script>
</body>
</html>
