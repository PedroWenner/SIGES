@using global::SIGES.Classes
@using global::SIGES.Helpers

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Titulo"] - SIGES</title>
    <link rel="shortcut icon" type="image/png" href="~/img/AlcaLogo1.png" />

    <link rel="stylesheet" href="@Url.Content("~/bootstrap-5.3.3/css/bootstrap.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/matrix-style.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/matrix-media.css")" />
    <link rel="stylesheet" href="@Url.Content("~/font-awesome/css/font-awesome.css")" />

    <link rel="stylesheet" href="@Url.Content("~/css/datatables-2.1.8.css")" />

    @await Component.InvokeAsync("TemaPadrao")

    <link href='https://fonts.googleapis.com/css?family=Open+Sans:400,700,800' rel='stylesheet' type='text/css'>
    <link href='https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;400;500;700&display=swap' rel='stylesheet' type='text/css'>
    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

    <script src="@Url.Content("~/js/jquery-3.7.1.min.js")"></script>
    <script charset="ISO-8859-1" src="~/js/configuracaoJsService.js" type="text/javascript"></script>
    <script src="@Url.Content("~/js/shortcut.js")"></script>
    <script src="@Url.Content("~/js/funcoesGlobal.js")"></script>
    <script src="@Url.Content("~/js/sweetalert.min.js")"></script>

    <script src="@Url.Content("~/js/datatables-2.1.8.js")"></script>

    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="~/js/modernizr.js"></script>
    <script src="~/js/nanoscroller.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="~/js/shotcuts.js" type="text/javascript"></script>
    <script src="~/js/custom.js" type="text/javascript"></script>

    <style type="text/css">
        .dataTables_wrapper {
            height: 600px
        }

        .select2-search__field {
            padding: 15px !important;
        }

        .help-block-personal {
            margin-top: 5px;
            color: #b94a48;
        }

        .cabecalho {
            text-align: center !important;
        }

        .control-group.error .help-inline {
            display: flex;
        }

        .form-horizontal .control-group {
            border-bottom: 1px solid #ffffff;
        }

        .form-horizontal .controls {
            padding-bottom: 8px 0;
        }

        .nopadding {
            padding: 0 20px !important;
            margin-right: 20px;
        }

        .situacao-ativo {
            background: linear-gradient(270deg, #15b698, #62eba6);
            color: white;
            box-shadow: 0 5px 10px rgb(0 0 0 / 8%);
        }

        .situacao-inativo {
            background: linear-gradient(270deg, #e72727, #fd9eb1);
            color: white;
            box-shadow: 0 5px 10px rgb(0 0 0 / 8%);
        }

        .situacao-fazendo {
            background: linear-gradient(270deg, #2790e7, #256288);
            color: white;
            box-shadow: 0 5px 10px rgb(0 0 0 / 8%);
        }

        .cardBox .card {
            border: none !important;
            flex-direction: row !important;
        }

        .dt-search {
            margin-bottom: 20px;
        }

        .dt-length {
            margin-bottom: 20px;
        }

        .bg-theme-gray {
            background: #343a40!important;
            background-color: #343a40!important;
        }
    </style>

    <style type="text/css">
        .dt-paging {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 1rem !important;
        }

        /* Estilo padrão dos botões de paginação */
        .dt-paging .page-item .page-link {
            color: #6c757d;
            background-color: #ffffff;
            border: 1px solid #dee2e6;
            padding: 0.15rem 0.45rem;
            border-radius: 5px;
            transition: all 0.2s ease-in-out;
            font-size: 0.7rem;
        }

        /* Estilo para o botão ativo */
        .dt-paging .page-item.active .page-link {
            background-color: #999;
            color: #ffffff;
            border-color: #dee2e6;
        }

        .dt-paging .page-item .page-link:hover {
            background-color: #f8f9fa;
            color: #000000;
            border-color: #dee2e6;
        }

        /* Botões "Primeiro" e "Último" com destaque */
        .dt-paging .page-item:first-child .page-link,
        .dt-paging .page-item:last-child .page-link {
            font-weight: bold;
        }

        .dt-paging .page-item {
            margin: 0 1px;
        }

        .dt-paging .page-item.disabled .page-link {
            background-color: #e9ecef;
            color: #6c757d;
            border-color: #dee2e6;
            cursor: not-allowed;
        }
    </style>

    <style type="text/css">
        input.is-invalid::placeholder {
            color: #dc3545;
            opacity: 0.8;
            font-size: 12px;
        }
    </style>

    <style>
        .ui-autocomplete {
            max-height: 200px;
            overflow-y: auto;
            overflow-x: hidden;
            border: 1px solid #ddd;
            background-color: #fff;
            font-size: 14px;
            z-index: 1000;
            border-radius: 5px;
            overflow: hidden;
        }

        .ui-menu-item .ui-menu-item-wrapper {
            display: flex;
            flex-direction: column;
            border-bottom: 1px solid #eee;
            justify-content: space-between;

        }

        .ui-menu-item .ui-menu-item-wrapper:hover {
            background-color: #f7f7f7;
        }

        .ui-state-active {
            background-color: transparent !important;
            color: inherit !important;
        }

        .autocomplete-title {
            font-weight: bold;
            color: #333;
        }

        .autocomplete-add {
            font-weight: bold;
            color: #333;
            text-align: center;
        }

        .autocomplete-details {
            color: #777;
            font-size: 0.9em;
        }

        .form-control.is-valid,
        .form-control.is-invalid {
            background-image: none !important;
            padding-right: 0.75rem;
        }

        /* Remove os ícones de validação dos selects */
        .form-select.is-valid,
        .form-select.is-invalid {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
            padding-right: 0.75rem;
        }
    </style>
</head>
<body>
    @await Html.PartialAsync("_Topo")
    @await Html.PartialAsync("_Menu")

    <div id="content">
        <div id="content-header">
            <div></div>
            <div id="breadcrumb">
                @Html.Raw(BreadcrumbHelper.GerarBreadcrumb(ViewContext))
            </div>
        </div>
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">
                    @RenderBody()

                    @if (TempData["Success"] != null)
                    {
                        <script type="text/javascript">
                            Swal.fire({
                                position: 'center',
                                icon: 'success',
                                text: '@Html.Raw(TempData["Success"])',
                                showConfirmButton: true,
                                timer: 4000
                            });
                        </script>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <script type="text/javascript">
                            Swal.fire({
                                position: 'center',
                                icon: 'error',
                                text: '@Html.Raw(TempData["Error"])',
                                showConfirmButton: true,
                                timer: 4000
                            });
                        </script>
                    }

                    @if (TempData["Warning"] != null)
                    {
                        <script type="text/javascript">
                            Swal.fire({
                                position: 'center',
                                icon: 'warning',
                                text: '@Html.Raw(TempData["Warning"])',
                                showConfirmButton: true,
                                timer: 4000
                            });
                        </script>
                    }

                    @if (Context.Session.GetString("PermissaoMensagem") is string mensagem && !string.IsNullOrEmpty(mensagem))
                    {
                        <script type="text/javascript">
                            Swal.fire({
                                position: 'center',
                                icon: 'warning',
                                text: '@Html.Raw(@mensagem)',
                                showConfirmButton: true,
                                timer: 4000
                            });
                        </script>
                        
                        Context.Session.Remove("PermissaoMensagem");
                    }

                </div>
            </div>
        </div>
    </div>

    <script src="~/bootstrap-5.3.3/js/bootstrap.bundle.js"></script>

    <script charset="ISO-8859-1" src="~/js/datatableJs.js" type="text/javascript"></script>
    <script charset="ISO-8859-1" src="~/js/logJs.js" type="text/javascript"></script>
    <script src="@Url.Content("~/js/jquery.mask.js")"></script>
    @await Html.PartialAsync("_Rodape")
</body>
</html>
