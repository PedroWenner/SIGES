@using SIGES.Helpers
@using SIGES.ViewModel
@model GarantiaViewModel

@{
    ViewData["Titulo"] = "Garantia";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Garantia</h5>
    </div>
    <div class="col-lg-12" style="margin-left: 0">
        <div class="col-md-2">
            <a role="button" class="button btn btn-mini btn-success w-100" asp-controller="Garantia" asp-action="Adicionar">
                <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                <span class="button__text2">Garantia</span>
            </a>
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content table-responsive">
            <table id="tabela">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Data</th>
                        <th>Ref. garantia</th>
                        <th>Termo</th>
                        <th>Usuário</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Garantias == null || Model.Garantias.Count == 0)
                    {
                        <tr>
                            <td colspan="6">Nenhum garantia cadastrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var garantia in Model.Garantias)
                        {
                            <tr>
                                <td>@garantia.Id</td>
                                <td>@Convert.ToDateTime(garantia.DataGarantia).ToString("dd/MM/yyyy")</td>
                                <td>@HtmlHelpers.TruncateString(@garantia.RefGarantia ?? "", 50)</td>
                                <td>
                                    @HtmlHelpers.TruncateString(HtmlHelpers.RemoverTagsHtml(@garantia.TextoGarantia ?? ""), 50)
                                </td>
                                <td>@garantia.Usuario.Nome</td>
                                <td>
                                    <a href="#" data-entidade="GarantiaModel" data-id="@garantia.Id" style="margin-right: 1%" class="btn-nwe7 btn-exibir-log text-decoration-none" title="Exibir histórico">
                                        <i class='bx bx-history'></i>
                                    </a>
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eGarantia"))
                                    {
                                        <a asp-controller="Garantia" asp-action="Editar" asp-route-id="@garantia.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none" title="Editar garantia">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vGarantia"))
                                    {
                                        <a asp-controller="Garantia" asp-action="Imprimir" asp-route-id="@garantia.Id" asp-route-tipo="termo-garantia" target="_blank" style="margin-right: 1%" class="btn-nwe6 text-decoration-none" title="Imprimir">
                                            <i class="bx bx-printer"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "dGarantia"))
                                    {
                                        <a href="#modal-excluir" data-id="@garantia.Id" role="button" data-bs-target="#modal-excluir" data-bs-toggle="modal" style="margin-right: 1%" class="btn-nwe4 text-decoration-none" title="Excluir garantia">
                                            <i class="bx bx-trash-alt"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")

<!-- Modal excluir -->
<div id="modal-excluir" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Garantia" asp-action="Excluir">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Excluir garantia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="idGarantia" name="id" />
                    <h6 style="text-align: center">
                        Deseja realmente excluir esta garantia e os dados associados a ela?
                    </h6>
                </div>
                <div class="modal-footer" style="display:flex;justify-content: center">
                    <button type="button" class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true">
                        <span class="button__icon"><i class="bx bx-x"></i></span>
                        <span class="button__text2">Cancelar</span>
                    </button>
                    <button type="submit" class="button btn btn-danger">
                        <span class="button__icon"><i class='bx bx-trash'></i></span>
                        <span class="button__text2">Excluir</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', 'a.btn-nwe4', function () {
            var garantiaId = $(this).data('id');
            $('#idGarantia').val(garantiaId);
        });
    });
</script>