@model GarantiaModel

@{
    ViewData["Titulo"] = "Adicionar garantia";
}

<link rel="stylesheet" href="~/trumbowyg/dist/ui/trumbowyg.css">
<style>
    .ck-editor__editable {
        min-height: 300px;
        border: 1px solid #ccc;
        padding: 10px;
        width: 100%;
        white-space: normal !important;
        overflow-wrap: break-word;
        word-wrap: break-word;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Cadastrar garantia</h5>
        </div>
        <div class="card-body">
            <form id="formGarantia" method="post" asp-controller="Garantia" asp-action="Adicionar">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row mb-3 mt-3">
                    <div class="col-2">
                    <label for="dataGarantia" class="form-label">Data</label>
                        <input id="dataGarantia" type="text" asp-for="DataGarantia" class="datetime" value="@DateTime.Now.ToString("dd/MM/yyyy")" required />
                        <span asp-validation-for="DataGarantia" class="text-danger"></span>
                    </div>
                    <div class="col-3">
                        <label for="responsavel" class="form-label">Responsável</label>
                        <input id="responsavel" type="text" placeholder="Digite o nome do responsável" required />
                        <input id="responsavel-id" type="hidden" asp-for="UsuarioId" />
                        <span asp-validation-for="UsuarioId" class="text-danger"></span>
                    </div>
                    <div class="col-7">
                        <label for="refGarantia" class="form-label">Ref. garantia</label>
                        <input id="refGarantia" type="text" asp-for="RefGarantia" placeholder="Informe uma referência: Exemplos: TV, Notebook, Celular" required />
                        <span asp-validation-for="RefGarantia" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3 mt-3">
                    <div class="col-12">
                        <label for="textoGarantia" class="form-label">Termo de garantia</label>
                        <textarea asp-for="TextoGarantia" id="textoGarantia" required></textarea>
                    </div>
                </div>

                <!-- Botões -->
                <div class="d-flex justify-content-center">
                    <a title="Voltar" class="button btn btn-warning" asp-controller="Garantia" asp-action="Index">
                        <span class="button__icon"><i class="bx bx-undo bx-xs"></i></span>
                        <span class="button__text2">Voltar</span>
                    </a>
                    <button type="submit" class="button btn btn-mini btn-success">
                        <span class="button__icon"><i class='bx bx-sync bx-xs'></i></span>
                        <span class="button__text2">Cadastrar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script src="~/trumbowyg/dist/trumbowyg.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontsize/trumbowyg.fontsize.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontfamily/trumbowyg.fontfamily.min.js"></script>
<script src="~/trumbowyg/dist/langs/pt_br.js"></script>
<script type="text/javascript">

    $('#textoGarantia').trumbowyg({
        lang: 'pt_br',
        autogrow: true,
        tagsToRemove: ['script', 'link'],
        tagsToKeep: ['i', 'script[src]'],
        btns: [
            ['fontfamily'],
            ['fontsize'],
            ['undo', 'redo'],
            ['bold', 'italic'],
            ['formatting'],
            ['justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'],
            ['unorderedList', 'orderedList'],
            ['horizontalRule'],
        ],
        plugins: {
            fontsize: {
                sizeList: [
                    '10px', '12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '36px'
                ]
            }
        }
    });

    $(function () {
        $("#responsavel").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/usuarios/listarUsuarios",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                $("#responsavel").val(ui.item.nome);
                return false;
            },
            select: function (event, ui) {
                $("#responsavel").val(ui.item.nome);
                $("#responsavel-id").val(ui.item.value);
                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            return $("<li>")
                .append(
                    `<div class="ui-menu-item-wrapper">
                        <span class="autocomplete-title">${item.nome}</span>
                        <span class="autocomplete-details">Celular: ${item.celular}</span>
                    </div>`
                )
                .appendTo(ul);
        };
    });

    $(document).ready(function () {
        $('#formGarantia').validate({
            rules: {
                'TextoGarantia': { required: true },
                'DataGarantia': { required: true },
                'RefGarantia': { required: true }
            },
            messages: {
                'TextoGarantia': { required: 'Campo termo de garantia é obrigatório.' },
                'DataGarantia': { required: 'Campo data é obrigatório.' },
                'RefGarantia': { required: 'Campo ref. garantia é obrigatório.' }
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });
</script>