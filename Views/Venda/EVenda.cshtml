    function atualizarTabelaProdutos() {
        var vendaId = $("input[name='Venda.Id']").val();

        $.ajax({
            type: "GET",
            url: "/vendas/obterItensVenda",
            data: { vendaId: vendaId },
            dataType: "json",
            success: function (response) {
                let tbody = $("#tabela tbody");
                tbody.empty();

                if (response.produtos && Array.isArray(response.produtos)) {
                    response.produtos.forEach(item => {
                        tbody.append(`
                            <tr>
                                <td style="width: 60%" class="text-end">${item.produtoNome}</td>
                                <td style="width: 10%" class="text-center">${item.quantidade}</td>
                                <td style="width: 10%" class="text-center">R$ ${item.preco}</td>
                                <td style="width: 10%" class="text-center">R$ ${item.subTotal}</td>
                                <td style="width: 10%" class="text-center">
                                    <a href="#" data-item-id="${item.id}" data-venda-id="${vendaId}" class="btn-remover btn-nwe4 text-decoration-none">
                                        <i class="bx bx-trash-alt bx-xs"></i>
                                    </a>
                                </td>
                            </tr>
                        `);
                    });
                } else {
                    tbody.append(`
                        <tr>
                            <td colspan="5" class="text-center">Nenhum produto adicionado à venda.</td>
                        </tr>
                    `);
                }

                // Atualiza os totais na tabela
                $("#tabela tfoot").html(`
                    <tr>
                        <td colspan="3" class="text-end"><strong>Total:</strong></td>
                        <td colspan="2" class="text-start">R$ ${response.total || "0,00"}</td>
                    </tr>
                    ${parseFloat(response.desconto.replace('.','').replace(',','.').replace('R$ ','').replace('%','')) > 0 ? `
                    <tr>
                        <td colspan="3" class="text-end"><strong>Desconto:</strong></td>
                        <td colspan="2" class="text-start">${response.desconto}</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end"><strong>Total com desconto:</strong></td>
                        <td colspan="2" class="text-start">R$ ${response.totalDesconto}</td>
                    </tr>` : ""}
                `);

                $("#valor-total-produtos").val(response.total.replace('R$ ', '').replace('.', '').replace(',', '.'));
            },
            error: function () {
                Swal.fire({
                    icon: "error",
                    title: "Erro",
                    text: "Não foi possível atualizar a tabela. Tente novamente."
                });
            }
        });
    }

