    function calcularTotalComDesconto() {
        let valor = parseFloat($('#valor-total-produtos').val()) || 0;
        var tipoDesconto = $('#tipoDesconto').val();
        let desconto = parseFloat($('#desconto').val()) || 0;

        if (valor === 0)
            return false;

        if (tipoDesconto == 'porcento') {
            if (desconto > 100) {
                Swal.fire("Erro!", "Não é possível aplicar desconto maior que 100%.", "error");
                $("#desconto").val('');
                return false;
            }

            valor -= (valor * desconto / 100);
            $("#valorDesconto").val(valor.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        } else {
            if (desconto > valor) {
                Swal.fire("Erro!", "Não é possível aplicar um desconto maior que o valor total da venda.", "error");
                $("#desconto").val('');
                return false;
            }

            valor -= desconto;
            $("#valorDesconto").val(valor.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        }
    }

