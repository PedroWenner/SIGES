@using SIGES.ViewModel
@model VendaViewModel

@{
    ViewData["Titulo"] = "Editar venda";
    decimal valorTotalProdutos = Model.Itens.Sum(i => i.SubTotal) ?? 0;
    decimal desconto = Model.Venda.Desconto ?? 0;
    decimal valorVendaComDesconto = valorTotalProdutos - desconto;
    string disabled = Model.Venda.Faturado == 1 ? "disabled" : "";
    string tooltipDisabled = string.Empty;

    if (!string.IsNullOrEmpty(disabled))
    {
        tooltipDisabled = "data-bs-toggle=\"tooltip\" data-bs-placement=\"top\" data-bs-title=\"Item desabilitado. Venda faturada.\"";
    }

    string def = "";
    if (Model.Venda.Desconto > 0)
    {
        if (Model.Venda.TipoDesconto == "real")
        {
            def = "R$ " + desconto.ToString("n2");
        }
        else
        {
            def = desconto.ToString("n2") + "%";
        }
    }
}

<style>
    #ui-datepicker-div {
        z-index: 100000 !important;
    }

    .custom-counter {
        display: flex;
        align-items: center;
        border: 1px solid #ddd;
        border-radius: 5px;
        background-color: #fff;
        justify-content: space-between;
        transition: border 0.3s ease;
    }

    .custom-counter:focus-within {
        border: 1px solid #aaa;
    }

    .custom-counter input[type="text"] {
        border: none;
        outline: none;
        text-align: center;
        font-size: 14px;
        color: #333;
        background: transparent;
    }

    .custom-counter input::placeholder {
        color: #bbb;
        font-style: italic;
    }

    .counter-buttons {
        display: flex;
        gap: 8px;
        padding-right: 10px;
    }

    .counter-buttons button {
        background: none;
        border: none;
        color: #aaa;
        font-size: 18px;
        cursor: pointer;
        transition: color 0.3s ease;
        padding: 0;
    }

    .counter-buttons button:hover {
        color: #333;
    }

    .counter-buttons button:disabled {
        color: #ddd;
        cursor: default;
    }

    .password-container {
        position: relative;
    }

    .toggle-datetime {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #888;
    }
</style>
<link rel="stylesheet" href="~/trumbowyg/dist/ui/trumbowyg.css">

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-theme-gray text-white d-flex align-items-center">
            <h5 class="mb-0">Editar venda</h5>
        </div>
        <div class="card-body">

            <ul class="nav nav-tabs" id="myTabVendas" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="navLinkDetalheVenda" data-bs-toggle="tab" data-bs-target="#venda-tab-pane" type="button" role="tab" aria-controls="venda-tab-pane" aria-selected="true">Detalhes da venda</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkProdutos" data-bs-toggle="tab" data-bs-target="#produto-tab-pane" type="button" role="tab" aria-controls="produto-tab-pane" aria-selected="false">Produtos</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="venda-tab-pane" role="tabpanel" aria-labelledby="navLinkDetalheVenda" tabindex="0">
                    <form id="formVenda" method="post" asp-controller="Venda" asp-action="Editar">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Venda.Id" />

                        <div class="row mb-3 mt-3">
                            <div class="col-md-4">
                                <h6>Venda: #@Model.Venda.Id.ToString("d4")</h6>
                            </div>
                            @if (Model.Venda.Faturado == 1)
                            {
                                <div class="col-md-8 text-md-end text-danger">
                                    <h2>Venda faturada</h2>
                                </div>
                            }
                        </div>

                        <div class="row mb-3 mt-3">
                            <div class="col-md-2 mt-2">
                                <label for="dataVenda" class="form-label">Data da venda</label>
                                <div class="password-container">
                                    <input id="dataVenda" type="text" asp-for="Venda.DataVenda" class="datetime" value="@DateTime.Now.ToString("dd/MM/yyyy")" required />
                                    <i class="fas fa-calendar-alt toggle-datetime"></i>
                                </div>
                                <span asp-validation-for="Venda.DataVenda" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mt-2">
                                <label for="cliente" class="form-label">Cliente</label>
                                <input id="cliente" type="text" value="@Model.Venda.Cliente.Nome" placeholder="Digite o nome do cliente" required />
                                <input id="cliente-id" type="hidden" asp-for="Venda.ClienteId" />
                                <span asp-validation-for="Venda.ClienteId" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mt-2">
                                <label for="vendedor" class="form-label">Vendedor</label>
                                <input id="vendedor" type="text" value="@Model.Venda.Usuario.Nome" placeholder="Digite o nome do vendedor" required />
                                <input id="vendedor-id" type="hidden" asp-for="Venda.UsuarioId" />
                                <span asp-validation-for="Venda.UsuarioId" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 mt-2">
                                <label for="status" class="form-label">Status</label>
                                <select asp-for="Venda.Status" id="status" required>
                                    <option value="Orçamento">Orçamento</option>
                                    <option value="Aberto">Aberto</option>
                                    <option value="Faturado">Faturado</option>
                                    <option value="Em Andamento">Em Andamento</option>
                                    <option value="Finalizado">Finalizado</option>
                                    <option value="Cancelado">Cancelado</option>
                                    <option value="Aguardando Peças">Aguardando Peças</option>
                                    <option value="Aprovado">Aprovado</option>
                                </select>
                                <span asp-validation-for="Venda.Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 mt-2">
                                <label for="garantia" class="form-label">Garantia (dias)</label>
                                <div class="custom-counter">
                                    <input id="garantia" type="text" asp-for="Venda.GarantiaDias" onkeypress="return somenteNumeros(this)" />
                                    <div class="counter-buttons">
                                        <button id="btn-decrement-garantia" type="button" onclick="decrement('btn-decrement-garantia', 'garantia');">–</button>
                                        <button id="btn-increment-garantia" type="button" onclick="increment('btn-decrement-garantia', 'garantia');">+</button>
                                    </div>
                                </div>
                                
                                <span asp-validation-for="Venda.GarantiaDias" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3 mt-3">
                            <div class="col-md-6 mt-2">
                                <h6>Observações</h6>
                                <textarea asp-for="Venda.Observacao" id="observacao"></textarea>
                            </div>
                            <div class="col-md-6 mt-2">
                                <h6>Observações para o cliente</h6>
                                <textarea asp-for="Venda.ObservacaoCliente" id="observacaoCliente"></textarea>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="row">
                            <div class="d-flex justify-content-center mt-4 flex-wrap gap-2">
                                <a class="button btn btn-warning" asp-controller="Venda" asp-action="Index">
                                    <span class="button__icon"><i class="bx bx-undo bx-xs"></i></span>
                                    <span class="button__text2">Voltar</span>
                                </a>
                                <span @Html.Raw(tooltipDisabled)>
                                    <button type="submit" class="button btn btn-mini btn-success" @disabled>
                                        <span class="button__icon"><i class='bx bx-sync bx-xs'></i></span>
                                        <span class="button__text2">Atualizar</span>
                                    </button>
                                </span>
                                <a class="button btn btn-primary" asp-controller="Venda" asp-action="Visualizar" asp-route-id="@Model.Venda.Id">
                                    <span class="button__icon"><i class='bx bx-show bx-xs'></i></span>
                                    <span class="button__text2">Visualizar</span>
                                </a>
                                @if ((Model.Venda.Faturado ?? 0) == 0)
                                {
                                    <a href="#modal-faturar" role="button" class="button btn btn-mini btn-danger" data-bs-target="#modal-faturar" data-bs-toggle="modal">
                                        <span class="button__icon"><i class='bx bx-dollar bx-xs'></i></span>
                                        <span class="button__text2">Faturar</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade show" id="produto-tab-pane" role="tabpanel" aria-labelledby="navLinkProdutos" tabindex="1">
                    <div class="container-fluid mt-3">
                        <div class="text-secondary-emphasis bg-light-subtle border border-secondary-subtle rounded-3 p-3">
                            <div class="row">
                                @if (Model.Venda.Faturado == 1)
                                {
                                    <div class="col-md-12 text-md-end text-danger">
                                        <h2>Venda faturada</h2>
                                    </div>
                                }
                                <div class="col-md-12">
                                
                                    <form id="formProdutos" method="post" asp-controller="Venda" asp-action="AdicionarProduto">
                                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                        <div class="row">
                                            <div class="col-md-6 mt-2" @Html.Raw(tooltipDisabled)>
                                                <label for="produto" class="form-label">Produto</label>
                                                <input id="produto" type="text" placeholder="Digite o nome do produto" @disabled />
                                                <input id="produto-id" type="hidden" asp-for="Item.ProdutoId" />
                                                <input id="venda-id" type="hidden" asp-for="Item.VendaId" value="@Model.Venda.Id" />
                                                <span asp-validation-for="Item.ProdutoId" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-2 mt-2" @Html.Raw(tooltipDisabled)>
                                                <label for="preco" class="form-label">Preço</label>
                                                <input id="preco" type="text" name="Item.Preco" class="money" readonly @disabled />
                                            </div>
                                            <div class="col-md-2 mt-2">
                                                <label for="quantidade" class="form-label">Quantidade</label>
                                                <div class="custom-counter" @Html.Raw(tooltipDisabled)>
                                                    <input id="quantidade" type="text" name="Item.Quantidade" onkeypress="return somenteNumeros(this)" @disabled />
                                                    <div class="counter-buttons">
                                                        <button id="btn-decrement-quantidade" type="button" onclick="decrement('btn-decrement-quantidade', 'quantidade');" @disabled>–</button>
                                                        <button id="btn-increment-quantidade" type="button" onclick="increment('btn-decrement-quantidade', 'quantidade');" @disabled>+</button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-2 mt-2 align-content-end flex-wrap" @Html.Raw(tooltipDisabled)>
                                                <button type="submit" class="button btn btn-mini btn-success" style="margin-bottom: 0px!important;" @disabled>
                                                    <span class="button__icon"><i class='bx bx-plus'></i></span>
                                                    <span class="button__text2">Adicionar</span>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12">
                                    <form id="formDesconto" method="post" asp-controller="Venda" asp-action="AdicionarDesconto">
                                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                        <input type="hidden" asp-for="Venda.Id" />

                                        <input id="valor-total-produtos" type="hidden" value="@valorTotalProdutos.ToString().Replace(",", ".")" />

                                        <div class="row">
                                            <div class="col-md-2 mt-2" @Html.Raw(tooltipDisabled)>
                                                <label for="desconto" class="form-label">Desconto</label>                                            
                                                <input id="desconto" type="text" name="Venda.Desconto" class="money" required placeholder="0,00"
                                                onchange="calcularTotalComDesconto(); return false;" @disabled />
                                            </div>
                                            <div class="col-md-2 mt-2" @Html.Raw(tooltipDisabled)>
                                                <label for="tipoDesconto" class="form-label">Tipo desc.</label>
                                                <select id="tipoDesconto" name="Venda.TipoDesconto" onchange="calcularTotalComDesconto(); return false;" @disabled>
                                                    <option value="real">R$</option>
                                                    <option value="porcento">%</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3 mt-2" @Html.Raw(tooltipDisabled)>
                                                <label for="valorDesconto" class="form-label">Total com desconto</label>
                                                <input id="valorDesconto" type="text" name="Venda.ValorDesconto" class="money" readonly placeholder="0,00" @disabled />
                                            </div>
                                            <div class="col-md-2 mt-2 align-content-end flex-wrap" @Html.Raw(tooltipDisabled)>
                                                <button type="submit" class="button btn btn-mini btn-success" style="margin-bottom: 0px!important;" @disabled>
                                                    <span class="button__icon"><i class='bx bx-plus'></i></span>
                                                    <span id="btn-adicionar-desconto" class="button__text2">Aplicar</span>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mt-4">
                        <div id="progressBarProdutos" class="progress" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="display: none;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%;"></div>
                        </div>

                        <table id="tabela" class="tblProdutos">
                            <thead class="table-secondary">
                                <tr>
                                    <th style="width: 60%" class="text-end">Produto</th>
                                    <th style="width: 10%" class="text-center">Quantidade</th>
                                    <th style="width: 10%" class="text-center">Preço unitário</th>
                                    <th style="width: 10%" class="text-center">Sub-total</th>
                                    <th style="width: 10%" class="text-center">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Itens.Any())
                                {
                                    foreach (var item in Model.Itens)
                                    {
                                        <tr>
                                            <td style="width: 60%" class="text-end">@item.Produto.Descricao</td>
                                            <td style="width: 10%" class="text-center">@item.Quantidade</td>
                                            <td style="width: 10%" class="text-center">R$ @item.Preco.ToString("N2")</td>
                                            <td style="width: 10%" class="text-center">
                                                R$ @((item.SubTotal)?.ToString("N2"))
                                            </td>
                                            <td style="width: 10%" class="text-center">
                                                @if (string.IsNullOrEmpty(disabled))
                                                {
                                                    <a role="button" data-item-id="@item.Id" data-venda-id="@Model.Venda.Id" class="btn-remover btn-nwe4 text-decoration-none">
                                                        <i class="bx bx-trash-alt"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">Nenhum produto adicionado à venda.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td colspan="2" class="text-start">
                                        R$ @(Model.Itens.Sum(i => i.SubTotal)?.ToString("N2"))
                                    </td>
                                </tr>
                                @if (Model.Venda.Desconto != null && Model.Venda.Desconto > 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-end"><strong>Desconto:</strong></td>
                                        <td colspan="2" class="text-start">
                                            @def
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end"><strong>Total com desconto:</strong></td>
                                        <td colspan="2" class="text-start">
                                            R$ @valorVendaComDesconto.ToString("n2")
                                        </td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Faturar-->
<div id="modal-faturar" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formFaturar" method="post">
                <input type="hidden" name="ClienteId" value="@Model.Venda.ClienteId">
                <input type="hidden" name="VendaId" value="@Model.Venda.Id">
                <input type="hidden" name="Grupo" value="venda">

                <div class="modal-header">
                    <h5 class="modal-title fs-5">Faturar venda Nº: #@Model.Venda.Id.ToString("d4")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-md-12 alert alert-info mt-2"> Obrigatório o preenchimento dos campos com asterisco.</div>
                    <div class="col-md-12 mt-2">
                        <label for="descricao">Descrição</label>
                        <input class="col-md-12" id="descricao" type="text" name="Descricao" value="Fatura de Venda Nº: #@Model.Venda.Id.ToString("d4")" required />
                    </div>
                    <div class="col-md-12 mt-2">
                        <div class="col-md-12 mt-2">
                            <label for="cliente">Cliente</label>
                            <input id="cliente" type="text" name="cliente" value="@Model.Venda.Cliente.Nome" required readonly />
                        </div>
                    </div>
                    <div class="col-md-12 mt-2">
                        <div class="col-md-5 mt-2" style="margin-left: 0;">
                            <label for="valor">Valor</label>
                            <input type="hidden" id="Tipo" name="Tipo" value="receita" />
                            <input class="money" id="valor" type="text" name="ValorTotal" value="@valorTotalProdutos" required readonly />
                        </div>
                        <div class="col-md-5 mt-2" style="margin-left: 2px;">
                            <label for="faturar-desconto">Valor com desconto</label>
                            <input class="money" id="faturar-desconto" type="text" name="ValorDesconto" value="@valorVendaComDesconto" required readonly />
                        </div>
                    </div>
                    <div class="col-md-12 mt-2">
                        <div class="col-md-4 mt-2">
                            <label for="dataVencimento">Data entrada</label>
                            <input class="col-md-12 datetime" id="dataVencimento" type="text" name="DataVencimento" required />
                        </div>
                    </div>
                    <div class="col-md-12 mt-2">
                        <div class="col-md-4 mt-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="recebido" name="Recebido">
                                <label class="form-check-label" for="recebido">Recebido</label>
                            </div>
                        </div>
                        <div id="divRecebimento" class="col-md-12" style=" display: none">
                            <div class="col-md-6 mt-2">
                                <label for="recebimento">Data Recebimento</label>
                                <input class="datetime" id="recebimento" type="text" name="DataRecebimento" />
                            </div>
                            <div class="col-md-6 mt-2">
                                <label for="formaPgto">Forma Pgto</label>
                                <select name="FormaPgto" id="formaPgto">
                                    <option value="Dinheiro">Dinheiro</option>
                                    <option value="Cartão de Crédito">Cartão de Crédito</option>
                                    <option value="Débito">Débito</option>
                                    <option value="Boleto">Boleto</option>
                                    <option value="Depósito">Depósito</option>
                                    <option value="Pix">Pix</option>
                                    <option value="Cheque">Cheque</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="d-flex justify-content-center mt-4">
                        <button class="button btn btn-warning" data-bs-dismiss="modal" id="btn-cancelar-faturar">
                            <span class="button__icon"><i class="bx bx-x"></i></span><span class="button__text2">Cancelar</span>
                        </button>
                        <button id="btn-faturar" class="button btn btn-danger"><span class="button__icon"><i class='bx bx-dollar'></i></span> <span class="button__text2">Faturar</span></button>
                    </div>
                </div>
                <!-- Spinner de carregamento -->
                <div id="loading-spinner" style="display: none; text-align: center; padding: 20px;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p>Faturando venda, aguarde...</p>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script src="~/trumbowyg/dist/trumbowyg.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontsize/trumbowyg.fontsize.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontfamily/trumbowyg.fontfamily.min.js"></script>
<script src="~/trumbowyg/dist/langs/pt_br.js"></script>
<script>
    $('#observacao').trumbowyg({
        lang: 'pt_br',
        autogrow: true,
        tagsToRemove: ['script', 'link'],
        tagsToKeep: ['i', 'script[src]'],
        btns: [
            ['fontfamily'],
            ['fontsize'],
            ['undo', 'redo'],
            ['bold', 'italic'],
            ['formatting'],
            ['justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'],
            ['unorderedList', 'orderedList'],
            ['horizontalRule'],
        ],
        plugins: {
            fontsize: {
                sizeList: [
                    '10px', '12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '36px'
                ]
            }
        }
    });
    
    $('#observacaoCliente').trumbowyg({
        lang: 'pt_br',
        autogrow: true,
        tagsToRemove: ['script', 'link'],
        tagsToKeep: ['i', 'script[src]'],
        btns: [
            ['fontfamily'],
            ['fontsize'],
            ['undo', 'redo'],
            ['bold', 'italic'],
            ['formatting'],
            ['justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'],
            ['unorderedList', 'orderedList'],
            ['horizontalRule'],
        ],
        plugins: {
            fontsize: {
                sizeList: [
                    '10px', '12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '36px'
                ]
            }
        }
    });
    
    $(function () {
        $("#cliente").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/clientes/ListarClientes",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        if (data.length === 0) {
                            response([{
                                nome: "Adicionar cliente",
                                value: "add",
                                adicionar: true
                            }]);
                        } else {
                            response(data);
                        }
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                if (!ui.item.adicionar) {
                    $("#cliente").val(ui.item.nome);
                }

                return false;
            },
            select: function (event, ui) {
                if (ui.item.adicionar) {
                    window.location.href = "/clientes/adicionar";
                } else {
                    $("#cliente").val(ui.item.nome);
                    $("#cliente-id").val(ui.item.value);
                }

                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            if (item.adicionar) {
