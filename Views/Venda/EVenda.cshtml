    $(document).ready(function () {
        $('#formFaturar').validate({
            rules: {
                'Descricao': { required: true },
                'ClienteId': { required: true },
                'ValorTotal': { required: true },
                'DataVencimento': { required: true },
            },
            messages: {
                'Descricao': { required: 'Campo Requerido.' },
                'ClienteId': { required: 'Campo Requerido.' },
                'ValorTotal': { required: 'Campo Requerido.' },
                'DataVencimento': { required: 'Campo Requerido.' },
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            },
            submitHandler: function(form) {
                var dados = $(form).serializeArray();
                var jsonData = {};

                $.each(dados, function (index, field) {
                    if (field.name === 'DataVencimento' || field.name === 'DataRecebimento') {
                        jsonData[field.name] = formatarDataParaAPI(field.value);
                    } else if (field.name === 'ValorTotal' || field.name === 'ValorDesconto') {
                        jsonData[field.name] = formatarDecimalParaAPI(field.value);
                    } else {
                        jsonData[field.name] = field.value;
                    }
                });
                
                $('#loading-spinner').show();
                $('#btn-faturar').prop('disabled', true);

                console.log(jsonData);

                //$('#btn-cancelar-faturar').trigger('click');

                $.ajax({
                    type: "POST",
                    url: "/api/v1/faturar",
                    contentType: "application/json",
                    data: JSON.stringify(jsonData),
                    dataType: 'json',
                    success: function (response) {
                        if (response.acao === "success") {
                            setTimeout(function () {
                                $('#loading-spinner').hide();
                                $('#btn-faturar').prop('disabled', false);
                                $('#modal-faturar').hide();

                                Swal.fire({
                                    title: response.status,
                                    text: response.message,
                                    icon: response.acao,
                                    confirmButtonText: 'OK',
                                    didOpen: () => {
                                        document.querySelector('#sidebar').style.position = 'static';
                                    },
                                    didClose: () => {
                                        document.querySelector('#sidebar').style.position = 'fixed';
                                    }
                                }).then(() => {
                                    location.reload();
                                });
                            }, 1500);
                        } else {
                            $('#loading-spinner').hide();
                            $('#btn-faturar').prop('disabled', false);
                            $('#modal-faturar').hide();

                            Swal.fire(response.status, response.message, response.acao).then(() => {
                                location.reload();
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Erro na requisição:", xhr.responseText); // Log do erro
                        Swal.fire({
                            icon: "error",
                            title: "Erro",
                            text: "Erro ao enviar os dados: " + xhr.responseText
                        });
                    }
                });

                return false;                
            }
        });
    });

    function formatarDecimalParaAPI(valor) {
        return valor.replace(/\./g, '').replace(',', '.');
    }

    function formatarDataParaAPI(data) {
        if (data === '')
            return null;

        var partes = data.split('/');
        var dia = partes[0];
        var mes = partes[1];
        var ano = partes[2];

        return `${ano}-${mes}-${dia}`;
    }
</script>

<script>
    function increment(btnDecrement, id) {
        const input = document.getElementById(id);
        const decrement = document.getElementById(btnDecrement);
        input.value = parseInt(input.value || 0) + 1;
        updateButtons(decrement, input);
    }

    function decrement(btnDecrement, id) {
        const input = document.getElementById(id);
        const decrement = document.getElementById(btnDecrement);
        input.value = parseInt(input.value || 0) - 1;
        updateButtons(decrement, input);
    }

    function updateButtons(btnDecrement, id) {
        btnDecrement.disabled = id.value <= 0;
    }
</script>

