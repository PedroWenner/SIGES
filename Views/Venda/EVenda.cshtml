@using SIGES.ViewModel
@model VendaViewModel

@{
    ViewData["Titulo"] = "Editar venda";
}

<link rel="stylesheet" href="~/trumbowyg/dist/ui/trumbowyg.css">

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Editar venda</h5>
        </div>
        <div class="card-body">

            <ul class="nav nav-tabs" id="myTabVendas" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="navLinkDetalheVenda" data-bs-toggle="tab" data-bs-target="#venda-tab-pane" type="button" role="tab" aria-controls="venda-tab-pane" aria-selected="true">Detalhes da venda</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkProdutos" data-bs-toggle="tab" data-bs-target="#produto-tab-pane" type="button" role="tab" aria-controls="produto-tab-pane" aria-selected="false">Produtos</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="venda-tab-pane" role="tabpanel" aria-labelledby="navLinkDetalheVenda" tabindex="0">
                    <form id="formVenda" method="post" asp-controller="Venda" asp-action="Editar">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Venda.Id" />

                        <div class="row mb-3 mt-3">
                            <div class="col-4">
                                <h6>Venda: <span>@ViewData["VendaId"]</span></h6>
                            </div>
                        </div>


                        <div class="row mb-3 mt-3">
                            <div class="col-2">
                                <label for="dataVenda" class="form-label">Data da venda</label>
                                <input id="dataVenda" type="text" asp-for="Venda.DataVenda" class="datetime" value="@DateTime.Now.ToString("dd/MM/yyyy")" required />
                                <span asp-validation-for="Venda.DataVenda" class="text-danger"></span>
                            </div>
                            <div class="col-3">
                                <label for="cliente" class="form-label">Cliente</label>
                                <input id="cliente" type="text" value="@ViewData["ClienteNome"]" placeholder="Digite o nome do cliente" required />
                                <input id="cliente-id" type="hidden" asp-for="Venda.ClienteId" />
                                <span asp-validation-for="Venda.ClienteId" class="text-danger"></span>
                            </div>
                            <div class="col-3">
                                <label for="vendedor" class="form-label">Vendedor</label>
                                <input id="vendedor" type="text" value="@ViewData["VendedorNome"]" placeholder="Digite o nome do vendedor" required />
                                <input id="vendedor-id" type="hidden" asp-for="Venda.UsuarioId" />
                                <span asp-validation-for="Venda.UsuarioId" class="text-danger"></span>
                            </div>
                            <div class="col-2">
                                <label for="status" class="form-label">Status</label>
                                <select asp-for="Venda.Status" id="status" required>
                                    <option value="Orçamento">Orçamento</option>
                                    <option value="Aberto">Aberto</option>
                                    <option value="Faturado">Faturado</option>
                                    <option value="Em Andamento">Em Andamento</option>
                                    <option value="Finalizado">Finalizado</option>
                                    <option value="Cancelado">Cancelado</option>
                                    <option value="Aguardando Peças">Aguardando Peças</option>
                                    <option value="Aprovado">Aprovado</option>
                                </select>
                                <span asp-validation-for="Venda.Status" class="text-danger"></span>
                            </div>
                            <div class="col-2">
                                <label for="garantia" class="form-label">Garantia (dias)</label>
                                <input id="garantia" type="text" asp-for="Venda.GarantiaDias" onkeypress="return somenteNumeros(this)" />
                                <span asp-validation-for="Venda.GarantiaDias" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3 mt-3">
                            <div class="col-6">
                                <h6>Observações</h6>
                                <textarea asp-for="Venda.Observacao" id="observacao"></textarea>
                            </div>
                            <div class="col-6">
                                <h6>Observações para o cliente</h6>
                                <textarea asp-for="Venda.ObservacaoCliente" id="observacaoCliente"></textarea>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex justify-content-center">
                            <a title="Voltar" class="button btn btn-warning" asp-controller="Venda" asp-action="Index">
                                <span class="button__icon"><i class="bx bx-undo bx-xs"></i></span>
                                <span class="button__text2">Voltar</span>
                            </a>
                            <button type="submit" class="button btn btn-mini btn-success">
                                <span class="button__icon"><i class='bx bx-sync bx-xs'></i></span>
                                <span class="button__text2">Atualizar</span>
                            </button>
                            <a title="Visualizar" class="button btn btn-primary" asp-controller="Venda" asp-action="Visualizar" asp-route-id="@ViewData["VendaId"]">
                                <span class="button__icon"><i class='bx bx-show bx-xs'></i></span>
                                <span class="button__text2">Visualizar</span>
                            </a>
                            @if (Model.Venda.Faturado == 0)
                            {
                                <a href="#modal-faturar" role="button" class="button btn btn-mini btn-danger" data-bs-target="#modal-faturar" data-bs-toggle="modal">
                                    <span class="button__icon"><i class='bx bx-dollar bx-xs'></i></span>
                                    <span class="button__text2">Faturar</span>
                                </a>
                            }
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="produto-tab-pane" role="tabpanel" aria-labelledby="navLinkProdutos" tabindex="0">
                    <div class="col-lg-12 mt-3 p-3 text-secondary-emphasis bg-light-subtle border border-secondary-subtle rounded-3">
                        <div class="row">
                            <div class="col-md-12">
                                <form id="formProdutos" method="post" asp-controller="Venda" asp-action="AdicionarProduto">
                                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                    <div class="row mb-3 mt-3">
                                        <div class="col-5">
                                            <label for="produto" class="form-label">Produto</label>
                                            <input id="produto" type="text" placeholder="Digite o nome do produto" />
                                            <input id="produto-id" type="hidden" asp-for="Item.ProdutoId" />
                                            <input id="venda-id" type="hidden" asp-for="Item.VendaId" value="@ViewData["VendaId"]" />
                                            <span asp-validation-for="Item.ProdutoId" class="text-danger"></span>
                                        </div>
                                        <div class="col-2">
                                            <label for="preco" class="form-label">Preço</label>
                                            <input id="preco" type="text" asp-for="Item.Preco" class="money" />
                                        </div>
                                        <div class="col-2">
                                            <label for="quantidade" class="form-label">Quantidade</label>
                                            <input id="quantidade" type="text" asp-for="Item.Quantidade" onkeypress="return somenteNumeros(this)" />
                                        </div>
                                        <div class="col-2 align-content-end flex-wrap">
                                            <button type="submit" class="button btn btn-mini btn-success" style="margin-bottom: 0px!important;">
                                                <span class="button__icon"><i class='bx bx-plus'></i></span>
                                                <span class="button__text2">Adicionar</span>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <form id="formDesconto" method="post" asp-controller="Venda" asp-action="AdicionarDesconto">
                                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                    <input type="hidden" asp-for="Venda.Id" />

                                    <div class="row">
                                        <div class="col-2">
                                            <label for="desconto" class="form-label">Desconto</label>                                            
                                            <input id="desconto" type="text" asp-for="Venda.Desconto" class="money" required placeholder="0,00"
                                            onchange="calcularTotalComDesconto('@Model.Itens.Sum(i => i.Preco * i.Quantidade)'); return false;" />
                                        </div>
                                        <div class="col-1">
                                            <label for="tipoDesconto" class="form-label">Tipo desc.</label>
                                            <select id="tipoDesconto" asp-for="Venda.TipoDesconto" onchange="calcularTotalComDesconto('@Model.Itens.Sum(i => i.Preco * i.Quantidade)'); return false;">
                                                <option value="real">R$</option>
                                                <option value="porcento">%</option>
                                            </select>
                                            <span asp-validation-for="Venda.TipoDesconto" class="text-danger"></span>
                                        </div>
                                        <div class="col-3">
                                            <label for="valorDesconto" class="form-label">Total com desconto</label>
                                            <input id="valorDesconto" type="text" asp-for="Venda.ValorDesconto" class="money" readonly placeholder="0,00" />
                                        </div>
                                        <div class="col-2 align-content-end flex-wrap">
                                            <button type="submit" class="button btn btn-mini btn-success" style="margin-bottom: 0px!important;">
                                                <span class="button__icon"><i class='bx bx-plus'></i></span>
                                                <span id="btn-adicionar-desconto" class="button__text2">Aplicar</span>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mt-4">
                        <div id="progressBarProdutos" class="progress" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="display: none;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%;"></div>
                        </div>

                        <table id="tabela" class="tblProdutos">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Quantidade</th>
                                    <th>Preço Unitário</th>
                                    <th>Sub-total</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Itens.Any())
                                {
                                    foreach (var item in Model.Itens)
                                    {
                                        <tr>
                                            <td>@item.Produto.Descricao</td>
                                            <td>@item.Quantidade</td>
                                            <td>R$ @item.Preco</td>
                                            <td>
                                                R$ @(item.Preco * item.Quantidade)
                                            </td>
                                            <td>
                                                <a role="button" data-item-id="@item.Id" data-venda-id="@Model.Venda.Id" class="btn-remover btn-nwe4 text-decoration-none">
                                                    <i class="bx bx-trash-alt bx-xs"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">Nenhum produto adicionado à venda.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td colspan="2" class="text-start">
                                        R$ @Model.Itens.Sum(i => i.Preco * i.Quantidade)
                                    </td>
                                </tr>
                                @if (Model.Venda.Desconto != null || Model.Venda.Desconto > 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-end"><strong>Desconto:</strong></td>
                                        <td colspan="2" class="text-start">
                                            @Model.Venda.Desconto @Model.Venda.TipoDesconto
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end"><strong>Total com desconto:</strong></td>
                                        <td colspan="2" class="text-start">
                                            R$ @(Model.Venda.ValorDesconto ?? Model.Itens.Sum(i => i.Preco * i.Quantidade))
                                        </td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Faturar-->
<div id="modal-faturar" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formFaturar" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Faturar venda</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-12 alert alert-info" style="margin-left: 0"> Obrigatório o preenchimento dos campos com asterisco.</div>
                    <div class="col-12" style="margin-left: 0; margin-bottom: 10px;">
                        <label for="descricao">Descrição</label>
                        <input class="col-12" id="descricao" type="text" name="descricao" value="Fatura de Venda Nº: @Model.Venda.Id" required />
                    </div>
                    <div class="col-12" style="margin-left: 0; margin-bottom: 10px;">
                        <div class="col-12" style="margin-left: 0">
                            <label for="cliente">Cliente</label>
                            <input class="col-12" id="cliente" type="text" name="cliente" value="@Model.Venda.Cliente.Nome" required />
                            <input type="hidden" name="clienteId" id="clienteId" value="@Model.Venda.ClienteId">
                            <input type="hidden" name="vendaId" id="vendaId" value="@Model.Venda.Id">
                        </div>
                    </div>
                    <div class="col-12" style="margin-left: 0; margin-bottom: 10px;">
                        <div class="col-5" style="margin-left: 0;">
                            <label for="valor">Valor</label>
                            <input type="hidden" id="tipo" name="tipo" value="receita" />
                            <input class="col-12 money" id="valor" type="text" name="valor" value="@Model.Itens.Sum(x => x.Quantidade * x.Preco)" required />
                        </div>
                        <div class="col-5" style="margin-left: 2px;">
                            <label for="faturar-desconto">Valor Com Desconto</label>
                            <input class="col-12 money" id="faturar-desconto" type="text" name="faturar-desconto" value="@Model.Venda.ValorDesconto" required />
                        </div>
                    </div>
                    <div class="col-12" style="margin-left: 0; margin-bottom: 10px;">
                        <div class="col-4" style="margin-left: 0">
                            <label for="dataVencimento">Data entrada</label>
                            <input class="col-12 datetime" autocomplete="off" id="dataVencimento" type="text" name="dataVencimento" required />
                        </div>
                    </div>
                    <div class="col-12" style="margin-left: 0; margin-bottom: 10px;">
                        <div class="col-4" style="margin-left: 0">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="recebido" name="recebido">
                                <label class="form-check-label" for="recebido">Recebido</label>
                            </div>
                        </div>
                        <div id="divRecebimento" class="span8" style=" display: none">
                            <div class="col-6">
                                <label for="recebimento">Data Recebimento</label>
                                <input class="col-12 datetime" autocomplete="off" id="recebimento" type="text" name="recebimento" />
                            </div>
                            <div class="col-6">
                                <label for="formaPgto">Forma Pgto</label>
                                <select name="formaPgto" id="formaPgto" class="col-12">
                                    <option value="Dinheiro">Dinheiro</option>
                                    <option value="Cartão de Crédito">Cartão de Crédito</option>
                                    <option value="Débito">Débito</option>
                                    <option value="Boleto">Boleto</option>
                                    <option value="Depósito">Depósito</option>
                                    <option value="Pix">Pix</option>
                                    <option value="Cheque">Cheque</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="display:flex">
                    <button class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true" id="btn-cancelar-faturar">
                        <span class="button__icon"><i class="bx bx-x"></i></span><span class="button__text2">Cancelar</span>
                    </button>
                    <button class="button btn btn-danger"><span class="button__icon"><i class='bx bx-dollar'></i></span> <span class="button__text2">Faturar</span></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script src="~/trumbowyg/dist/trumbowyg.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontsize/trumbowyg.fontsize.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontfamily/trumbowyg.fontfamily.min.js"></script>
<script src="~/trumbowyg/dist/langs/pt_br.js"></script>
<script>
    $('#observacao').trumbowyg({
        lang: 'pt_br',
        autogrow: true,
        tagsToRemove: ['script', 'link'],
        tagsToKeep: ['i', 'script[src]'],
        btns: [
            ['fontfamily'],
            ['fontsize'],
            ['undo', 'redo'],
            ['bold', 'italic'],
            ['formatting'],
            ['justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'],
            ['unorderedList', 'orderedList'],
            ['horizontalRule'],
        ],
        plugins: {
            fontsize: {
                sizeList: [
                    '10px', '12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '36px'
                ]
            }
        }
    });
    
    $('#observacaoCliente').trumbowyg({
        lang: 'pt_br',
        autogrow: true,
        tagsToRemove: ['script', 'link'],
        tagsToKeep: ['i', 'script[src]'],
        btns: [
            ['fontfamily'],
            ['fontsize'],
            ['undo', 'redo'],
            ['bold', 'italic'],
            ['formatting'],
            ['justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'],
            ['unorderedList', 'orderedList'],
            ['horizontalRule'],
        ],
        plugins: {
            fontsize: {
                sizeList: [
                    '10px', '12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '36px'
                ]
            }
        }
    });
    
    $(function () {
        $("#cliente").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/clientes/ListarClientes",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        if (data.length === 0) {
                            response([{
                                nome: "Adicionar cliente",
                                value: "add",
                                adicionar: true
                            }]);
                        } else {
                            response(data);
                        }
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                if (!ui.item.adicionar) {
                    $("#cliente").val(ui.item.nome);
                }

                return false;
            },
            select: function (event, ui) {
                if (ui.item.adicionar) {
                    window.location.href = "/clientes/adicionar";
                } else {
                    $("#cliente").val(ui.item.nome);
                    $("#cliente-id").val(ui.item.value);
                }

                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            if (item.adicionar) {
                return $("<li>")
                    .append(
                        `<div class="ui-menu-item-wrapper">
                            <span class="autocomplete-add">➕ ${item.nome}</span>
                        </div>`
                    )
                    .appendTo(ul);
            } else {
                return $("<li>")
                    .append(
                        `<div class="ui-menu-item-wrapper">
                            <span class="autocomplete-title">${item.nome}</span>
                            <span class="autocomplete-details">Celular: ${item.celular} | Documento: ${item.documento}</span>
                        </div>`
                    )
                    .appendTo(ul);
            }
        };
    });

    $(function () {
        $("#vendedor").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/usuarios/listarUsuarios",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                $("#vendedor").val(ui.item.nome);
                return false;
            },
            select: function (event, ui) {
                $("#vendedor").val(ui.item.nome);
                $("#vendedor-id").val(ui.item.value);
                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            return $("<li>")
                .append(
                    `<div class="ui-menu-item-wrapper">
                        <span class="autocomplete-title">${item.nome}</span>
                        <span class="autocomplete-details">Celular: ${item.celular}</span>
                    </div>`
                )
                .appendTo(ul);
        };
    });

    $(document).ready(function () {
        $(".money").mask("#.##0,00", {reverse: true});
        $('#formVenda').validate({
            rules: {
                'DataVenda': { required: true },
            },
            messages: {
                'DataVenda': { required: 'Campo requerido.' },
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });

    $(function () {
        $("#produto").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/produtos/listarProdutos",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                $("#produto").val(ui.item.nome + " | Preço: R$ " + ui.item.preco + " | Estoque: " + ui.item.estoque);
                return false;
            },
            select: function (event, ui) {
                $("#produto").val(ui.item.nome + " | Preço: R$ " + ui.item.preco + " | Estoque: " + ui.item.estoque);
                $("#produto-id").val(ui.item.value);
                
                let precoFormatado = parseFloat(ui.item.preco).toLocaleString('pt-BR', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
                $("#preco").val(precoFormatado);

                $("#quantidade").data("estoque", ui.item.estoque);
                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            return $("<li>")
                .append(
                    `<div class="ui-menu-item-wrapper">
                        <span class="autocomplete-title">${item.nome}</span>
                        <span class="autocomplete-details">Preço: R$ ${item.preco.toLocaleString('pt-BR', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        })} | Estoque: ${item.estoque}</span>
                    </div>`
                )
                .appendTo(ul);
        };
    });

    $(document).ready(function () {
        $("#formProdutos").validate({
            rules: {
                "Item.ProdutoId": { required: true },
                "Item.Preco": { required: true },
                "Item.Quantidade": {
                    required: true,
                    digits: true
                    // , max: function () {
                    //     var estoque = $("#quantidade").data("estoque");
                    //     return estoque || 0;
                    // }
                }
            },
            messages: {
                "Item.ProdutoId": { required: "Selecione um produto." },
                "Item.Preco": {
                    required: "Informe o preço."
                },
                "Item.Quantidade": {
                    required: "Informe a quantidade.",
                    digits: "Informe apenas números inteiros."
                    //, max: "A quantidade não pode ser maior que o estoque disponível."
                }
            },
            submitHandler: function (form) {
                var quantidade = parseInt($("#quantidade").val());
                var estoque = parseInt($("#quantidade").data("estoque"));

                if (estoque < quantidade) {
                    Swal.fire({
                        icon: "warning",
                        title: "Atenção",
                        text: "Você não possui estoque suficiente."
                    });
                } else {
                    var dados = $(form).serialize();
                    // Mostra a barra de progresso
                    $("#progressBarProdutos").show();

                    $.ajax({
                        type: "POST",
                        url: form.action,
                        data: dados,
                        dataType: "json",
                        success: function (response) {
                            if (response.result) {
                                let tbody = $("#tabela tbody");
                                tbody.empty();

                                if (response.items && Array.isArray(response.items)) {
                                    response.items.forEach(item => {
                                        tbody.append(`
                                            <tr>
                                                <td>${item.produtoNome}</td>
                                                <td>${item.quantidade}</td>
                                                <td>${item.preco}</td>
                                                <td>${item.subTotal}</td>
                                                <td>
                                                    <a href="#" data-item-id="${item.id}" data-venda-id="${@Model.Venda.Id}" class="btn-remover btn-nwe4 text-decoration-none">
                                                        <i class="bx bx-trash-alt bx-xs"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        `);
                                    });
                                }

                                $("#tabela tfoot").html(`
                                    <tr>
                                        <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                        <td colspan="2" class="text-start">${response.total || "R$ 0,00"}</td>
                                    </tr>
                                `);

                                Swal.fire({
                                    icon: "success",
                                    title: "Sucesso",
                                    text: "Produto adicionado com sucesso!"
                                });

                                $("#quantidade").val("");
                                $("#preco").val("");
                                $("#produto").val("").focus();
                            } else {
                                Swal.fire({
                                    icon: "error",
                                    title: "Erro",
                                    text: response.messages
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: "error",
                                title: "Erro",
                                text: "Não foi possível adicionar o produto. Tente novamente."
                            });
                        },
                        complete: function () {
                            $("#progressBarProdutos").hide();
                        }
                    });

                    return false;
                }
            }
        });
    });

