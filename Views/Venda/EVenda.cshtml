@using SIGES.ViewModel
@model VendaViewModel

@{
    ViewData["Titulo"] = "Editar venda";
}

<style>
    .ck-editor__editable {
        min-height: 300px;
        border: 1px solid #ccc;
        padding: 10px;
        width: 100%;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Editar venda</h5>
        </div>
        <div class="card-body">

            <ul class="nav nav-tabs" id="myTabVendas" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="navLinkDetalheVenda" data-bs-toggle="tab" data-bs-target="#venda-tab-pane" type="button" role="tab" aria-controls="venda-tab-pane" aria-selected="true">Detalhes da venda</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkProdutos" data-bs-toggle="tab" data-bs-target="#produto-tab-pane" type="button" role="tab" aria-controls="produto-tab-pane" aria-selected="false">Produtos</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="venda-tab-pane" role="tabpanel" aria-labelledby="navLinkDetalheVenda" tabindex="0">
                    <form id="formVenda" method="post" asp-controller="Venda" asp-action="Editar">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Venda.Id" />

                        <div class="row mb-3 mt-3">
                            <div class="col-4">
                                <h6>Venda: <span>@ViewData["VendaId"]</span></h6>
                            </div>
                        </div>
                        

                        <div class="row mb-3 mt-3">
                            <div class="col-2">
                                <label for="dataVenda" class="form-label">Data da venda</label>
                                <input id="dataVenda" type="text" asp-for="Venda.DataVenda" class="datetime" value="@DateTime.Now.ToString("dd/MM/yyyy")" required />
                                <span asp-validation-for="Venda.DataVenda" class="text-danger"></span>
                            </div>
                            <div class="col-3">
                                <label for="cliente" class="form-label">Cliente</label>
                                <input id="cliente" type="text" value="@ViewData["ClienteNome"]" placeholder="Digite o nome do cliente" required />
                                <input id="cliente-id" type="hidden" asp-for="Venda.ClienteId" />
                                <span asp-validation-for="Venda.ClienteId" class="text-danger"></span>
                            </div>
                            <div class="col-3">
                                <label for="vendedor" class="form-label">Vendedor</label>
                                <input id="vendedor" type="text" value="@ViewData["VendedorNome"]" placeholder="Digite o nome do vendedor" required />
                                <input id="vendedor-id" type="hidden" asp-for="Venda.UsuarioId" />
                                <span asp-validation-for="Venda.UsuarioId" class="text-danger"></span>
                            </div>
                            <div class="col-2">
                                <label for="status" class="form-label">Status</label>
                                <select asp-for="Venda.Status" id="status" required>
                                    <option value="Orçamento">Orçamento</option>
                                    <option value="Aberto">Aberto</option>
                                    <option value="Faturado">Faturado</option>
                                    <option value="Em Andamento">Em Andamento</option>
                                    <option value="Finalizado">Finalizado</option>
                                    <option value="Cancelado">Cancelado</option>
                                    <option value="Aguardando Peças">Aguardando Peças</option>
                                    <option value="Aprovado">Aprovado</option>
                                </select>
                                <span asp-validation-for="Venda.Status" class="text-danger"></span>
                            </div>
                            <div class="col-2">
                                <label for="garantia" class="form-label">Garantia (dias)</label>
                                <input id="garantia" type="text" asp-for="Venda.GarantiaDias" onkeypress="return somenteNumeros(this)" />
                                <span asp-validation-for="Venda.GarantiaDias" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3 mt-3">
                            <div class="col-6">
                                <h6>Observações</h6>
                                <textarea asp-for="Venda.Observacao" id="observacao"></textarea>
                            </div>
                            <div class="col-6">
                                <h6>Observações para o cliente</h6>
                                <textarea asp-for="Venda.ObservacaoCliente" id="observacaoCliente"></textarea>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex justify-content-center">
                            <a title="Voltar" class="button btn btn-warning" asp-controller="Venda" asp-action="Index">
                                <span class="button__icon"><i class="bx bx-undo"></i></span>
                                <span class="button__text2">Voltar</span>
                            </a>
                            <button type="submit" class="button btn btn-mini btn-success">
                                <span class="button__icon"><i class='bx bx-sync'></i></span>
                                <span class="button__text2">Atualizar</span>
                            </button>
                            <button type="submit" class="button btn btn-mini btn-primary">
                                <span class="button__icon"><i class='bx bx-show'></i></span>
                                <span class="button__text2">Visualizar</span>
                            </button>
                            <button type="submit" class="button btn btn-mini btn-danger">
                                <span class="button__icon"><i class='bx bx-dollar'></i></span>
                                <span class="button__text2">Faturar</span>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="produto-tab-pane" role="tabpanel" aria-labelledby="navLinkProdutos" tabindex="0">
                    <div class="col-lg-12 mt-3 p-3 text-secondary-emphasis bg-light-subtle border border-secondary-subtle rounded-3">
                        <form id="formProdutos" method="post" asp-controller="Venda" asp-action="AdicionarProduto">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="row mb-3 mt-3">
                                <div class="col-5">
                                    <label for="produto" class="form-label">Produto</label>
                                    <input id="produto" type="text" placeholder="Digite o nome do produto" />
                                    <input id="produto-id" type="hidden" asp-for="Item.ProdutoId" />
                                    <input id="venda-id" type="hidden" asp-for="Item.VendaId" value="@ViewData["VendaId"]" />
                                    <span asp-validation-for="Item.ProdutoId" class="text-danger"></span>
                                </div>
                                <div class="col-2">
                                    <label for="preco" class="form-label">Preço</label>
                                    <input id="preco" type="text" asp-for="Item.Preco" class="money" />
                                </div>
                                <div class="col-2">
                                    <label for="quantidade" class="form-label">Quantidade</label>
                                    <input id="quantidade" type="text" asp-for="Item.Quantidade" onkeypress="return somenteNumeros(this)" />
                                </div>
                                <div class="col-2 align-content-end flex-wrap">
                                    <button type="submit" class="button btn btn-mini btn-success" style="margin-bottom: 0px!important;">
                                        <span class="button__icon"><i class='bx bx-plus'></i></span>
                                        <span class="button__text2">Adicionar</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive mt-4">
                        <div id="progressBarProdutos" class="progress" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="display: none;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%;"></div>
                        </div>

                        <table id="tabela">
                            <thead>
                                <tr>
                                    <th style="width: 70%; text-align: left;">Produto</th>
                                    <th style="width: 5%; text-align: left;">Quantidade</th>
                                    <th style="width: 10%; text-align: left;">Preço Unitário</th>
                                    <th style="width: 10%; text-align: left;">Subtotal</th>
                                    <th style="width: 5%; text-align: left;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Itens.Any())
                                {
                                    foreach (var item in Model.Itens)
                                    {
                                        <tr>
                                            <td style="text-align: left;">@item.Produto.Descricao</td>
                                            <td style="text-align: left;">@item.Quantidade</td>
                                            <td style="text-align: left;">R$ @item.Preco</td>
                                            <td style="text-align: left;">
                                                R$ @(item.Preco * item.Quantidade)
                                            </td>
                                            <td style="text-align: left;">
                                                <a role="button" data-item-id="@item.Id" data-venda-id="@Model.Venda.Id" class="btn-remover btn-nwe4 text-decoration-none">
                                                    <i class="bx bx-trash-alt bx-xs"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">Nenhum produto adicionado à venda.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td colspan="2" class="text-start">
                                        R$ @Model.Itens.Sum(i => i.Preco * i.Quantidade)
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script src="~/js/ckeditor.js"></script>
<script>
    ClassicEditor
        .create(document.querySelector('#observacao'), {
            language: 'pt-br',
            toolbar: [
                'undo', 'redo', '|',
                'heading', '|',
                'bold', 'italic', '|', 'bulletedList', 'numberedList', 'blockQuote', '|',
            ]
        });

    ClassicEditor
        .create(document.querySelector('#observacaoCliente'), {
            language: 'pt-br',
            toolbar: [
                'undo', 'redo', '|',
                'heading', '|',
                'bold', 'italic', '|', 'bulletedList', 'numberedList', 'blockQuote', '|',
            ]
        });

    $(function () {
        $("#cliente").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/clientes/ListarClientes",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        if (data.length === 0) {
                            response([{
                                nome: "Adicionar cliente",
                                value: "add",
                                adicionar: true
                            }]);
                        } else {
                            response(data);
                        }
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                if (!ui.item.adicionar) {
                    $("#cliente").val(ui.item.nome);
                }

                return false;
            },
            select: function (event, ui) {
                if (ui.item.adicionar) {
                    window.location.href = "/clientes/adicionar";
                } else {
                    $("#cliente").val(ui.item.nome);
                    $("#cliente-id").val(ui.item.value);
                }

                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            if (item.adicionar) {
                return $("<li>")
                    .append(
                        `<div class="ui-menu-item-wrapper">
                            <span class="autocomplete-add">➕ ${item.nome}</span>
                        </div>`
                    )
                    .appendTo(ul);
            } else {
                return $("<li>")
                    .append(
                        `<div class="ui-menu-item-wrapper">
                            <span class="autocomplete-title">${item.nome}</span>
                            <span class="autocomplete-details">Celular: ${item.celular} | Documento: ${item.documento}</span>
                        </div>`
                    )
                    .appendTo(ul);
            }
        };
    });

    $(function () {
        $("#vendedor").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/usuarios/listarUsuarios",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                $("#vendedor").val(ui.item.nome);
                return false;
            },
            select: function (event, ui) {
                $("#vendedor").val(ui.item.nome);
                $("#vendedor-id").val(ui.item.value);
                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            return $("<li>")
                .append(
                    `<div class="ui-menu-item-wrapper">
                        <span class="autocomplete-title">${item.nome}</span>
                        <span class="autocomplete-details">Celular: ${item.celular}</span>
                    </div>`
                )
                .appendTo(ul);
        };
    });

    $(document).ready(function () {
        $(".money").mask("#.##0,00", {reverse: true});
        $('#formVenda').validate({
            rules: {
                'DataVenda': { required: true },
            },
            messages: {
                'DataVenda': { required: 'Campo requerido.' },
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });

    $(function () {
        $("#produto").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/produtos/listarProdutos",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                $("#produto").val(ui.item.nome + " | Preço: R$ " + ui.item.preco + " | Estoque: " + ui.item.estoque);
                return false;
            },
            select: function (event, ui) {
                $("#produto").val(ui.item.nome + " | Preço: R$ " + ui.item.preco + " | Estoque: " + ui.item.estoque);
                $("#produto-id").val(ui.item.value);
                
                let precoFormatado = parseFloat(ui.item.preco).toLocaleString('pt-BR', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
                $("#preco").val(precoFormatado);

                $("#quantidade").data("estoque", ui.item.estoque);
                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            return $("<li>")
                .append(
                    `<div class="ui-menu-item-wrapper">
                        <span class="autocomplete-title">${item.nome}</span>
                        <span class="autocomplete-details">Preço: R$ ${item.preco.toLocaleString('pt-BR', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        })} | Estoque: ${item.estoque}</span>
                    </div>`
                )
                .appendTo(ul);
        };
    });

    $(document).ready(function () {
        $("#formProdutos").validate({
            rules: {
                "Item.ProdutoId": { required: true },
                "Item.Preco": { required: true },
                "Item.Quantidade": {
                    required: true,
                    digits: true
                    // , max: function () {
                    //     var estoque = $("#quantidade").data("estoque");
                    //     return estoque || 0;
                    // }
                }
            },
            messages: {
                "Item.ProdutoId": { required: "Selecione um produto." },
                "Item.Preco": {
                    required: "Informe o preço."
                },
                "Item.Quantidade": {
                    required: "Informe a quantidade.",
                    digits: "Informe apenas números inteiros."
                    //, max: "A quantidade não pode ser maior que o estoque disponível."
                }
            },
            submitHandler: function (form) {
                var quantidade = parseInt($("#quantidade").val());
                var estoque = parseInt($("#quantidade").data("estoque"));

                if (estoque < quantidade) {
                    Swal.fire({
                        icon: "warning",
                        title: "Atenção",
                        text: "Você não possui estoque suficiente."
                    });
                } else {
                    var dados = $(form).serialize();
                    // Mostra a barra de progresso
                    $("#progressBarProdutos").show();

                    $.ajax({
                        type: "POST",
                        url: form.action,
                        data: dados,
                        dataType: "json",
                        success: function (response) {
                            if (response.result) {
                                let tbody = $("#tabela tbody");
                                tbody.empty();

                                if (response.items && Array.isArray(response.items)) {
                                    response.items.forEach(item => {
                                        tbody.append(`
                                            <tr>
                                                <td style="text-align: left;">${item.produtoNome}</td>
                                                <td style="text-align: left;">${item.quantidade}</td>
                                                <td style="text-align: left;">${item.preco}</td>
                                                <td style="text-align: left;">${item.subTotal}</td>
                                                <td style="text-align: left;">
                                                    <a href="#" data-item-id="${item.id}" data-venda-id="${@Model.Venda.Id}" class="btn-remover btn-nwe4 text-decoration-none">
                                                        <i class="bx bx-trash-alt bx-xs"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        `);
                                    });
                                }

                                $("#tabela tfoot").html(`
                                    <tr>
                                        <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                        <td colspan="2" class="text-start">${response.total || "R$ 0,00"}</td>
                                    </tr>
                                `);

                                Swal.fire({
                                    icon: "success",
                                    title: "Sucesso",
                                    text: "Produto adicionado com sucesso!"
                                });

                                $("#quantidade").val("");
                                $("#preco").val("");
                                $("#produto").val("").focus();
                            } else {
                                Swal.fire({
                                    icon: "error",
                                    title: "Erro",
                                    text: response.messages
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: "error",
                                title: "Erro",
                                text: "Não foi possível adicionar o produto. Tente novamente."
                            });
                        },
                        complete: function () {
                            $("#progressBarProdutos").hide();
                        }
                    });

                    return false;
                }
            }
            //,
            // errorPlacement: function (error, element) {
            //     error.addClass("text-danger");
            //     error.insertAfter(element);
            // },
            // highlight: function (element) {
            //     $(element).addClass("is-invalid").removeClass("is-valid");
            // },
            // unhighlight: function (element) {
            //     $(element).removeClass("is-invalid").addClass("is-valid");
            // }
        });
    });

    $(document).ready(function () {
        $(document).on("click", ".btn-remover", function (event) {
            event.preventDefault();

            var itemId = $(this).data("item-id");
            var vendaId = $(this).data("venda-id");

            Swal.fire({
                title: "Tem certeza?",
                text: "Você deseja remover este item?",
                icon: "warning",
                showCancelButton: true,
                cancelButtonText: "Cancelar",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Sim, remover!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $("#progressBarProdutos").show();

                    $.ajax({
                        type: "POST",
                        url: "/vendas/removerProduto",
                        data: { itemId: itemId, vendaId: vendaId },
                        dataType: "json",
                        success: function (response) {
                            if (response.result) {
                                let tbody = $("#tabela tbody");
                                tbody.empty();

                                if (response.items && Array.isArray(response.items)) {
                                    response.items.forEach(item => {
                                        tbody.append(`
                                            <tr>
                                                <td>${item.produtoNome}</td>
                                                <td>${item.quantidade}</td>
                                                <td>${item.preco}</td>
                                                <td>${item.subTotal}</td>
                                                <td>
                                                    <a href="#" data-item-id="${item.id}" data-venda-id="${vendaId}" class="btn-remover btn-nwe4 text-decoration-none">
                                                        <i class="bx bx-trash-alt bx-xs"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        `);
                                    });
                                } else {
                                    tbody.append(`
                                        <tr>
                                            <td colspan="5" class="text-center">Nenhum produto adicionado à venda.</td>
                                        </tr>
                                    `);
                                }

                                // Atualizar o total
                                $("#tabela tfoot").html(`
                                    <tr>
                                        <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                        <td colspan="2" class="text-start">${response.total}</td>
                                    </tr>
                                `);

                                Swal.fire("Removido!", "O item foi removido com sucesso.", "success");
                            } else {
                                Swal.fire("Erro!", response.message || "Não foi possível remover o item.", "error");
                            }
                        },
                        error: function () {
                            Swal.fire("Erro!", "Ocorreu um erro ao tentar remover o item.", "error");
                        },
                        complete: function () {
                            $("#progressBarProdutos").hide();
                        }
                    });
                }
            });
        });
    });
</script>
