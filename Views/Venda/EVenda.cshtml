    function calcularTotalComDesconto(input) {
        const tipoDesconto = $("#tipoDesconto").val();
        const valor = parseFloat($("#desconto").val().replace('.', '').replace(',', '.')) || 0;
        let valorComDesconto = parseFloat(input.replace('.', '').replace(',', '.')) || 0;

        if (tipoDesconto === 'real') {
            if (valor > valorComDesconto) {
                Swal.fire("Erro!", "Não é possível aplicar um desconto maior que o valor total da venda.", "error");
                $("#desconto").val('');
                return false;
            }
                
            valorComDesconto -= valor;
        } else {
            if (valor > 100) {
                Swal.fire("Erro!", "Não é possível aplicar desconto maior que 100%.", "error");
                $("#desconto").val('');
                return false;
            }
            
            console.log(valorComDesconto);
            console.log(valor);
            valorComDesconto -= (valorComDesconto * valor) / 100;
        }

        // Formata para exibição no input e mantém o padrão brasileiro (vírgula como separador decimal)
        $("#valorDesconto").val(valorComDesconto.toFixed(2).replace('.', ','));
    }

    $(document).ready(function () {
        $('#formDesconto').validate({
            rules: { 'Venda.Desconto': { required: true } },
            messages: { 'Venda.Desconto': { required: 'Por favor, insira o desconto.' } },
            submitHandler: function(form) {
                var dados = $(form).serialize();
                $('#btn-adicionar-desconto').addClass('disabled').text('Aguarde...');
                $("#valorDesconto").removeClass('readonly');

                $.ajax({
                    type: "POST",
                    url: "/vendas/AdicionarDesconto",
                    data: dados,
                    dataType: 'json',
                    success: function (data) {
                        if (data.sucesso) {
                            Swal.fire({
                                position: 'center',
                                icon: 'success',
                                title: 'Desconto aplicado',
                                text: data.message,
                                showConfirmButton: true,
                                timer: 4000
                            });

                            $("#desconto").val("");
                            $("#valorDesconto").val("");
                            atualizarTabelaProdutos();
                        } else {
                            Swal.fire({
                                position: 'center',
                                icon: 'error',
                                title: 'Erro',
                                text: data.message,
                                showConfirmButton: true,
                                timer: 4000
                            });
                        }

                        $('#btn-adicionar-desconto').removeClass('disabled').text('Adicionar');
                        $("#valorDesconto").addClass('readonly');
                    },
                    error: function () {
                        Swal.fire({
                            position: 'center',
                            icon: 'error',
                            title: 'Erro no servidor!',
                            text: 'Não foi possível aplicar o desconto. Tente novamente.',
                            showConfirmButton: true,
                            timer: 4000
                            
                        });

                        $('#btn-adicionar-desconto').removeClass('disabled').text('Adicionar');
                        $("#valorDesconto").addClass('readonly');
                    }
                });
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });

    function atualizarTabelaProdutos() {
        var vendaId = $("input[name='Venda.Id']").val();

        $.ajax({
            type: "GET",
            url: "/vendas/obterItensVenda",
            data: { vendaId: vendaId },
            dataType: "json",
            success: function (response) {
                let tbody = $("#tabela tbody");
                tbody.empty();

                if (response.items && Array.isArray(response.items)) {
                    response.items.forEach(item => {
                        tbody.append(`
                            <tr>
                                <td>${item.produtoNome}</td>
                                <td>${item.quantidade}</td>
                                <td>${item.preco}</td>
                                <td>${item.subTotal}</td>
                                <td>
                                    <a href="#" data-item-id="${item.id}" data-venda-id="${vendaId}" class="btn-remover btn-nwe4 text-decoration-none">
                                        <i class="bx bx-trash-alt bx-xs"></i>
                                    </a>
                                </td>
                            </tr>
                        `);
                    });
                } else {
                    tbody.append(`
                        <tr>
                            <td colspan="5" class="text-center">Nenhum produto adicionado à venda.</td>
                        </tr>
                    `);
                }

                let valorDesconto = response.descontoValor.replace('.','').replace(',','.');
                // Atualiza os totais na tabela
                $("#tabela tfoot").html(`
                    <tr>
                        <td colspan="3" class="text-end"><strong>Total:</strong></td>
                        <td colspan="2" class="text-start">${response.total || "R$ 0,00"}</td>
                    </tr>
                    ${valorDesconto > 0 ? `
                    <tr>
                        <td colspan="3" class="text-end"><strong>Desconto:</strong></td>
                        <td colspan="2" class="text-start">${response.desconto}</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end"><strong>Total com desconto:</strong></td>
                        <td colspan="2" class="text-start">R$ ${response.totalComDesconto}</td>
                    </tr>` : ""}
                `);
            },
            error: function () {
                Swal.fire({
                    icon: "error",
                    title: "Erro",
                    text: "Não foi possível atualizar a tabela. Tente novamente."
                });
            }
        });
    }

    $('#recebido').click(function(event) {
            var flag = $(this).is(':checked');
            if (flag == true) {
                $('#divRecebimento').show();
            } else {
                $('#divRecebimento').hide();
            }
        });

    $(document).ready(function () {
        $('#formFaturar').validate({
            rules: {
                'descricao': { required: true },
                'clienteId': { required: true },
                'valor': { required: true },
                'dataVencimento': { required: true },
            },
            messages: {
                'descricao': { required: 'Campo Requerido.' },
                'clienteId': { required: 'Campo Requerido.' },
                'valor': { required: 'Campo Requerido.' },
                'dataVencimento': { required: 'Campo Requerido.' },
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            },
            submitHandler: function(form) {
                var dados = $(form).serialize();
                var qtdProdutos = $('.tblProdutos > tbody > tr').length;

                $('#btn-cancelar-faturar').trigger('click');

                if (qtdProdutos <= 0) {
                    Swal.fire({
                        type: "error",
                        title: "Atenção",
                        text: "Não é possível faturar uma venda sem produtos"
                    });
                } else if (qtdProdutos > 0) {
                    $.ajax({
                        type: "POST",
                        url: "/vendas/faturar",
                        data: dados,
                        dataType: 'json',
                        success: function (data) {
                            if (data.result) {
                                Swal.fire({
                                    icon: "success",
                                    title: "Sucesso",
                                    text: data.mensagem
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: "error",
                                    title: "Erro",
                                    text: data.mensagem
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: "error",
                                title: "Erro",
                                text: "Erro inesperado ao tentar faturar a venda."
                            });
                        }
                    });

                    return false;
                }
            }
        });
    });

    $('#faturar-desconto, #valor').on('input', function () {
        let valor = parseFloat($('#valor').val()) || 0;
        let desconto = parseFloat($('#faturar-desconto').val()) || 0;

        if (desconto > valor) {
            Swal.fire("Atenção", "O desconto não pode ser maior que o valor da venda!", "warning");
            $('#faturar-desconto').val(valor);
        }
    });
</script>
