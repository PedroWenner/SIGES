@using SIGES.ViewModel
@model VendaViewModel

@{
    ViewData["Titulo"] = "Editar venda";
    List<string> status = new List<string> { "Finalizado", "Faturado", "Orçamento", "Aberto", "Em Andamento", "Aguardando Peças" };
    decimal valorTotalProdutos = Model.Itens.Sum(i => i.SubTotal) ?? 0;
    decimal desconto = Model.Venda.Desconto ?? 0;
    decimal valorVendaComDesconto = valorTotalProdutos - desconto;
}

<style>
    .ck-editor__editable {
    min-height: 300px;
    border: 1px solid #ccc;
    padding: 10px;
    width: 100%;
    white-space: normal !important;
    overflow-wrap: break-word;
    word-wrap: break-word;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-theme-gray text-white d-flex align-items-center">
            <h5 class="mb-0">Dados da venda nº #@Model.Venda.Id.ToString("d4")</h5>
        </div>
        <div class="card-body">

            <div class="buttons d-flex flex-wrap gap-2">
                <a class="button btn btn-mini btn-success" asp-controller="Venda" asp-action="Editar" asp-route-id="@Model.Venda.Id">
                    <span class="button__icon"><i class="bx bx-edit bx-xs"></i></span>
                    <span class="button__text2">Editar</span>
                </a>
                <div class="button-container">
                    <a class="button btn btn-mini btn-secondary">
                        <span class="button__icon"><i class="bx bx-printer"></i></span>
                        <span class="button__text">Imprimir</span>
                    </a>
                    <div class="cascading-buttons">
                        <a class="button btn btn-mini btn-secondary" asp-controller="Venda" asp-action="Imprimir" asp-route-id="@Model.Venda.Id" asp-route-tipo="a4" target="_blank">
                            <span class="button__icon"><i class="bx bx-printer bx-xs"></i></span>
                            <span class="button__text2">Orçamento</span>
                        </a>
                        <a class="button btn btn-mini btn-secondary" asp-controller="Venda" asp-action="Imprimir" asp-route-id="@Model.Venda.Id" asp-route-tipo="a4" target="_blank">
                            <span class="button__icon"><i class="bx bx-printer bx-xs"></i></span>
                            <span class="button__text2">Papel A4</span>
                        </a>
                        <a class="button btn btn-mini btn-secondary" asp-controller="Venda" asp-action="Imprimir" asp-route-id="@Model.Venda.Id" asp-route-tipo="nao-fiscal" target="_blank">
                            <span class="button__icon"><i class="bx bx-printer bx-xs"></i></span>
                            <span class="button__text2">CP não fiscal</span>
                        </a>
                    </div>
                </div>
                <a data-bs-target="#modalGerarPagamento" data-bs-toggle="modal" class="button btn btn-mini btn-info"
                data-id="@Model.Venda.Id" data-tipo="venda">
                    <span class="button__icon"><i class="bx bx-qr bx-xs"></i></span>
                    <span class="button__text2">Gerar pagamento</span>
                </a>
                <a class="button btn btn-mini btn-warning" asp-controller="Venda" asp-action="Index">
                    <span class="button__icon"><i class="bx bx-x bx-xs"></i></span>
                    <span class="button__text2">Voltar</span>
                </a>
            </div>

            <div class="container-fluid mt-3">
                <div class="row">
                    <div class="col-12">
                        <div class="text-secondary-emphasis bg-light-subtle border border-secondary-subtle rounded-3 p-3">
                            <div class="row">
                                <div class="col-lg-5 col-md-6 mt-2">
                                    <h6>Cliente</h6>
                                    <p style="margin-bottom: 0px!important;">
                                        <i class="bx bxs-business"></i> @Model.Venda.Cliente.Nome
                                    </p>
                                    <p style="margin-bottom: 0px!important;">
                                        <i class="bx bxs-phone"></i> E-mail: @Model.Venda.Cliente.Celular
                                    </p>
                                    <p style="margin-bottom: 0px!important;">
                                        <i class="fas fa-map-marker-alt"></i> @Model.Venda.Cliente.Rua, @Model.Venda.Cliente.NumeroRua, @Model.Venda.Cliente.Bairro - @Model.Venda.Cliente.Cep
                                        @Model.Venda.Cliente.Cidade/@Model.Venda.Cliente.Estado
                                    </p>
                                    <p style="margin-bottom: 0px!important;">
                                        <i class="fas fa-envelope"></i> Celular: @Model.Venda.Cliente.Email
                                    </p>
                                </div>
                                <div class="col-lg-5 col-md-6 mt-2">
                                    <h6>Responsável</h6>
                                    <p style="margin-bottom: 0px!important;">
                                        <i class="fas fa-user"></i> @Model.Venda.Usuario.Nome
                                    </p>
                                    <p style="margin-bottom: 0px!important;">
                                        <i class="fas fa-envelope"></i> E-mail: @Model.Venda.Usuario.Email
                                    </p>
                                    <p style="margin-bottom: 0px!important;">
                                        <i class="bx bxs-phone"></i> Celular: @Model.Venda.Usuario.Telefone
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-12 mt-3 p-3 table-responsive">
                <table class="table table-condensed">
                    <tbody>
                        @foreach (var item in Model.Vendas)
                        {
                            <tr>
                                <td><b>Status Venda: </b> @item.Status </td>
                                <td><b>Data da Venda: </b> @item.DataVenda.ToString("dd/MM/yyyy") </td>

                                @if (@item.GarantiaDias != 0)
                                {
                                    <td><b>Garantia: </b> @item.GarantiaDias </td>
                                    @if (status.Contains(item.Status))
                                    {
                                        <td><b>Venc. da Garantia: </b> @item.DataVenda.AddDays(@item.GarantiaDias.Value).ToString("dd/MM/yyyy") </td>
                                    }
                                }
                            </tr>
                        }
                        <tr>
                            <td colspan="4"><b>Observações: </b> @Html.Raw(Model.Venda.Observacao)</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="col-lg-12 mt-3 p-3 table-responsive">
                <table class="table table-condensed" id="tblProdutos">
                    <thead class="table-secondary">
                        <tr>
                            <th class="text-start">Cód. de barra</th>
                            <th class="text-start">Produto</th>
                            <th class="text-start">Quantidade</th>
                            <th class="text-start">Preço unit.</th>
                            <th class="text-start">Sub-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Itens)
                        {
                            <tr>
                                <td class="text-start">@item.Produto.CodigoBarras</td>
                                <td class="text-start">@item.Produto.Descricao</td>
                                <td class="text-start">@item.Quantidade</td>
                                <td class="text-start">R$ @item.Preco.ToString("N2")</td>
                                <td class="text-start">R$ @item.SubTotal?.ToString("N2")</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="4" style="text-align: right"><strong>Total:</strong></td>
                            <td><strong>R$ @valorTotalProdutos.ToString("n2")</strong></td>
                        </tr>
                    </tbody>
                </table>
                <hr />
                <h6 style="text-align: right">Total: R$ @valorTotalProdutos.ToString("n2")</h6>
                @if (desconto > 0)
                {
                    <h6 style="text-align: right">Desconto: R$ @desconto.ToString("N2")</h6>
                    <h6 style="text-align: right">Total Com Desconto: R$ @valorVendaComDesconto.ToString("N2")</h6>
                }
            </div>

        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Cobranca/_ModalGerarPagamento.cshtml")
