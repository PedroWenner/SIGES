@using SIGES.ViewModel
@model VendaViewModel

@{
    ViewData["Titulo"] = "Editar venda";
}

<style>
    .ck-editor__editable {
    min-height: 300px;
    border: 1px solid #ccc;
    padding: 10px;
    width: 100%;
    white-space: normal !important;
    overflow-wrap: break-word;
    word-wrap: break-word;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Dados da venda nº @Model.Venda.Id</h5>
        </div>
        <div class="card-body">

            <div class="d-flex">
                <a title="Editar" class="button btn btn-mini btn-success" asp-controller="Venda" asp-action="Editar" asp-route-id="@Model.Venda.Id">
                    <span class="button__icon"><i class="bx bx-edit bx-xs"></i></span>
                    <span class="button__text2">Editar</span>
                </a>
                <a title="Orçamento" class="button btn btn-mini btn-secondary" asp-controller="Venda" asp-action="Imprimir" asp-route-id="@Model.Venda.Id" asp-route-tipo="nao-fiscal" target="_blank">
                    <span class="button__icon"><i class="bx bx-printer bx-xs"></i></span>
                    <span class="button__text2">Orçamento</span>
                </a>
                <a title="Papel A4" class="button btn btn-mini btn-secondary" asp-controller="Venda" asp-action="Imprimir" asp-route-id="@Model.Venda.Id" asp-route-tipo="a4" target="_blank">
                    <span class="button__icon"><i class="bx bx-printer bx-xs"></i></span>
                    <span class="button__text2">Papel A4</span>
                </a>
                <a title="CP não fiscal" class="button btn btn-mini btn-secondary" asp-controller="Venda" asp-action="Imprimir" asp-route-id="@Model.Venda.Id" asp-route-tipo="a4" target="_blank">
                    <span class="button__icon"><i class="bx bx-printer bx-xs"></i></span>
                    <span class="button__text2">CP não fiscal</span>
                </a>
                <a data-bs-target="#modalGerarPagamento" data-bs-toggle="modal" title="Gerar pagamento" class="button btn btn-mini btn-info"
                    data-id="@Model.Venda.Id" data-tipo="venda">
                    <span class="button__icon"><i class="bx bx-qr bx-xs"></i></span>
                    <span class="button__text2">Gerar pagamento</span>
                </a>
                <a title="Voltar" class="button btn btn-mini btn-warning" asp-controller="Venda" asp-action="Index">
                    <span class="button__icon"><i class="bx bx-x bx-xs"></i></span>
                    <span class="button__text2">Voltar</span>
                </a>
            </div>

            <div class="col-lg-12 mt-3 p-3 text-secondary-emphasis bg-light-subtle border border-secondary-subtle rounded-3">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Cliente</h6>
                        <p style="margin-bottom: 0px!important;">@Model.Venda.Cliente.Nome</p>
                        <p style="margin-bottom: 0px!important;">@Model.Venda.Cliente.Rua - @Model.Venda.Cliente.NumeroRua - @Model.Venda.Cliente.Bairro</p>
                        <p style="margin-bottom: 0px!important;">@Model.Venda.Cliente.Cidade - @Model.Venda.Cliente.Estado - @Model.Venda.Cliente.Cep</p>
                        <p style="margin-bottom: 0px!important;">E-mail: @Model.Venda.Cliente.Email</p>
                        <p style="margin-bottom: 0px!important;">Celular: @Model.Venda.Cliente.Celular</p>
                    </div>
                    <div class="col-md-6">
                        <h6>Vendedor</h6>
                        <p style="margin-bottom: 0px!important;">@Model.Venda.Usuario.Nome</p>
                        <p style="margin-bottom: 0px!important;">E-mail: @Model.Venda.Usuario.Email</p>
                        <p style="margin-bottom: 0px!important;">Celular: @Model.Venda.Usuario.Telefone</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-12 mt-3 p-3">
                <table class="table table-condensed">
                    <tbody>
                        @foreach (var item in Model.Vendas)
                        {
                            <tr>
                                <td><b>Status Venda: </b> @item.Status </td>
                                <td><b>Data da Venda: </b> @item.DataVenda.ToString("dd/MM/yyyy") </td>
                                <td><b>Garantia: </b> @item.GarantiaDias </td>
                                @* <td><?php if (in_array($result->status, ['Finalizado', 'Faturado', 'Orçamento', 'Aberto', 'Em Andamento', 'Aguardando Peças'])): ?><b>Venc. da Garantia: </b><?php echo dateInterval($result->dataVenda, $result->garantia); ?><?php endif; ?></td> *@
                            </tr>
                        }
                        <tr>
                            <td colspan="3"><b>Observações: </b>@ViewData["VendaObservacao"]</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="col-lg-12 mt-3 p-3">
                <table class="table table-condensed" id="tblProdutos">
                    <thead>
                        <tr>
                            <th style="font-size: 15px">Cód. de barra</th>
                            <th style="font-size: 15px">Produto</th>
                            <th style="font-size: 15px">Quantidade</th>
                            <th style="font-size: 15px">Preço unit.</th>
                            <th style="font-size: 15px">Sub-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Itens)
                        {
                            <tr>
                                <td>@item.Produto.CodigoBarras</td>
                                <td>@item.Produto.Descricao</td>
                                <td>@item.Quantidade</td>
                                <td>@Convert.ToDecimal(@item.Preco).ToString("C")</td>
                                <td>@Convert.ToDecimal(@item.SubTotal).ToString("C")</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="4" style="text-align: right"><strong>Total:</strong></td>
                            <td><strong>R$ @Model.Itens.Sum(i => i.Preco * i.Quantidade)</strong></td>
                        </tr>
                    </tbody>
                </table>
                <hr />
                <h4 style="text-align: right">Total: R$ @Model.Itens.Sum(i => i.Preco * i.Quantidade)</h4>
                <!--
                <?php if ($result->valor_desconto != 0 && $result->desconto != 0): ?>
                <h4 style="text-align: right">Desconto: R$ <?php echo number_format($result->valor_desconto - $totalProdutos, 2, ',', '.'); ?></h4>
                <h4 style="text-align: right">Total Com Desconto: R$ <?php echo number_format($result->valor_desconto, 2, ',', '.'); ?></h4>
                <?php endif; ?>
                -->
            </div>

        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Cobranca/_ModalGerarPagamento.cshtml")
