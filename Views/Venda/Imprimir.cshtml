@using SIGES.Helpers
@using SIGES.ViewModel
@model VendaImprimirViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="@Url.Content("~/bootstrap-5.3.3/css/bootstrap.css")" />
    <link href="@Url.Content("~/font-awesome/css/font-awesome.css")" rel="stylesheet" />
    <title>Imprimir Venda</title>
</head>
<body>
    @{
        string garantia = Model.Venda.GarantiaDias.ToString();
        DateTime vencGarantia = Model.Venda.DataVenda.AddDays(double.Parse(string.IsNullOrEmpty(garantia) ? "0" : garantia));
    }

    <div class="d-flex align-items-start">
        <div class="me-4">
            @if (Model.Emitente.ImagemBlob != null)
            {
                <img src="data:image/png;base64,@Convert.ToBase64String(Model.Emitente.ImagemBlob)" id="previewImg" class="img-fluid rounded" alt="Imagem do emitente" style="max-width: 150px;" />
            }
            else
            {
                <img src="" id="previewImg" class="img-fluid rounded" alt="Pré-visualização da imagem" style="max-width: 150px; display:none;" />
            }
        </div>
        <div>
            <ul style="padding-left: 0; list-style: none;">
                <li><strong>Nome:</strong> @Model.Emitente.Nome</li>
                <li><strong>CNPJ:</strong> @Model.Emitente.Cnpj</li>
                <li><strong>Endereço:</strong> @Model.Emitente.Rua, @Model.Emitente.Numero</li>
                <li><strong>Bairro:</strong> @Model.Emitente.Bairro</li>
                <li><strong>Cidade - UF:</strong> @Model.Emitente.Cidade, @Model.Emitente.Uf</li>
                <li><strong>E-mail:</strong> @Model.Emitente.Email</li>
                <li><strong>Celular:</strong> @Model.Emitente.Telefone</li>
            </ul>
        </div>
    </div>
    <hr />

    <h5>CLIENTE</h5>
    <ul>
        <li style="list-style: none;">
            <span><strong>Nome:</strong> @Model.Venda.Cliente.Nome</span><br />
            <span><strong>Endereço:</strong> @Model.Venda.Cliente.Rua, @Model.Venda.Cliente.NumeroRua</span><br />
            <span><strong>Bairro:</strong> @Model.Venda.Cliente.Bairro</span><br />
            <span><strong>Cidade - UF:</strong> @Model.Venda.Cliente.Cidade, @Model.Venda.Cliente.Estado</span><br />
            <span><strong>E-mail:</strong> @Model.Venda.Cliente.Email</span><br />
            <span><strong>Celular:</strong> @Model.Venda.Cliente.Celular</span><br />
        </li>
    </ul>

    <table class="table table-borderless table-condensed">
        <tbody>
            <tr>
                <td>
                    <b>Status:</b>
                    @Model.Venda.Status
                </td>
                <td>
                    <b>Data da venda:</b>
                    @Model.Venda.DataVenda.ToString("dd/MM/yyyy")
                </td>
                @if (Model.Venda.GarantiaDias != null && Model.Venda.GarantiaDias > 0)
                {
                    <td>
                        <b>Garantia:</b>
                        @Model.Venda.GarantiaDias (dias)
                    </td>
                    <td>
                        <b>Venc. da garantia:</b>
                        @vencGarantia.ToString("dd/MM/yyyy")
                    </td>
                }
            </tr>
            <tr>
                <td colspan="4">
                    <hr />
                    <b>Observações:</b>
                    @HtmlHelpers.RemoverTagsHtml(Model.Venda.Observacao);
                </td>
            </tr>
        </tbody>
    </table>

    <table class="table">
        <thead>
            <tr>
                <th style="width: 10%">Cód</th>
                <th style="width: 10%">Produto</th>
                <th style="width: 10%">Qtd</th>
                <th style="width: 10%">Preço Unitário</th>
                <th style="width: 10%">Sub-total</th>
            </tr>
        </thead>
        <tbody class="table-group-divider">
            @foreach (var item in Model.ItensVenda)
            {
                <tr>
                    <td>@item.Produto.CodigoBarras</td>
                    <td>@item.Produto.Descricao</td>
                    <td>@item.Quantidade</td>
                    <td>@Convert.ToDecimal(item.Preco).ToString("C")</td>
                    <td>@Convert.ToDecimal((item.Preco * item.Quantidade)).ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <span class="float-end"><strong>Total:</strong> @Convert.ToDecimal(Model.ItensVenda.Sum(i => i.Preco * i.Quantidade)).ToString("C")</span>
    <br />

    @if (Model.Venda.Desconto != null || Model.Venda.Desconto > 0)
    {
        <span class="float-end"><strong>Desconto:</strong> @Convert.ToDecimal(Model.Venda.Desconto).ToString("C")</span>
        <br />
        <span class="float-end"><strong>Total com desconto:</strong> @Convert.ToDecimal(Model.ItensVenda.Sum(i => i.Preco * i.Quantidade) - Model.Venda.Desconto).ToString("C")</span>
        <br />
    }

    <script>
        window.print();
    </script>
</body>
</html>