@model VendaModel

@{
    ViewData["Titulo"] = "Adicionar venda";
}

<style>
    .ck-editor__editable {
        min-height: 300px;
        border: 1px solid #ccc;
        padding: 10px;
        width: 100%;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Cadastrar venda</h5>
        </div>
        <div class="card-body">

            <ul class="nav nav-tabs" id="myTabVendas" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="navLinkDetalheVenda" data-bs-toggle="tab" data-bs-target="#venda-tab-pane" type="button" role="tab" aria-controls="venda-tab-pane" aria-selected="true">Detalhes da venda</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="venda-tab-pane" role="tabpanel" aria-labelledby="navLinkDetalheVenda" tabindex="0">
                    <form id="formVenda" method="post" asp-controller="Venda" asp-action="Adicionar">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row mb-3 mt-3">
                            <div class="col-2">
                                <label for="dataVenda" class="form-label">Data da venda</label>
                                <input id="dataVenda" type="text" asp-for="DataVenda" class="datetime" value="@DateTime.Now.ToString("dd/MM/yyyy")" required />
                                <span asp-validation-for="DataVenda" class="text-danger"></span>
                            </div>
                            <div class="col-3">
                                <label for="cliente" class="form-label">Cliente</label>
                                <input id="cliente" type="text" placeholder="Digite o nome do cliente" required />
                                <input id="cliente-id" type="hidden" asp-for="ClienteId" />
                                <span asp-validation-for="ClienteId" class="text-danger"></span>
                            </div>
                            <div class="col-3">
                                <label for="vendedor" class="form-label">Vendedor</label>
                                <input id="vendedor" type="text" placeholder="Digite o nome do vendedor" required />
                                <input id="vendedor-id" type="hidden" asp-for="UsuarioId" />
                                <span asp-validation-for="UsuarioId" class="text-danger"></span>
                            </div>
                            <div class="col-2">
                                <label for="status" class="form-label">Status</label>
                                <select asp-for="Status" id="status" required>
                                    <option value="Orçamento">Orçamento</option>
                                    <option value="Aberto">Aberto</option>
                                    <option value="Faturado">Faturado</option>
                                    <option value="Em Andamento">Em Andamento</option>
                                    <option value="Finalizado">Finalizado</option>
                                    <option value="Cancelado">Cancelado</option>
                                    <option value="Aguardando Peças">Aguardando Peças</option>
                                    <option value="Aprovado">Aprovado</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                            <div class="col-2">
                                <label for="garantia" class="form-label">Garantia (dias)</label>
                                <input id="garantia" type="text" asp-for="GarantiaDias" onkeypress="return somenteNumeros(this)" />
                                <span asp-validation-for="GarantiaDias" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3 mt-3">
                            <div class="col-6">
                                <h6>Observações</h6>
                                <textarea asp-for="Observacao" id="observacao"></textarea>
                            </div>
                            <div class="col-6">
                                <h6>Observações para o cliente</h6>
                                <textarea asp-for="ObservacaoCliente" id="observacaoCliente"></textarea>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex justify-content-center">
                            <a title="Voltar" class="button btn btn-warning" asp-controller="Venda" asp-action="Index">
                                <span class="button__icon"><i class="bx bx-undo"></i></span>
                                <span class="button__text2">Voltar</span>
                            </a>
                            <button type="submit" class="button btn btn-mini btn-success">
                                <span class="button__icon"><i class='bx bx-chevrons-right'></i></span>
                                <span class="button__text2">Continuar</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script src="~/js/ckeditor.js"></script>
<script>
    ClassicEditor
        .create(document.querySelector('#observacao'), {
            language: 'pt-br',
            toolbar: [
                'undo', 'redo', '|',
                'heading', '|',
                'bold', 'italic', '|', 'bulletedList', 'numberedList', 'blockQuote', '|',
            ]
        });

    ClassicEditor
        .create(document.querySelector('#observacaoCliente'), {
            language: 'pt-br',
            toolbar: [
                'undo', 'redo', '|',
                'heading', '|',
                'bold', 'italic', '|', 'bulletedList', 'numberedList', 'blockQuote', '|',
            ]
        });

    $(function () {
        $("#cliente").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/clientes/ListarClientes",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        if (data.length === 0) {
                            response([{
                                nome: "Adicionar cliente",
                                value: "add",
                                adicionar: true
                            }]);
                        } else {
                            response(data);
                        }
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                if (!ui.item.adicionar) {
                    $("#cliente").val(ui.item.nome);
                }

                return false;
            },
            select: function (event, ui) {
                if (ui.item.adicionar) {
                    window.location.href = "/clientes/adicionar";
                } else {
                    $("#cliente").val(ui.item.nome);
                    $("#cliente-id").val(ui.item.value);
                }

                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            if (item.adicionar) {
                return $("<li>")
                    .append(
                        `<div class="ui-menu-item-wrapper">
                            <span class="autocomplete-add">➕ ${item.nome}</span>
                        </div>`
                    )
                    .appendTo(ul);
            } else {
                return $("<li>")
                    .append(
                        `<div class="ui-menu-item-wrapper">
                            <span class="autocomplete-title">${item.nome}</span>
                            <span class="autocomplete-details">Celular: ${item.celular} | Documento: ${item.documento}</span>
                        </div>`
                    )
                    .appendTo(ul);
            }
        };
    });

    $(function () {
        $("#vendedor").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/usuarios/listarUsuarios",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                $("#vendedor").val(ui.item.nome);
                return false;
            },
            select: function (event, ui) {
                $("#vendedor").val(ui.item.nome);
                $("#vendedor-id").val(ui.item.value);
                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            return $("<li>")
                .append(
                    `<div class="ui-menu-item-wrapper">
                        <span class="autocomplete-title">${item.nome}</span>
                        <span class="autocomplete-details">Celular: ${item.celular}</span>
                    </div>`
                )
                .appendTo(ul);
        };
    });

    $(document).ready(function () {
        $('#formVenda').validate({
            rules: {
                'DataVenda': { required: true },
            },
            messages: {
                'DataVenda': { required: 'Campo requerido.' },
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });
</script>
