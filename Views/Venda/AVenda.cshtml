@model VendaModel

@{
    ViewData["Titulo"] = "Adicionar venda";
}

<link rel="stylesheet" href="~/trumbowyg/dist/ui/trumbowyg.css">

<style>
    .custom-counter {
        display: flex;
        align-items: center;
        border: 1px solid #ddd;
        border-radius: 5px;
        background-color: #fff;
        justify-content: space-between;
        transition: border 0.3s ease;
    }

    .custom-counter:focus-within {
        border: 1px solid #aaa;
    }

    .custom-counter input[type="text"] {
        border: none;
        outline: none;
        text-align: center;
        font-size: 14px;
        color: #333;
        background: transparent;
    }

    .custom-counter input::placeholder {
        color: #bbb;
        font-style: italic;
    }

    .counter-buttons {
        display: flex;
        gap: 8px;
        padding-right: 10px;
    }

    .counter-buttons button {
        background: none;
        border: none;
        color: #aaa;
        font-size: 18px;
        cursor: pointer;
        transition: color 0.3s ease;
        padding: 0;
    }

    .counter-buttons button:hover {
        color: #333;
    }

    .counter-buttons button:disabled {
        color: #ddd;
        cursor: default;
    }

    .password-container {
        position: relative;
    }

    .toggle-datetime {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #888;
    }

    #ui-datepicker-div {
        z-index: 999 !important;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-theme-gray text-white d-flex align-items-center">
            <h5 class="mb-0">Cadastrar venda</h5>
        </div>
        <div class="card-body">

            <ul class="nav nav-tabs" id="myTabVendas" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="navLinkDetalheVenda" data-bs-toggle="tab" data-bs-target="#venda-tab-pane" type="button" role="tab" aria-controls="venda-tab-pane" aria-selected="true">Detalhes da venda</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="venda-tab-pane" role="tabpanel" aria-labelledby="navLinkDetalheVenda" tabindex="0">
                    <form id="formVenda" method="post" asp-controller="Venda" asp-action="Adicionar">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row mt-2">
                            <div class="col-md-2 mt-2">
                                <label for="dataVenda" class="form-label">Data da venda</label>
                                <div class="password-container">
                                    <input id="dataVenda" type="text" asp-for="DataVenda" class="datetime" value="@DateTime.Now.ToString("dd/MM/yyyy")" required />
                                    <i class="fas fa-calendar-alt toggle-datetime"></i>
                                </div>
                                <span asp-validation-for="DataVenda" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mt-2">
                                <label for="cliente" class="form-label">Cliente</label>
                                <input id="cliente" type="text" placeholder="Digite o nome do cliente" required />
                                <input id="cliente-id" type="hidden" asp-for="ClienteId" />
                                <span asp-validation-for="ClienteId" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mt-2">
                                <label for="vendedor" class="form-label">Vendedor</label>
                                <input id="vendedor" type="text" placeholder="Digite o nome do vendedor" required value="@Context.Session.GetString("UserName")" />
                                <input id="vendedor-id" type="hidden" asp-for="UsuarioId" value="@Context.Session.GetString("UserId")" />
                                <span asp-validation-for="UsuarioId" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 mt-2">
                                <label for="status" class="form-label">Status</label>
                                <select asp-for="Status" id="status" required>
                                    <option value="Orçamento">Orçamento</option>
                                    <option value="Aberto">Aberto</option>
                                    <option value="Faturado">Faturado</option>
                                    <option value="Em Andamento">Em Andamento</option>
                                    <option value="Finalizado">Finalizado</option>
                                    <option value="Cancelado">Cancelado</option>
                                    <option value="Aguardando Peças">Aguardando Peças</option>
                                    <option value="Aprovado">Aprovado</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 mt-2">
                                <label for="garantia" class="form-label">Garantia (dias)</label>
                                <div class="custom-counter">
                                    <input id="garantia" type="text" asp-for="GarantiaDias" onkeypress="return somenteNumeros(this)" />
                                    <div class="counter-buttons">
                                        <button id="btn-decrement-garantia" type="button" onclick="decrement('btn-decrement-garantia', 'garantia');">–</button>
                                        <button id="btn-increment-garantia" type="button" onclick="increment('btn-decrement-garantia', 'garantia');">+</button>
                                    </div>
                                </div>
                                <span asp-validation-for="GarantiaDias" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-md-6 mt-2">
                                <h6>Observações</h6>
                                <textarea asp-for="Observacao" id="observacao"></textarea>
                            </div>
                            <div class="col-md-6 mt-2">
                                <h6>Observações para o cliente</h6>
                                <textarea asp-for="ObservacaoCliente" id="observacaoCliente"></textarea>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-flex justify-content-center mt-2">
                            <a class="button btn btn-warning" asp-controller="Venda" asp-action="Index">
                                <span class="button__icon"><i class="bx bx-undo"></i></span>
                                <span class="button__text2">Voltar</span>
                            </a>
                            <button type="submit" class="button btn btn-mini btn-success">
                                <span class="button__icon"><i class='bx bx-chevrons-right'></i></span>
                                <span class="button__text2">Continuar</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script src="~/trumbowyg/dist/trumbowyg.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontsize/trumbowyg.fontsize.min.js"></script>
<script src="~/trumbowyg/dist/plugins/fontfamily/trumbowyg.fontfamily.min.js"></script>
<script src="~/trumbowyg/dist/langs/pt_br.js"></script>
<script>
    $('#observacao').trumbowyg({
        lang: 'pt_br',
        autogrow: true,
        tagsToRemove: ['script', 'link'],
        tagsToKeep: ['i', 'script[src]'],
        btns: [
            ['fontfamily'],
            ['fontsize'],
            ['undo', 'redo'],
            ['bold', 'italic'],
            ['formatting'],
            ['justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'],
            ['unorderedList', 'orderedList'],
            ['horizontalRule'],
        ],
        plugins: {
            fontsize: {
                sizeList: [
                    '10px', '12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '36px'
                ]
            }
        }
    });

    $('#observacaoCliente').trumbowyg({
        lang: 'pt_br',
        autogrow: true,
        tagsToRemove: ['script', 'link'],
        tagsToKeep: ['i', 'script[src]'],
        btns: [
            ['fontfamily'],
            ['fontsize'],
            ['undo', 'redo'],
            ['bold', 'italic'],
            ['formatting'],
            ['justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'],
            ['unorderedList', 'orderedList'],
            ['horizontalRule'],
        ],
        plugins: {
            fontsize: {
                sizeList: [
                    '10px', '12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '36px'
                ]
            }
        }
    });

    $(function () {
        $("#cliente").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/clientes/ListarClientes",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        if (data.length === 0) {
                            response([{
                                nome: "Adicionar cliente",
                                value: "add",
                                adicionar: true
                            }]);
                        } else {
                            response(data);
                        }
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                if (!ui.item.adicionar) {
                    $("#cliente").val(ui.item.nome);
                }

                return false;
            },
            select: function (event, ui) {
                if (ui.item.adicionar) {
                    window.location.href = "/clientes/adicionar";
                } else {
                    $("#cliente").val(ui.item.nome);
                    $("#cliente-id").val(ui.item.value);
                }

                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            if (item.adicionar) {
                return $("<li>")
                    .append(
                        `<div class="ui-menu-item-wrapper">
                            <span class="autocomplete-add">➕ ${item.nome}</span>
                        </div>`
                    )
                    .appendTo(ul);
            } else {
                return $("<li>")
                    .append(
                        `<div class="ui-menu-item-wrapper">
                            <span class="autocomplete-title">${item.nome}</span>
                            <span class="autocomplete-details">Celular: ${item.celular} | Documento: ${item.documento}</span>
                        </div>`
                    )
                    .appendTo(ul);
            }
        };
    });

    $(function () {
        $("#vendedor").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/usuarios/listarUsuarios",
                    type: "GET",
                    data: { term: request.term },
                    success: function (data) {
                        response(data);
                    }
                });
            },
            minLength: 2,
            focus: function (event, ui) {
                $("#vendedor").val(ui.item.nome);
                return false;
            },
            select: function (event, ui) {
                $("#vendedor").val(ui.item.nome);
                $("#vendedor-id").val(ui.item.value);
                return false;
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            return $("<li>")
                .append(
                    `<div class="ui-menu-item-wrapper">
                        <span class="autocomplete-title">${item.nome}</span>
                        <span class="autocomplete-details">Celular: ${item.celular}</span>
                    </div>`
                )
                .appendTo(ul);
        };
    });

    $(document).ready(function () {
        $('#formVenda').validate({
            rules: {
                'DataVenda': { required: true },
            },
            messages: {
                'DataVenda': { required: 'Campo requerido.' },
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });
</script>

<script>
    function increment(btnDecrement, id) {
        const input = document.getElementById(id);
        const decrement = document.getElementById(btnDecrement);
        input.value = parseInt(input.value || 0) + 1;
        updateButtons(decrement, input);
    }

    function decrement(btnDecrement, id) {
        const input = document.getElementById(id);
        const decrement = document.getElementById(btnDecrement);
        input.value = parseInt(input.value || 0) - 1;
        updateButtons(decrement, input);
    }

    function updateButtons(btnDecrement, id) {
        btnDecrement.disabled = id.value <= 0;
    }
</script>