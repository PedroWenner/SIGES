@using SIGES.Helpers
@using SIGES.ViewModel
@model VendaViewModel

@{
    ViewData["Titulo"] = "Vendas";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Vendas</h5>
    </div>
    <div class="col-lg-12" style="margin-left: 0">
        <div class="col-lg-2">
            @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "aVenda"))
            {
                <div class="d-flex">
                    <a role="button" class="button btn btn-success w-100" asp-controller="Venda" asp-action="Adicionar">
                        <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                        <span class="button__text2">Nova venda</span>
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content table-responsive">
            <table id="tabela">
                <thead>
                    <tr>
                        <th>Nº</th>
                        <th>Cliente</th>
                        <th>Data da venda</th>
                        <th>Venc. da garantia</th>
                        <th>Status</th>
                        <th>Faturado</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Vendas == null || Model.Vendas.Count == 0)
                    {
                        <tr>
                            <td colspan="7">Nenhuma venda cadastrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var venda in Model.Vendas)
                        {
                            string garantia = venda.GarantiaDias.ToString();
                            DateTime vencGarantia = venda.DataVenda.AddDays(double.Parse(string.IsNullOrEmpty(garantia) ? "0" : garantia));

                            string cor = string.Empty;
                            switch (venda.Status) {
                                case "Aberto":
                                    cor = "text-bg-primary";
                                    break;
                                case "Em Andamento":
                                    cor = "text-bg-secondary";
                                    break;
                                case "Orçamento":
                                    cor = "text-bg-info";
                                    break;
                                case "Negociação":
                                    cor = "text-bg-warning";
                                    break;
                                case "Cancelado":
                                    cor = "text-bg-danger";
                                    break;
                                case "Finalizado":
                                    cor = "text-bg-dark";
                                    break;
                                case "Faturado":
                                    cor = "text-bg-primary";
                                    break;
                                case "Aguardando Peças":
                                    cor = "text-bg-light";
                                    break;
                                case "Aprovado":
                                    cor = "text-bg-success";
                                    break;
                                default:
                                    cor = "text-bg-primary";
                                    break;
                            }

                            <tr>
                                <td>@venda.Id</td>
                                <td>@venda.Cliente.Nome</td>
                                <td>@venda.DataVenda.ToShortDateString()</td>
                                <td>
                                    @if (venda.GarantiaDias != null && venda.GarantiaDias > 0)
                                    {
                                        <span class="badge rounded-pill text-bg-success">
                                            @vencGarantia.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill @cor">
                                        @venda.Status
                                    </span>
                                </td>
                                <td>@(string.IsNullOrEmpty(venda.Faturado.ToString()) ? "Não" : "Sim")</td>
                                <td>
                                    <a href="#" data-entidade="VendaModel" data-id="@venda.Id" style="margin-right: 1%" class="btn-nwe7 btn-exibir-log text-decoration-none" title="Exibir histórico">
                                        <i class='bx bx-history'></i>
                                    </a>
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vVenda"))
                                    {
                                        <a asp-controller="Venda" asp-action="Visualizar" asp-route-id="@venda.Id" style="margin-right: 1%" class="btn-nwe text-decoration-none" title="Ver mais detalhes">
                                            <i class="bx bx-show"></i>
                                        </a>
                                        <a asp-controller="Venda" asp-action="Imprimir" asp-route-id="@venda.Id" asp-route-tipo="a4" target="_blank" style="margin-right: 1%" class="btn-nwe6 text-decoration-none" title="Imprimir A4">
                                            <i class="bx bx-printer"></i>
                                        </a>
                                        <a asp-controller="Venda" asp-action="Imprimir" asp-route-id="@venda.Id" asp-route-tipo="nao-fiscal" target="_blank" style="margin-right: 1%" class="btn-nwe6 text-decoration-none" title="Imprimir não fiscal">
                                            <i class="bx bx-printer"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eVenda"))
                                    {
                                        <a asp-controller="Venda" asp-action="Editar" asp-route-id="@venda.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none" title="Editar venda">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "dVenda"))
                                    {
                                        <a href="#modal-excluir" data-id="@venda.Id" role="button" data-bs-target="#modal-excluir" data-bs-toggle="modal" style="margin-right: 1%" class="btn-nwe4 text-decoration-none" title="Excluir venda">
                                            <i class="bx bx-trash-alt"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<!-- Modal excluir -->
<div id="modal-excluir" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Venda" asp-action="Excluir">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Excluir produto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="idVenda" name="id" />
                    <h6 style="text-align: center">
                        Deseja realmente excluir esta venda?
                    </h6>
                </div>
                <div class="modal-footer" style="display:flex;justify-content: center">
                    <button type="button" class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true">
                        <span class="button__icon"><i class="bx bx-x"></i></span>
                        <span class="button__text2">Cancelar</span>
                    </button>
                    <button type="submit" class="button btn btn-danger">
                        <span class="button__icon"><i class='bx bx-trash'></i></span>
                        <span class="button__text2">Excluir</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")

<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', 'a', function (event) {
            var venda = $(this).data('id');
            $('#idVenda').val(venda);
        });
    });
</script>