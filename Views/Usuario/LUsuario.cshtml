@using SIGES.Helpers
@using SIGES.ViewModel
@model UsuarioViewModel

@{
    ViewData["Titulo"] = "Usuários";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Usuários</h5>
    </div>
    <div class="col-lg-12" style="margin-left: 0">
        <div class="col-md-2">
            @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "aUsuario"))
            {
                <a role="button" class="button btn btn-mini btn-success w-100" asp-controller="Usuario" asp-action="Adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Usuário</span>
                </a>
            }
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content">
            <div class="table-responsive">
                <table id="tabela">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Telefone</th>
                            <th>Nível</th>
                            <th>Situação</th>
                            <th>Validade</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Usuarios == null || Model.Usuarios.Count == 0)
                        {
                            <tr>
                                <td colspan="8">Nenhum usuário cadastrado</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var usuario in Model.Usuarios)
                            {
                                <tr>
                                    <td>@usuario.Id</td>
                                    <td>@usuario.Nome</td>
                                    <td>@usuario.Cpf</td>
                                    <td>@usuario.Telefone</td>
                                    <td>@usuario.Permissao.Nome</td>
                                    <td>
                                        <span class="badge rounded-pill @(usuario.Situacao.Equals(0) ? "text-bg-danger" : "text-bg-success")">
                                            @(usuario.Situacao.Equals(0) ? "Inativo" : "Ativo")
                                        </span>
                                    </td>
                                    <td>@Convert.ToDateTime(usuario.DataExpiracao).ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a href="#" data-entidade="UsuarioModel" data-id="@usuario.Id" style="margin-right: 1%" class="btn-nwe7 btn-exibir-log text-decoration-none" title="Exibir histórico">
                                            <i class='bx bx-history'></i>
                                        </a>
                                        @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eUsuario"))
                                        {
                                            <a asp-controller="Usuario" asp-action="Editar" asp-route-id="@usuario.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none" title="Editar usuário">
                                                <i class="bx bx-edit bx-xs"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a role="button" class="btn-nwe3-disabled text-decoration-none disabled" style="margin-right: 1%" title="Você não tem permissão para editar">
                                                <i class="bx bx-edit bx-xs"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")

<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', 'a.btn-nwe4', function () {
            var usuarioId = $(this).data('id');
            $('#idUsuario').val(usuarioId);
        });
    });
</script>