@using SIGES.ViewModel
@model UsuarioViewModel

@{
    ViewData["Titulo"] = "Usuários";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Usuários</h5>
    </div>
    <div class="col-lg-12" style="margin-left: 0">
        <div class="col-lg-3">
            <a role="button" class="button btn btn-mini btn-success" style="max-width: 100px" data-toggle="modal" href="/dashboard/usuarios/adicionar">
                <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                <span class="button__text2">Usuário</span>
            </a>
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content">
            <table id="tabela">
                <thead>
                    <tr>
                        <th class="cabecalho">#</th>
                        <th>Nome</th>
                        <th>CPF</th>
                        <th>Telefone</th>
                        <th>Nível</th>
                        <th>Situação</th>
                        <th>Validade</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Usuarios == null || Model.Usuarios.Count == 0)
                    {
                        <tr>
                            <td colspan="8">Nenhum usuário cadastrado</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var usuario in Model.Usuarios)
                        {
                            <tr>
                                <td style="width: 5%; text-align: center;">@usuario.Id</td>
                                <td style="width: 35%;">@usuario.Nome</td>
                                <td style="width: 10%;">@usuario.Cpf</td>
                                <td style="width: 10%;">@usuario.Telefone</td>
                                <td style="width: 10%;">@usuario.Permissao.Nome</td>
                                <td style="width: 10%;">
                                    <span class="badge @(usuario.Situacao.Equals(0) ? "situacao-inativo" : "situacao-ativo")">
                                        @(usuario.Situacao.Equals(0) ? "Inativo" : "Ativo")
                                    </span>
                                </td>
                                <td style="width: 10%;">@Convert.ToDateTime(usuario.DataExpiracao).ToString("dd/MM/yyyy")</td>
                                <td style="width: 15%;">
                                    <a href="#" data-entidade="UsuarioModel" data-id="@usuario.Id" style="margin-right: 1%" class="btn-nwe7 btn-exibir-log text-decoration-none" title="Exibir histórico">
                                        <i class='bx bx-history'></i>
                                    </a>
                                    <a href="/dashboard/usuarios/editar/@usuario.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none" title="Editar usuário">
                                        <i class="bx bx-edit bx-xs"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>

    @* @await Component.InvokeAsync("Paginacao", Model.Usuarios) *@
</div>

@await Html.PartialAsync("_ModalLog")

<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', 'a.btn-nwe4', function () {
            var usuarioId = $(this).data('id');
            $('#idUsuario').val(usuarioId);
        });
    });
</script>