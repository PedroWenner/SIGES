@using SIGES.ViewModel
@model UsuarioViewModel
@{
    ViewData["Titulo"] = "Adicionar usuário";
}
<script src="~/js/funcoes.js"></script>
<script src="@Url.Content("~/js/jquery.mask.js")"></script>

<style>
    .password-container {
        position: relative;
    }

    .password-input {
        padding-right: 30px;
        width: 100%;
        border: 1px solid #ccc;
        border-radius: 5px;
        height: 35px;
    }

    .toggle-password {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #888;
    }

    .toggle-datetime {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #888;
    }

    .toggle-password:hover {
        color: #333;
    }

    .nopadding {
        padding: 0 20px !important;
        margin-right: 20px;
    }

    input.is-invalid::placeholder {
        color: #dc3545;
        opacity: 0.8;
        font-size: 12px;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-theme-gray text-white d-flex align-items-center">
            <h5 class="mb-0">Cadastro de usuário</h5>
        </div>

        <div class="card-body">
            <form id="formUsuario" method="post" enctype="multipart/form-data">
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <h6 class="alert-heading">Atenção!</h6>
                        <hr>
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <!-- Nome -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-1 text-md-end">
                        <label for="nome" class="col-form-label">Nome</label>
                    </div>
                    <div class="col-md-9">
                        <input id="nome" type="text" asp-for="Usuario.Nome" required>
                    </div>
                    <div class="col-md-2">
                        <span class="form-text">Informe o nome do usuário.</span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- RG -->
                    <div class="col-md-1 text-md-end">
                        <label for="rg" class="col-form-label">RG</label>
                    </div>
                    <div class="col-md-3">
                        <input id="rg" type="text" asp-for="Usuario.RgNumero">
                    </div>
                    <div class="col-md-2">
                        <span class="form-text">Informe o rg do usuário.</span>
                    </div>

                    <!-- CPF -->
                    <div class="col-md-1 text-md-end">
                        <label for="cpfUser" class="col-form-label">CPF</label>
                    </div>
                    <div class="col-md-3">
                        <input id="cpfUser" type="text" asp-for="Usuario.Cpf" required>
                    </div>
                    <div class="col-md-2">
                        <span class="form-text">Informe o CPF válido do usuário.</span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Celular -->
                    <div class="col-md-1 text-md-end">
                        <label for="celular" class="col-form-label">Celular</label>
                    </div>
                    <div class="col-md-3">
                        <input id="celular" type="text" asp-for="Usuario.Telefone" required>
                    </div>
                    <div class="col-md-2">
                        <span class="form-text">Informe o nº do celular do usuário.</span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Email -->
                    <div class="col-md-1 text-md-end">
                        <label for="email" class="col-form-label">E-mail</label>
                    </div>
                    <div class="col-md-9">
                        <input id="email" type="email" asp-for="Usuario.Email" required>
                    </div>
                    <div class="col-md-2">
                        <span class="form-text">Informe o e-mail válido do usuário.</span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- CEP -->
                    <div class="col-md-1 text-md-end">
                        <label for="cep" class="col-form-label">CEP</label>
                    </div>
                    <div class="col-md-2">
                        <input id="cep" type="text" asp-for="Usuario.Cep" required>
                    </div>

                    <!-- Rua -->
                    <div class="col-md-1 text-md-end">
                        <label for="rua" class="col-form-label">Rua</label>
                    </div>
                    <div class="col-md-5">
                        <input id="rua" type="text" asp-for="Usuario.Rua" required>
                    </div>

                    <!-- Número -->
                    <div class="col-md-1 text-md-end">
                        <label for="numero" class="col-form-label">Número</label>
                    </div>
                    <div class="col-md-2">
                        <input id="numero" type="text" asp-for="Usuario.NumeroRua" required>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Bairro -->
                    <div class="col-md-1 text-md-end">
                        <label for="bairro" class="col-form-label">Bairro</label>
                    </div>
                    <div class="col-md-3">
                        <input id="bairro" type="text" asp-for="Usuario.Bairro" required>
                    </div>

                    <!-- Cidade -->
                    <div class="col-md-1 text-md-end">
                        <label for="cidade" class="col-form-label">Cidade</label>
                    </div>
                    <div class="col-md-3">
                        <input id="cidade" type="text" asp-for="Usuario.Cidade" required>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-1 text-md-end">
                        <label for="estado" class="col-form-label">Estado</label>
                    </div>
                    <div class="col-md-3">
                        <select id="estado" asp-for="Usuario.Estado">
                            <option value="">Selecione...</option>
                        </select>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Senha -->
                    <div class="col-md-1 text-md-end">
                        <label for="senha" class="col-form-label">Senha</label>
                    </div>
                    <div class="col-md-2">
                        <div class="password-container">
                            <input id="senha" type="password" asp-for="Usuario.Senha" aria-describedby="imgSenha" required>
                            <i class="fa fa-eye toggle-password" onclick="togglePassword('senha')"></i>
                        </div>
                    </div>

                    <!-- Data de expiração -->
                    <div class="col-md-1 text-md-end">
                        <label for="dataExpiracao" class="col-form-label">Expira em</label>
                    </div>
                    <div class="col-md-2">
                        <div class="password-container">
                            <input id="dataExpiracao" type="text" asp-for="Usuario.DataExpiracao" class="datetime" value="31/12/2099" required>
                            <i class="fas fa-calendar-alt toggle-datetime"></i>
                        </div>
                    </div>

                    <!-- Situação -->
                    <div class="col-md-1 text-md-end">
                        <label for="situacao" class="col-form-label">Situação</label>
                    </div>
                    <div class="col-md-2">
                        <select asp-for="Usuario.Situacao" id="situacao" required>
                            <option value="1">Ativo</option>
                            <option value="0">Inativo</option>
                        </select>
                    </div>

                    <!-- Permissões -->
                    <div class="col-md-1 text-md-end">
                        <label for="permissaoId" class="col-form-label">Permissões</label>
                    </div>
                    <div class="col-md-2">
                        <select asp-for="Usuario.PermissaoId" id="permissaoId" required>
                            <option value="">Selecione</option>
                            @foreach (var permissao in Model.Permissoes)
                            {
                                <option value="@permissao.Id">@permissao.Nome</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Imagem -->
                    <div class="col-md-1 text-md-end">
                        <label for="imagem" class="col-form-label">Imagem</label>
                    </div>
                    <div class="col-md-5">
                        <input type="file" id="imagem" name="imagemUsuario" accept="image/*" onchange="previewImage(event)" />
                    </div>
                    <div class="col-md-6">
                        <span class="form-text text-muted">Selecione uma imagem caso deseje registrar para o usuário.</span>
                    </div>
                </div>

                <div class="row">
                    <!-- Botões -->
                    <div class="d-flex justify-content-center mt-4">
                        <a class="button btn btn-warning" asp-controller="Usuario" asp-action="Index">
                            <span class="button__icon"><i class="bx bx-undo"></i></span>
                            <span class="button__text2">Voltar</span>
                        </a>
                        <button type="submit" class="button btn btn-success">
                            <span class="button__icon"><i class='bx bx-save'></i></span>
                            <span class="button__text2">Adicionar</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script type="text/javascript">

    function togglePassword(id) {
        var input = document.getElementById(id);
        var icon = document.querySelector(".toggle-password");
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }

    function previewImage(event) {
        const img = document.getElementById('previewImg');
        if (event.target.files.length > 0) {
            img.src = URL.createObjectURL(event.target.files[0]);
            img.onload = () => {
                URL.revokeObjectURL(img.src);
                img.style.display = "block";
            };
        } else {
            img.style.display = "none";
        }
    }

    $(document).ready(function() {
        var valorSelecionado = '@Model.Usuario.Estado';
        // Carrega os estados do arquivo JSON
        $.getJSON('@Url.Content("~/json/estados.json")', function (data) {
            if (data && data.estados && data.estados.length > 0) {
                for (var i = 0; i < data.estados.length; i++) {
                    $('#estado').append(new Option(data.estados[i].nome, data.estados[i].sigla));
                }

                if (valorSelecionado) {
                    $('#estado').val(valorSelecionado);
                }
            } else {
                console.error('Arquivo JSON não possui as medidas esperadas.');
            }
        });

        $.validator.addMethod("extension", function (value, element, param) {
            var extension = value.split('.').pop().toLowerCase();
            return this.optional(element) || param.split('|').indexOf(extension) !== -1;
        }, "Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).");

        $('#formUsuario').validate({
            rules: {
                'Nome': { required: true },
                'Usuario.DataExpiracao': { required: true },
                'Usuario.Cpf': { required: true },
                'Usuario.Telefone': { required: true },
                'Usuario.Email': { email: true, required: true},
                'Usuario.Senha': { required: true },
                'Usuario.Rua': { required: true },
                'Usuario.NumeroRua': { required: true },
                'Usuario.Bairro': { required: true },
                'Usuario.Cidade': { required: true },
                'Usuario.Estado': { required: true },
                'Usuario.Cep': { required: true },
                'Usuario.PermissaoId': { required: true },
                'Usuario.Imagem': { extension: "jpg|jpeg|png|gif|bmp" }
            },
            messages: {
                'Usuario.Nome': { required: 'Campo requerido.' },
                'Usuario.DataExpiracao': { required: 'Campo requerido.' },
                'Usuario.Cpf': { required: 'Campo requerido.' },
                'Usuario.Telefone': { required: 'Campo requerido.' },
                'Usuario.Email': { email: 'Informe um e-mail valido.', required: 'Campo requerido.' },
                'Usuario.Senha': { required: 'Campo requerido.' },
                'Usuario.Rua': { required: 'Campo requerido.' },
                'Usuario.NumeroRua': { required: 'Campo requerido.' },
                'Usuario.Bairro': { required: 'Campo requerido.' },
                'Usuario.Cidade': { required: 'Campo requerido.' },
                'Usuario.Estado': { required: 'Campo requerido.' },
                'Usuario.Cep': { required: 'Campo requerido.' },
                'Usuario.PermissaoId': { required: 'Campo requerido.' },
                'Usuario.Imagem': { extension: 'Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).' }
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });
    });
</script>