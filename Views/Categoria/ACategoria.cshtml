@model CategoriaModel

@{
    ViewData["Titulo"] = "Adicionar categoria";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-theme-gray text-white d-flex align-items-center">
            <h5 class="mb-0">Cadastrar categoria</h5>
        </div>
        <div class="card-body">
            <form id="formCategoria" method="post" enctype="multipart/form-data" asp-controller="Categoria" asp-action="Adicionar">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Código -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="codigo" class="col-form-label">Código</label>
                    </div>
                    <div class="col-md-4">
                        <input type="text" value="@Model.ProximoCodigo" disabled />
                    </div>
                    <div class="col-md-6">
                        <span class="form-text">Código da categoria.</span>
                    </div>
                </div>

                <!-- Descrição -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="descricao" class="col-form-label">Descrição</label>
                    </div>
                    <div class="col-md-4">
                        <input id="descricao" type="text" asp-for="Descricao" required />
                    </div>
                    <div class="col-md-6">
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                        <span class="form-text">Campo para informar a descrição da categoria.</span>
                    </div>
                </div>

                <!-- Imagem -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="imagem" class="col-form-label">Imagem</label>
                    </div>
                    <div class="col-md-4">
                        <input type="file" id="imagem" name="imagemCategoria" accept="image/*" />
                    </div>
                    <div class="col-md-6">
                        <span class="form-text">Selecione a imagem da categoria caso necessário.</span>
                    </div>
                </div>

                <!-- Botões -->
                <div class="row">
                    <div class="d-flex justify-content-center mt-4">
                        <a class="button btn btn-warning" asp-controller="Categoria" asp-action="Index">
                            <span class="button__icon"><i class="bx bx-undo"></i></span>
                            <span class="button__text2">Voltar</span>
                        </a>
                        <button type="submit" class="button btn btn-success">
                            <span class="button__icon"><i class='bx bx-save'></i></span>
                            <span class="button__text2">Adicionar</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $.validator.addMethod("extension", function (value, element, param) {
            var extension = value.split('.').pop().toLowerCase();
            return this.optional(element) || param.split('|').indexOf(extension) !== -1;
        }, "Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).");

        $('#formCategoria').validate({
            rules: {
                'Descricao': { required: true },
                'imagemCategoria': { required: true, extension: "jpg|jpeg|png|gif|bmp" }
            },
            messages: {
                'Descricao': { required: 'Campo requerido.' },
                'imagemCategoria': { extension: 'Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).' }
            },
            errorPlacement: function (error, element) {
                // Insere o texto do erro como placeholder dentro do input
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");

                // Remove o placeholder ao corrigir o campo
                $(element).attr("placeholder", "");
            }
        });
    });
</script>