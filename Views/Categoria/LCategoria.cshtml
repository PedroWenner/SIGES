@using SIGES.Helpers
@using SIGES.ViewModel
@model CategoriaViewModel

@{
    ViewData["Titulo"] = "Categorias";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Categorias</h5>
    </div>
    <div class="col-lg-12" style="margin-left: 0">
        <div class="col-md-2">
            @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "aCategoria"))
            {
                <a role="button" class="button btn btn-mini btn-success w-100" asp-controller="Categoria" asp-action="Adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Categoria</span>
                </a>
            }
            else
            {
                <a role="button" class="button btn btn-mini btn-secondary disabled w-100" title="Você não tem permissão para adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Categoria</span>
                </a>
            }
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content table-responsive">
            <table id="tabela">
                <thead>
                    <tr>
                        <th>Cód</th>
                        <th>Descrição</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categorias == null || Model.Categorias.Count == 0)
                    {
                        <tr>
                            <td colspan="3">Nenhuma categoria cadastrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var categoria in Model.Categorias)
                        {
                            <tr>
                                <td>@categoria.Id</td>
                                <td>@categoria.Descricao</td>
                                <td>
                                    <a href="#" data-entidade="CategoriaModel" data-id="@categoria.Id" style="margin-right: 1%" class="btn-nwe7 btn-exibir-log text-decoration-none" title="Exibir histórico">
                                        <i class='bx bx-history'></i>
                                    </a>
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eCategoria"))
                                    {
                                        <a asp-controller="Categoria" asp-action="Editar" asp-route-id="@categoria.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none" title="Editar categoria">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "dCategoria"))
                                    {
                                        <a href="#modal-excluir" data-id="@categoria.Id" role="button" data-bs-target="#modal-excluir" data-bs-toggle="modal" style="margin-right: 1%" class="btn-nwe4 text-decoration-none" title="Excluir categoria">
                                            <i class="bx bx-trash-alt"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            
        </div>
    </div>
</div>

<!-- Modal excluir -->
<div id="modal-excluir" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Categoria" asp-action="Excluir">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Excluir categoria</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="idCategoria" name="id" />
                    <h6 style="text-align: center">
                        Deseja realmente excluir esta categoria e os dados associados a ela?
                    </h6>
                </div>
                <div class="modal-footer" style="display:flex;justify-content: center">
                    <button type="button" class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true">
                        <span class="button__icon"><i class="bx bx-x"></i></span>
                        <span class="button__text2">Cancelar</span>
                    </button>
                    <button type="submit" class="button btn btn-danger">
                        <span class="button__icon"><i class='bx bx-trash'></i></span>
                        <span class="button__text2">Excluir</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")

<script src="~/js/jquery.validate.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', 'a.btn-nwe4', function () {
            var categoriaId = $(this).data('id');
            $('#idCategoria').val(categoriaId);
        });
    });
</script>