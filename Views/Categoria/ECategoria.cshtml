@model CategoriaModel

@{
    ViewData["Titulo"] = "Editar categoria";
}

<style>
    input.is-invalid::placeholder {
        color: #dc3545; /* Vermelho para erro */
        opacity: 0.8; /* Garante que o placeholder seja totalmente visível */
        font-size: 12px;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Alteração de categoria</h5>
        </div>
        <div class="card-body">
            <form id="formCategoria" method="post" enctype="multipart/form-data" asp-controller="Categoria" asp-action="Editar">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Código -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="codigo" class="col-form-label">Código</label>
                    </div>
                    <div class="col-md-4">
                        <input type="text" asp-for="Id" disabled />
                        <input type="hidden" asp-for="Id" />
                    </div>
                    <div class="col-md-6">
                        <span class="form-text">Código da categoria.</span>
                    </div>
                </div>

                <!-- Descrição -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="descricao" class="col-form-label">Descrição</label>
                    </div>
                    <div class="col-md-4">
                        <input id="descricao" type="text" asp-for="Descricao" required />
                    </div>
                    <div class="col-md-6">
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                        <span class="form-text">Campo para informar a descrição da categoria.</span>
                    </div>
                </div>

                <!-- Imagem -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2 text-md-end">
                        <label for="imagem" class="col-form-label">Imagem</label>
                    </div>
                    <div class="col-md-4">
                        <input type="file" id="imagem" name="imagemCategoria" accept="image/*"
                            data-imagem-cadastrada="@(Model.ImagemBlob != null)" onchange="previewImage(event)" required />
                    </div>
                    <div class="col-md-6">
                        @if (Model.ImagemBlob != null)
                        {
                            <p class="form-text">Imagem cadastrada. Selecione uma nova imagem para substituir a existente.</p>
                        }
                        else
                        {
                            <span class="form-text text-warning">Nenhuma imagem cadastrada. É obrigatório adicionar uma imagem.</span>
                        }
                    </div>
                </div>

                <!-- Pré-visualização da imagem -->
                <div class="row mt-2 g-3 align-items-center text-center">
                    <div class="col-md-4 offset-md-4">
                        @if (Model.ImagemBlob != null)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(Model.ImagemBlob)" id="previewImg" class="img-fluid rounded w-100" alt="Imagem da categoria" />
                        }
                        else
                        {
                            <img src="" id="previewImg" class="img-fluid rounded w-100" alt="Pré-visualização da imagem" style="display:none;" />
                        }
                    </div>
                </div>

                <!-- Botões -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-2">
                        <a class="button btn btn-warning w-100" asp-controller="Categoria" asp-action="Index">
                            <span class="button__icon"><i class="bx bx-undo"></i></span>
                            <span class="button__text2">Voltar</span>
                        </a>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="button btn btn-success w-100">
                            <span class="button__icon"><i class='bx bx-save'></i></span>
                            <span class="button__text2">Atualizar</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script type="text/javascript">

    function previewImage(event) {
        const img = document.getElementById('previewImg');
        if (event.target.files.length > 0) {
            img.src = URL.createObjectURL(event.target.files[0]);
            img.onload = () => {
                URL.revokeObjectURL(img.src); // Libera memória
                img.style.display = "block";
            };
        } else {
            img.style.display = "none";
        }
    }

    $(document).ready(function () {
        $.validator.addMethod("extension", function (value, element, param) {
            var extension = value.split('.').pop().toLowerCase();
            return this.optional(element) || param.split('|').indexOf(extension) !== -1;
        }, "Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).");

        $('#formCategoria').validate({
            rules: {
                'Descricao': { required: true },
                'imagemCategoria': {
                    required: function (element) {
                        return $(element).data('imagem-cadastrada') === false;
                    },
                    extension: "jpg|jpeg|png|gif|bmp"
                }
            },
            messages: {
                'Descricao': { required: 'Campo requerido.' },
                'imagemCategoria': { extension: 'Por favor, insira uma imagem com uma extensão válida (jpg, jpeg, png, gif, bmp).' }
            },
            errorPlacement: function (error, element) {
                // Insere o texto do erro como placeholder dentro do input
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");

                // Remove o placeholder ao corrigir o campo
                $(element).attr("placeholder", "");
            }
        });
    });
</script>