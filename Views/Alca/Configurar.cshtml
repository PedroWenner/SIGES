@using System.Text.Json
@model Dictionary<string, string>
@{
    ViewData["Titulo"] = "Parâmetros do sistema";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
    .password-container {
        position: relative;
        width: fit-content;
    }

    .password-input {
        padding-right: 30px;
        width: 100%;
        border: 1px solid #ccc;
        border-radius: 5px;
        height: 35px;
    }

    .toggle-password {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #888;
    }

    .toggle-password:hover {
        color: #333;
    }
</style>

@{
    var osStatusSelecionados = Model.ContainsKey("os_status_list")
        ? JsonSerializer.Deserialize<List<string>>(Model["os_status_list"]) ?? new List<string>()
        : new List<string>();

    var opcoesStatus = new List<string>
    {
        "Aberto", "Faturado", "Negociação", "Em Andamento", "Orçamento",
        "Finalizado", "Cancelado", "Aguardando Peças", "Aprovado"
    };
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <h5 class="mb-0">Parâmetros do sistema</h5>
        </div>
        <div class="card-body">

            <ul class="nav nav-tabs" id="myTabParametros" role="tablist">
                <!-- gerais -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="navLinkGerais" data-bs-toggle="tab" data-bs-target="#geral-tab-pane" type="button" role="tab" aria-controls="geral-tab-pane" aria-selected="true">Gerais</button>
                </li>
                <!-- financeiros -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkFinanceiro" data-bs-toggle="tab" data-bs-target="#financeiro-tab-pane" type="button" role="tab" aria-controls="financeiro-tab-pane" aria-selected="false">Financeiro</button>
                </li>
                <!-- produtos -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkProduto" data-bs-toggle="tab" data-bs-target="#produto-tab-pane" type="button" role="tab" aria-controls="produto-tab-pane" aria-selected="false">Produtos</button>
                </li>
                <!-- notificacoes -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkNotificacao" data-bs-toggle="tab" data-bs-target="#notificacao-tab-pane" type="button" role="tab" aria-controls="notificacao-tab-pane" aria-selected="false">Notificações</button>
                </li>
                <!-- atualizacoes -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkAtualizacao" data-bs-toggle="tab" data-bs-target="#atualizacao-tab-pane" type="button" role="tab" aria-controls="atualizacao-tab-pane" aria-selected="false">Atualizações</button>
                </li>
                <!-- OS -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkOs" data-bs-toggle="tab" data-bs-target="#os-tab-pane" type="button" role="tab" aria-controls="os-tab-pane" aria-selected="false">OS</button>
                </li>
                <!-- API -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkApi" data-bs-toggle="tab" data-bs-target="#api-tab-pane" type="button" role="tab" aria-controls="api-tab-pane" aria-selected="false">API</button>
                </li>
                <!-- e-mail -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="navLinkEmail" data-bs-toggle="tab" data-bs-target="#email-tab-pane" type="button" role="tab" aria-controls="email-tab-pane" aria-selected="false">E-mail</button>
                </li>
            </ul>

            <form id="formConfigurar">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="tab-content">
                    <!-- gerais -->
                    <div class="tab-pane fade show active" id="geral-tab-pane" role="tabpanel" aria-labelledby="navLinkGerais" tabindex="0">
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="app_name" class="col-form-label">Nome do sistema</label>
                            </div>
                            <div class="col-md-4">
                                <input id="app_name" name="app_name" type="text" required value="@Model.GetValueOrDefault("app_name")" />
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Nome do sistema</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="app_theme" class="col-form-label">Tema do sistema</label>
                            </div>
                            <div class="col-md-4">
                                <select name="app_theme" id="app_theme">
                                    <option value="default" selected="@(Model.GetValueOrDefault("app_theme") == "default" ? true : false)">Escuro</option>
                                    <option value="white" selected="@(Model.GetValueOrDefault("app_theme") == "white" ? true : false)">Claro</option>
                                    <option value="puredark" selected="@(Model.GetValueOrDefault("app_theme") == "puredark" ? true : false)">Pure dark</option>
                                    <option value="darkorange" selected="@(Model.GetValueOrDefault("app_theme") == "darkorange" ? true : false)">Dark orange</option>
                                    <option value="darkviolet" selected="@(Model.GetValueOrDefault("app_theme") == "darkviolet" ? true : false)">Dark violet</option>
                                    <option value="whitegreen" selected="@(Model.GetValueOrDefault("app_theme") == "whitegreen" ? true : false)">White green</option>
                                    <option value="whiteblack" selected="@(Model.GetValueOrDefault("app_theme") == "whiteblack" ? true : false)">White black</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Selecione o tema que que deseja usar no sistema</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="per_page" class="form-label">Registros por página</label>
                            </div>
                            <div class="col-md-4">
                                <select name="per_page" id="theme">
                                    <option value="10" selected="@(Model.GetValueOrDefault("per_page") == "10" ? true : false)">10</option>
                                    <option value="20" selected="@(Model.GetValueOrDefault("per_page") == "20" ? true : false)">20</option>
                                    <option value="50" selected="@(Model.GetValueOrDefault("per_page") == "50" ? true : false)">50</option>
                                    <option value="100" selected="@(Model.GetValueOrDefault("per_page") == "100" ? true : false)">100</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Selecione quantos registros deseja exibir nas listas</span>
                            </div>
                        </div>
                    </div>

                    <!-- financeiros -->
                    <div class="tab-pane fade" id="financeiro-tab-pane" role="tabpanel" aria-labelledby="navLinkFinanceiro" tabindex="1">
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="control_baixa" class="col-form-label">Controle de baixa retroativa</label>
                            </div>
                            <div class="col-md-4">
                                <select name="control_baixa" id="control_baixa">
                                    <option value="1" selected="@(Model.GetValueOrDefault("control_baixa") == "1" ? true : false)">Ativar</option>
                                    <option value="0" selected="@(Model.GetValueOrDefault("control_baixa") == "0" ? true : false)">Desativar</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Ativar ou desativar o controle de baixa financeira, com data retroativa.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="control_editos" class="col-form-label">Controle de edição de OS</label>
                            </div>
                            <div class="col-md-4">
                                <select name="control_editos" id="control_editos">
                                    <option value="1" selected="@(Model.GetValueOrDefault("control_editos") == "1" ? true : false)">Ativar</option>
                                    <option value="0" selected="@(Model.GetValueOrDefault("control_editos") == "0" ? true : false)">Desativar</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Ativar ou desativar a permissão para alterar ou excluir OS faturada e/ou cancelada.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="control_edit_vendas" class="form-label">Controle de edição de vendas</label>
                            </div>
                            <div class="col-md-4">
                                <select name="control_edit_vendas" id="control_edit_vendas">
                                    <option value="1" selected="@(Model.GetValueOrDefault("control_edit_vendas") == "1" ? true : false)">Ativar</option>
                                    <option value="0" selected="@(Model.GetValueOrDefault("control_edit_vendas") == "0" ? true : false)">Desativar</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Ativar ou desativar a permissão para alterar ou excluir vendas faturada.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="pix_key" class="form-label">Chave pix para recebimento de pagamentos</label>
                            </div>
                            <div class="col-md-4">
                                <input id="pix_key" name="pix_key" type="text" value="@Model.GetValueOrDefault("pix_key")" />
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Chave pix para recebimento de pagamentos.</span>
                            </div>
                        </div>

                        <hr>
                        <!-- Configrações do EFI -->
                        <h6>Configrações do EFI (antiga GerenciaNet)</h6>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="EFI_PRODUCTION" class="form-label">Ambiente</label>
                            </div>
                            <div class="col-md-4">
                                <select name="PAYMENT_GATEWAYS_EFI_PRODUCTION" id="EFI_PRODUCTION">
                                    <option value="false" selected="@(Model.GetValueOrDefault("PAYMENT_GATEWAYS_EFI_PRODUCTION") == "false" ? true : false)">Sandbox</option>
                                    <option value="true" selected="@(Model.GetValueOrDefault("PAYMENT_GATEWAYS_EFI_PRODUCTION") == "true" ? true : false)">Produção</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Sandbox é um ambiente para testes.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="EFI_CREDENTIAIS_CLIENT_ID" class="form-label">CLIENT_ID</label>
                            </div>
                            <div class="col-md-4">
                                <input id="EFI_CREDENTIAIS_CLIENT_ID" name="PAYMENT_GATEWAYS_EFI_CREDENTIAIS_CLIENT_ID" type="text" value="@Model.GetValueOrDefault("PAYMENT_GATEWAYS_EFI_CREDENTIAIS_CLIENT_ID")" />
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Pode ser encontrado no menu <a href="https://app.sejaefi.com.br/api/aplicacoes" target="_blank" rel="noopener noreferrer">"API" -> "Aplicações"</a>.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="EFI_CREDENTIAIS_CLIENT_SECRET" class="form-label">CLIENT_SECRET</label>
                            </div>
                            <div class="col-md-4">
                                <div class="password-container">
                                    <input id="EFI_CREDENTIAIS_CLIENT_SECRET" name="PAYMENT_GATEWAYS_EFI_CREDENTIAIS_CLIENT_SECRET" type="password" value="@Model.GetValueOrDefault("PAYMENT_GATEWAYS_EFI_CREDENTIAIS_CLIENT_SECRET")" class="password-input" />
                                    <i class="fa fa-eye toggle-password" onclick="togglePassword('EFI_CREDENTIAIS_CLIENT_SECRET')"></i>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Pode ser encontrado no menu <a href="https://app.sejaefi.com.br/api/aplicacoes" target="_blank" rel="noopener noreferrer">"API" -> "Aplicações"</a>.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="EFI_BOLETO_EXPIRATION" class="form-label">Dias para vencimento do boleto</label>
                            </div>
                            <div class="col-md-4">
                                <select name="PAYMENT_GATEWAYS_EFI_BOLETO_EXPIRATION" id="EFI_BOLETO_EXPIRATION">
                                    @for (int i = 1; i <= 30; i++)
                                    {
                                        <option value="@i" selected="@(Model.GetValueOrDefault("PAYMENT_GATEWAYS_EFI_BOLETO_EXPIRATION") == i.ToString() ? true : false)">@i dia@(i > 1 ? "s" : "")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">A quantidade de dias selecionado será somado a data que a cobrança for gerada.</span>
                            </div>
                        </div>

                        <hr />
                        <!-- Configrações do Mercado Pago -->
                        <h6>Configrações do mercado pago</h6>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="MERCADO_PAGO_CREDENTIALS_PUBLIC_KEY" class="form-label">PUBLIC_KEY</label>
                            </div>
                            <div class="col-md-4">
                                <input id="MERCADO_PAGO_CREDENTIALS_PUBLIC_KEY" name="PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_PUBLIC_KEY" type="text" value="@Model.GetValueOrDefault("PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_PUBLIC_KEY")" />
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Pode ser encontrado no menu <a href="https://www.mercadopago.com.br/settings/account/credentials" target="_blank" rel="noopener noreferrer">"Seu Negócio" -> "Configurações" -> "Credenciais"</a>.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="MERCADO_PAGO_CREDENTIALS_ACCESS_TOKEN" class="form-label">ACCESS_TOKEN</label>
                            </div>
                            <div class="col-md-4">
                                <input id="MERCADO_PAGO_CREDENTIALS_ACCESS_TOKEN" name="PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_ACCESS_TOKEN" type="text"
                                    value="@Model.GetValueOrDefault("PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_ACCESS_TOKEN")" />
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Pode ser encontrado no menu <a href="https://www.mercadopago.com.br/settings/account/credentials" target="_blank" rel="noopener noreferrer">"Seu Negócio" -> "Configurações" -> "Credenciais"</a>.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="MERCADO_PAGO_CREDENTIALS_CLIENT_ID" class="form-label">CLIENT_ID</label>
                            </div>
                            <div class="col-md-4">
                                <input id="MERCADO_PAGO_CREDENTIALS_CLIENT_ID" name="PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_CLIENT_ID" type="text"
                                       value="@Model.GetValueOrDefault("PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_CLIENT_ID")" />
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Pode ser encontrado no menu <a href="https://www.mercadopago.com.br/settings/account/credentials" target="_blank" rel="noopener noreferrer">"Seu Negócio" -> "Configurações" -> "Credenciais"</a>.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="MERCADO_PAGO_CREDENTIALS_CLIENT_SECRET" class="form-label">CLIENT_SECRET</label>
                            </div>
                            <div class="col-md-4">
                                <div class="password-container">
                                    <input id="MERCADO_PAGO_CREDENTIALS_CLIENT_SECRET" name="PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_CLIENT_SECRET" type="password"
                                           value="@Model.GetValueOrDefault("PAYMENT_GATEWAYS_MERCADO_PAGO_CREDENTIALS_CLIENT_SECRET")" class="password-input" />
                                    <i class="fa fa-eye toggle-password" onclick="togglePassword('MERCADO_PAGO_CREDENTIALS_CLIENT_SECRET')"></i>
                                </div>
                                
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Pode ser encontrado no menu <a href="https://www.mercadopago.com.br/settings/account/credentials" target="_blank" rel="noopener noreferrer">"Seu Negócio" -> "Configurações" -> "Credenciais"</a>.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="MERCADO_PAGO_BOLETO_EXPIRATION" class="form-label">Dias para vencimento do boleto</label>
                            </div>
                            <div class="col-md-4">
                                <select name="PAYMENT_GATEWAYS_MERCADO_PAGO_BOLETO_EXPIRATION" id="MERCADO_PAGO_BOLETO_EXPIRATION">
                                    @for (int i = 1; i <= 30; i++)
                                    {
                                        <option value="@i" selected="@(Model.GetValueOrDefault("PAYMENT_GATEWAYS_MERCADO_PAGO_BOLETO_EXPIRATION") == i.ToString() ? true : false)">@i dia@(i > 1 ? "s" : "")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">A quantidade de dias selecionado será somado a data que a cobrança for gerada.</span>
                            </div>
                        </div>

                        <hr>
                        <!-- Configrações do ASAAS -->
                        <h6>Configrações do ASAAS</h6>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="ASAAS_PRODUCTION" class="form-label">Ambiente</label>
                            </div>
                            <div class="col-md-4">
                                <select name="PAYMENT_GATEWAYS_ASAAS_PRODUCTION" id="ASAAS_PRODUCTION">
                                    <option value="false" selected="@(Model.GetValueOrDefault("PAYMENT_GATEWAYS_ASAAS_PRODUCTION") == "false" ? true : false)">Sandbox</option>
                                    <option value="true" selected="@(Model.GetValueOrDefault("PAYMENT_GATEWAYS_ASAAS_PRODUCTION") == "true" ? true : false)">Produção</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Sandbox é um ambiente para testes.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="ASAAS_NOTIFY" class="form-label">Notify</label>
                            </div>
                            <div class="col-md-4">
                                <select name="PAYMENT_GATEWAYS_ASAAS_NOTIFY" id="ASAAS_NOTIFY">
                                    <option value="false" selected="@(Model.GetValueOrDefault("PAYMENT_GATEWAYS_ASAAS_NOTIFY") == "false" ? true : false)">Desativado</option>
                                    <option value="true" selected="@(Model.GetValueOrDefault("PAYMENT_GATEWAYS_ASAAS_NOTIFY") == "false" ? true : false)">Ativado</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Ativar ou desativar o Notify do Asaas.</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="ASAAS_CREDENTIAIS_API_KEY" class="form-label">API_KEY</label>
                            </div>
                            <div class="col-md-4">
                                <input id="ASAAS_CREDENTIAIS_API_KEY" name="PAYMENT_GATEWAYS_ASAAS_CREDENTIAIS_API_KEY" type="text"
                                       value="@Model.GetValueOrDefault("PAYMENT_GATEWAYS_ASAAS_CREDENTIAIS_API_KEY")" />
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Pode ser encontrado no menu "Minha Conta", clique em "Integração" e depois em "Gerar API Key".</span>
                            </div>
                        </div>
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="ASAAS_BOLETO_EXPIRATION" class="form-label">Notify</label>
                            </div>
                            <div class="col-md-4">
                                <select name="PAYMENT_GATEWAYS_ASAAS_BOLETO_EXPIRATION" id="ASAAS_BOLETO_EXPIRATION">
                                    @for (int i = 1; i <= 30; i++)
                                    {
                                        <option value="@i" selected="@(Model.GetValueOrDefault("PAYMENT_GATEWAYS_ASAAS_BOLETO_EXPIRATION") == i.ToString() ? true : false)">@i dia@(i > 1 ? "s" : "")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">A quantidade de dias selecionado será somado a data que a cobrança for gerada.</span>
                            </div>
                        </div>
                    </div>

                    <!-- produtos -->
                    <div class="tab-pane fade" id="produto-tab-pane" role="tabpanel" aria-labelledby="navLinkProduto" tabindex="2">
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="control_estoque" class="col-form-label">Controlar estoque</label>
                            </div>
                            <div class="col-md-4">
                                <select name="control_estoque" id="control_estoque">
                                    <option value="1" selected="@(Model.GetValueOrDefault("control_estoque") == "1" ? true : false)">Ativar</option>
                                    <option value="0" selected="@(Model.GetValueOrDefault("control_estoque") == "0" ? true : false)">Desativar</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <span class="form-text">Ativar ou desativar o controle de estoque.</span>
                            </div>
                        </div>
                    </div>

                    <!-- notificacoes -->
                    <div class="tab-pane fade" id="notificacao-tab-pane" role="tabpanel" aria-labelledby="navLinkNotificacao" tabindex="3">
                        <div class="row mt-2 g-3 align-items-center">
                            <div class="col-md-2 text-md-end">
                                <label for="os_notification" class="col-form-label">Notificação de OS</label>
                            </div>
                            <div class="col-md-4">
                                <select name="os_notification" id="os_notification">
                                    <option selected="@(Model.GetValueOrDefault("os_notification") == "todos" ? true : false)" value="todos">Notificar a Todos</option>
