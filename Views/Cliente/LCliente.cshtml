@using SIGES.Helpers
@using SIGES.ViewModel
@model ClienteViewModel

@{
    ViewData["Titulo"] = "Clientes";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Clientes</h5>
    </div>
    <div class="col-lg-12" style="margin-left: 0">
        <div class="col-md-3">
            @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "aCliente"))
            {
                <a role="button" class="button btn btn-mini btn-success" style="max-width: 100px" asp-controller="Cliente" asp-action="Adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Cliente</span>
                </a>
            }
            else
            {
                <a role="button" class="button btn btn-mini btn-secondary disabled" style="max-width: 100px" title="Você não tem permissão para adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Cliente</span>
                </a>
            }
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content">
            <table id="tabela">
                <thead>
                    <tr>
                        <th class="cabecalho">Cod.</th>
                        <th>Nome</th>
                        <th>CPF/CNPJ</th>
                        <th>Celular</th>
                        <th>Email</th>
                        <th>Fornecedor</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Clientes == null || Model.Clientes.Count == 0)
                    {
                        <tr>
                            <td colspan="9">Nenhum cliente cadastrado</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cliente in Model.Clientes)
                        {
                            <tr>
                                <td style="width: 5%; text-align: center;">@cliente.Id</td>
                                <td style="width: 30%;">@cliente.Nome</td>
                                <td style="width: 10%;">@cliente.Documento</td>
                                <td style="width: 10%;">@cliente.Celular</td>
                                <td style="width: 20%;">@cliente.Email</td>
                                <td style="width: 10%;">@(cliente.Fornecedor.Equals(0) ? "Não" : "Sim")</td>
                                <td style="width: 15%;">
                                    <a href="#" data-entidade="ClienteModel" data-id="@cliente.Id" style="margin-right: 1%" class="btn-nwe7 btn-exibir-log text-decoration-none" title="Exibir histórico">
                                        <i class='bx bx-history'></i>
                                    </a>
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "eCliente"))
                                    {
                                        <a asp-controller="Cliente" asp-action="Editar" asp-route-id="@cliente.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none" title="Editar cliente">
                                            <i class="bx bx-edit bx-xs"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a role="button" class="btn-nwe3-disabled text-decoration-none disabled" style="margin-right: 1%" title="Você não tem permissão para editar">
                                            <i class="bx bx-edit bx-xs"></i>
                                        </a>
                                    }
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "dCliente"))
                                    {
                                        <a href="#modal-excluir" data-id="@cliente.Id" role="button" data-bs-target="#modal-excluir" data-bs-toggle="modal" style="margin-right: 1%" class="btn-nwe4 text-decoration-none" title="Excluir cliente">
                                            <i class="bx bx-trash-alt bx-xs"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a role="button" class="btn-nwe3-disabled text-decoration-none disabled" style="margin-right: 1%" title="Você não tem permissão para excluir">
                                            <i class="bx bx-trash-alt bx-xs"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<!-- Modal excluir -->
<div id="modal-excluir" class="modal fade" tabindex="-1" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Cliente" asp-action="Excluir">
                <div class="modal-header">
                    <h5 class="modal-title fs-5">Excluir cliente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="idCliente" name="id" />
                    <h6 style="text-align: center">
                        Deseja realmente excluir este cliente?
                    </h6>
                </div>
                <div class="modal-footer" style="display:flex;justify-content: center">
                    <button type="button" class="button btn btn-warning" data-bs-dismiss="modal" aria-hidden="true">
                        <span class="button__icon"><i class="bx bx-x"></i></span>
                        <span class="button__text2">Cancelar</span>
                    </button>
                    <button type="submit" class="button btn btn-danger">
                        <span class="button__icon"><i class='bx bx-trash'></i></span>
                        <span class="button__text2">Excluir</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")

<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', 'a.btn-nwe4', function () {
            var id = $(this).data('id');
            $('#idCliente').val(id);
        });
    });
</script>