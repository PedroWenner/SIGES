@model ClienteModel

@{
    ViewData["Titulo"] = "Adicionar cliente";
}
<script src="~/js/funcoes.js"></script>

<style>
    .password-container {
        position: relative;
        width: fit-content;
    }

    .password-input {
        padding-right: 30px;
        width: 100%;
        border: 1px solid #ccc;
        border-radius: 5px;
        height: 35px;
    }

    .toggle-password {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #888;
    }

    .toggle-password:hover {
        color: #333;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-theme-gray text-white d-flex align-items-center">
            <h5 class="mb-0">Cadastrar cliente</h5>
        </div>
        <div class="card-body">
            <form id="formCliente" method="post" asp-controller="Cliente" asp-action="Adicionar">

                <!-- CPF/CNPJ -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-6">
                        <div class="row">
                            <div class="col-md-2 text-md-end">
                                <label for="documento" class="col-form-label">CPF/CNPJ</label>
                            </div>
                            <div class="col-md-6">
                                <input id="documento" type="text" asp-for="Documento" class="cpfcnpj" required>
                                <span asp-validation-for="Documento" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <button id="buscar_info_cnpj" class="btn btn-sm btn-secondary" type="button">Buscar(CNPJ)</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nome/Razão Social -->
                <div class="row mt-2 g-3 align-items-center">
                    <div class="col-md-1 text-md-end">
                        <label for="nomeCliente" class="col-form-label">Nome/Razão Social</label>
                    </div>
                    <div class="col-md-7">
                        <input id="nomeCliente" type="text" asp-for="Nome" required />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Telefone -->
                    <div class="col-md-1 text-md-end">
                        <label for="telefone" class="col-form-label">Telefone</label>
                    </div>
                    <div class="col-md-2">
                        <input id="telefone" type="text" asp-for="Telefone" />
                        <span asp-validation-for="Telefone" class="text-danger"></span>
                    </div>

                    <!-- Celular -->
                    <div class="col-md-1 text-md-end">
                        <label for="celular" class="col-form-label">Celular</label>
                    </div>
                    <div class="col-md-2">
                        <input id="celular" type="text" asp-for="Celular" />
                        <span asp-validation-for="Celular" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Email -->
                    <div class="col-md-1 text-md-end">
                        <label for="email" class="col-form-label">E-mail</label>
                    </div>
                    <div class="col-md-7">
                        <input id="email" type="email" asp-for="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- CEP -->
                    <div class="col-md-1 text-md-end">
                        <label for="cep" class="col-form-label">CEP</label>
                    </div>
                    <div class="col-md-2">
                        <input id="cep" type="text" asp-for="Cep" />
                        <span asp-validation-for="Cep" class="text-danger"></span>
                    </div>

                    <!-- Rua -->
                    <div class="col-md-1 text-md-end">
                        <label for="rua" class="col-form-label">Rua</label>
                    </div>
                    <div class="col-md-4">
                        <input id="rua" type="text" asp-for="Rua" />
                        <span asp-validation-for="Rua" class="text-danger"></span>
                    </div>

                    <!-- Número -->
                    <div class="col-md-1 text-md-end">
                        <label for="numeroRua" class="col-form-label">Número</label>
                    </div>
                    <div class="col-md-3">
                        <input id="numeroRua" type="text" asp-for="NumeroRua" />
                        <span asp-validation-for="NumeroRua" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Bairro -->
                    <div class="col-md-1 text-md-end">
                        <label for="bairro" class="col-form-label">Bairro</label>
                    </div>
                    <div class="col-md-3">
                        <input id="bairro" type="text" asp-for="Bairro" />
                        <span asp-validation-for="Bairro" class="text-danger"></span>
                    </div>

                    <!-- Cidade -->
                    <div class="col-md-1 text-md-end">
                        <label for="cidade" class="col-form-label">Cidade</label>
                    </div>
                    <div class="col-md-3">
                        <input id="cidade" type="text" asp-for="Cidade" />
                        <span asp-validation-for="Cidade" class="text-danger"></span>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-1 text-md-end">
                        <label for="estado" class="col-form-label">Estado</label>
                    </div>
                    <div class="col-md-3">
                        <select id="estado" asp-for="Estado">
                            <option value="">Selecione...</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Complemento -->
                    <div class="col-md-1 text-md-end">
                        <label for="complemento" class="col-form-label">Complemento</label>
                    </div>
                    <div class="col-md-7">
                        <input id="complemento" type="text" asp-for="Complemento" />
                        <span asp-validation-for="Complemento" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Senha -->
                    <div class="col-md-1 text-md-end">
                        <label for="senha" class="col-form-label">Senha</label>
                    </div>
                    <div class="col-md-2">
                        <div class="password-container">
                            <input id="senha" type="password" asp-for="Senha" />
                            <i class="fa fa-eye toggle-password" onclick="togglePassword('senha')"></i>
                        </div>
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>
                    <div class="col-md-9">
                        <span class="form-text">Essa senha será a que o cliente utilizará para acessar o painel do cliente.</span>
                    </div>
                </div>

                <div class="row mt-2 g-3 align-items-center">
                    <!-- Tipo de Cliente -->
                    <div class="col-md-1 text-md-end">
                    </div>
                    <div class="col-md-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" name="Fornecedor" value="0" id="fornecedor">
                            <label class="form-check-label" for="fornecedor">
                                Fornecedor
                            </label>
                        </div>
                        <span asp-validation-for="Fornecedor" class="text-danger"></span>
                    </div>
                    <div class="col-md-9">
                        <span class="form-text">Clientes marcados como fornecedor, será apresentado ao realizar lançamento de despesas.</span>
                    </div>
                </div>

                <!-- Botões -->
                <div class="row">
                    <div class="d-flex justify-content-center mt-4">
                        <a class="button btn btn-warning" asp-controller="Cliente" asp-action="Index">
                            <span class="button__icon"><i class="bx bx-undo"></i></span>
                            <span class="button__text2">Voltar</span>
                        </a>
                        <button type="submit" class="button btn btn-success">
                            <span class="button__icon"><i class='bx bx-save'></i></span>
                            <span class="button__text2">Adicionar</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/jquery.validate.js"></script>
<script type="text/javascript">

    function togglePassword(id) {
        var input = document.getElementById(id);
        var icon = document.querySelector(".toggle-password");
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }

    $(document).ready(function () {
        // Carrega os estados do arquivo JSON
        $.getJSON('@Url.Content("~/json/estados.json")', function (data) {
            if (data && data.estados && data.estados.length > 0) {
                for (var i = 0; i < data.estados.length; i++) {
                    $('#estado').append(new Option(data.estados[i].nome, data.estados[i].sigla));
                }
            } else {
                console.error('Arquivo JSON não possui as medidas esperadas.');
            }
        });

        $("#nomeCliente").focus();

        $('#formCliente').validate({
            rules: {
                'Nome': { required: true },
                'Documento': { required: true },
                'Email' : { email: true }
            },
            messages: {
                'Nome': { required: 'Campo requerido.' },
                'Documento': { required: 'Campo requerido.' },
                'Email' : { email: 'Informe um e-mail válido.' }
            },
            errorPlacement: function (error, element) {
                element.attr("placeholder", error.text());
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass("is-invalid").addClass("is-valid");
                $(element).attr("placeholder", "");
            }
        });

        $('#fornecedor').change(function () {
            $(this).val(this.checked ? "1" : "0");
        });
    });
</script>