@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <title>SIGES - Login</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="@Url.Content("~/bootstrap-5.3.3/css/bootstrap.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/matrix-login.css")" />
    <link href="@Url.Content("~/font-awesome/css/font-awesome.css")" rel="stylesheet" />
    <link rel="shortcut icon" type="image/png" href="~/img/AlcaLogo1.png" />

    <script src="@Url.Content("~/js/jquery-3.7.1.min.js")"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="@Url.Content("~/js/sweetalert.min.js")"></script>

    <style>
        input::placeholder {
            color: white;
        }

        input.is-invalid::placeholder {
            color: #dc3545;
            opacity: 0.8;
            font-size: 12px;
        }
    </style>
</head>

<body>
    <div class="main-login">
        <div class="left-login">
            <h1 class="h-one text-black">
                @if (DateTime.Now.Hour >= 0 && DateTime.Now.Hour < 12)
                {
                    <text>Olá! Bom dia!</text>
                }
                else if (DateTime.Now.Hour >= 12 && DateTime.Now.Hour < 18)
                {
                    <text>Olá! Boa tarde!</text>
                }
                else
                {
                    <text>Olá! Boa noite!</text>
                }
            </h1>
            <br />
            <h2 class="h-two">Seja bem-vindo ao sistema de controle</h2>
            <img src="@Url.Content("~/img/dashboard-animate.svg")" class="left-login-image" alt="Sistema de controle">
        </div>

        <form class="form-vertical" id="formLogin" method="post" asp-controller="Login" asp-action="Login">
            <div class="d-flex flex-column">
                <div class="right-login">
                    <div class="container">
                        <div class="card">
                            <div class="content">
                                <div id="mcell">
                                    <img src="~/img/AlcaLogo1.png" />
                                    <p class="text-black">Versão: 1.0</p>
                                </div>
                                <div class="input-field mb-2">
                                    <label class="fas fa-user" for="email"></label>
                                    <input id="email" name="login" type="text" class="form-control form-control-sm" placeholder="E-mail" required />
                                </div>
                                <div class="input-field">
                                    <label class="fas fa-lock" for="senha"></label>
                                    <input id="senha" name="senha" type="password" class="form-control form-control-sm" placeholder="Senha" required />
                                </div>
                                <div class="center">
                                    <button id="btn-acessar" class="btn btn-primary" type="submit">Acessar</button>
                                </div>
                                <div class="links-uteis">
                                    <p class="text-black">@DateTime.Now.Year &copy; SIGES</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        @if (TempData["Error"] != null)
        {
            <script type="text/javascript">
                Swal.fire({
                    position: 'center',
                    icon: 'error',
                    text: '@Html.Raw(TempData["Error"])',
                    showConfirmButton: true,
                    timer: 4000
                });
            </script>
        }
    </div>

    <script src="~/bootstrap-5.3.3/js/bootstrap.bundle.js"></script>
    <script src="~/js/jquery.validate.js"></script>

    <script>
        $(document).ready(function () {
            $('#formLogin').validate({
                rules: {
                    login: {
                        required: true
                    },
                    senha: {
                        required: true
                    }
                },
                messages: {
                    login: {
                        required: 'Por favor, insira o usuário.'
                    },
                    senha: {
                        required: 'Por favor, insira sua senha.'
                    }
                },
                submitHandler: function(form) {
                    var dados = $(form).serialize();
                    $('#btn-acessar').addClass('disabled').text('Aguarde...');

                    $.ajax({
                        type: "POST",
                        url: "/Login/Autenticar",
                        data: dados,
                        dataType: 'json',
                        success: function (data) {
                            if (data.sucesso) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Login realizado com sucesso!',
                                    text: 'Redirecionando o acesso. Por favor aguarde um momento...',
                                    timer: 2000,
                                    showConfirmButton: false
                                });

                                setTimeout(function () {
                                    window.location.href = "/Home/Index";
                                }, 2000);
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Erro ao fazer login',
                                    text: data.mensagem
                                });

                                $('#btn-acessar').removeClass('disabled').text('Acessar');
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Erro no servidor',
                                text: 'Tente novamente mais tarde.'
                            });

                            $('#btn-acessar').removeClass('disabled').text('Acessar');
                        }
                    });

                    return false;
                },
                errorPlacement: function (error, element) {
                    element.attr("placeholder", error.text());
                },
                highlight: function (element, errorClass, validClass) {
                    $(element).addClass("is-invalid").removeClass("is-valid");
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).removeClass("is-invalid").addClass("is-valid");
                    $(element).attr("placeholder", "");
                }
            });
        });
    </script>
</body>
</html>