<!--Cards-->
<ul class="row g-3 cardBox list-unstyled">

    <li class="col-12 card">
        <div class="grid-blak h-100">
            <a href="#" class="text-decoration-none" title="Pedidos">
                <div class="text-center">
                    <div class="numbers N-tittle">Pedidos</div>
                    <div class="cardName">F1</div>
                </div>
            </a>
        </div>
        <a href="#" class="text-decoration-none" title="Pedidos">
            <div class="lord-icon01 p-3">
                <i class="bx bx-bar-chart-alt-2 iconBx06"></i>
            </div>
        </a>
    </li>

    <li class="col-12 card">
        <div class="grid-blak h-100">
            <a asp-controller="Produto" asp-action="Index" class="text-decoration-none" title="Produtos">
                <div class="text-center">
                    <div class="numbers N-tittle">Produtos</div>
                    <div class="cardName">F2</div>
                </div>
            </a>
        </div>
        <a asp-controller="Produto" asp-action="Index" class="text-decoration-none" title="Produtos">
            <div class="lord-icon02 p-3">
                <i class="bx bx-bar-chart-alt-2 iconBx02"></i>
            </div>
        </a>
    </li>

    <li class="col-12 card">
        <div class="grid-blak h-100">
            <a asp-controller="Cliente" asp-action="Index" class="text-decoration-none" title="Clientes">
                <div class="text-center">
                    <div class="numbers N-tittle">Clientes</div>
                    <div class="cardName">F3</div>
                </div>
            </a>
        </div>
        <a asp-controller="Cliente" asp-action="Index" class="text-decoration-none" title="Clientes">
            <div class="lord-icon03 p-3">
                <i class="bx bx-user iconBx03"></i>
            </div>
        </a>
    </li>

    <li class="col-12 card">
        <div class="grid-blak h-100">
            <a asp-controller="Usuario" asp-action="Index" class="text-decoration-none" title="Usuários">
                <div class="text-center">
                    <div class="numbers N-tittle">Usuários</div>
                    <div class="cardName">F6</div>
                </div>
            </a>
        </div>
        <a asp-controller="Usuario" asp-action="Index" class="text-decoration-none" title="Usuários">
            <div class="lord-icon05 p-3">
                <i class="bx bx-group iconBx05"></i>
            </div>
        </a>
    </li>

</ul>
<!--End Cards-->

<div class="row-fluid" style="margin-top: 0; display: flex">
    <div class="Sspan12">
        <div class="widget-box2" style="height: 300px; overflow-x: auto;">
            <div>
                <h5 class="cardHeader">OS em aberto</h5>
            </div>
            <div class="widget-content">
                <table>
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Cliente</th>
                            <th style="text-align: center;">Qtd</th>
                            <th style="text-align: center;">Valor</th>
                            <th>Solicitado em</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Os == null || Model.Os.Count == 0)
                        {
                            <tr>
                                <td colspan="7">Nenhuma OS cadastrada</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var os in Model.Os)
                            {
                                <tr>
                                    <td style="width: 5%; text-align: center;">@os.Id</td>
                                    <td style="width: 50%;">@os.Cliente.Nome</td>
                                    <td style="width: 10%;"><span class="badge">@os.Status</span></td>
                                    <td style="width: 10%;"></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="new-statisc">
            <div class="widget-box-new widbox-blak" style="height:100%">
                <div>
                    <h5 class="cardHeader">Estatísticas</h5>
                </div>
                <div class="new-bottons">
                    <a href="#" class="card tip-top text-decoration-none" title="Add clientes e fornecedores">
                        <div><i class='bx bxs-group iconBx'></i></div>
                        <div>
                            <div class="cardName2">@Model.Clientes.Count()</div>
                            <div class="cardName">Clientes</div>
                        </div>
                    </a>

                    <a href="#" class="card tip-top text-decoration-none" title="Adicionar produtos">
                        <div><i class='bx bxs-package iconBx2'></i></div>
                        <div>
                            <div class="cardName2">@Model.Produtos.Count()</div>
                            <div class="cardName">Produtos</div>
                        </div>
                    </a>

                    <a href="#" class="card tip-top text-decoration-none" title="Adicionar pedido">
                        <div><i class='bx bxs-cart-alt iconBx5'></i></div>
                        <div>
                            <div class="cardName2">@Model.Os.Count()</div>
                            <div class="cardName">Pedidos</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="span12A" style="margin-left: 0">
    <div class="widget-box0 widbox-blak" style="height: 300px; overflow-x: auto;">
