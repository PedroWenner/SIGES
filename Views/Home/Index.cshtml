                        <th>Solicitado em</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="7">Nenhum pedido entregue</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>