<!--Cards-->
<ul class="row g-3 cardBox list-unstyled">

    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vCliente"))
    {
        <li class="col-12 card">
            <div class="grid-blak h-100">
                <a asp-controller="Cliente" asp-action="Index" class="text-decoration-none" title="Clientes">
                    <div class="text-center">
                        <div class="numbers N-tittle">Clientes</div>
                        <div class="cardName">F1</div>
                    </div>
                </a>
            </div>
            <a asp-controller="Cliente" asp-action="Index" class="text-decoration-none" title="Clientes">
                <div class="lord-icon01 p-3">
                    <i class="bx bx-user iconBx02"></i>
                </div>
            </a>
        </li>
    }

    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vProduto"))
    {
        <li class="col-12 card">
            <div class="grid-blak h-100">
                <a asp-controller="Produto" asp-action="Index" class="text-decoration-none" title="Produtos">
                    <div class="text-center">
                        <div class="numbers N-tittle">Produtos</div>
                        <div class="cardName">F2</div>
                    </div>
                </a>
            </div>
            <a asp-controller="Produto" asp-action="Index" class="text-decoration-none" title="Produtos">
                <div class="lord-icon02 p-3">
                    <i class="bx bx-basket iconBx02"></i>
                </div>
            </a>
        </li>
    }

    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vServico"))
    {
        <li class="col-12 card">
            <div class="grid-blak h-100">
                <a asp-controller="Servico" asp-action="Index" class="text-decoration-none" title="Serviços">
                    <div class="text-center">
                        <div class="numbers N-tittle">Serviços</div>
                        <div class="cardName">F3</div>
                    </div>
                </a>
            </div>
            <a asp-controller="Servico" asp-action="Index" class="text-decoration-none" title="Serviços">
                <div class="lord-icon03 p-3">
                    <i class="bx bx-wrench iconBx03"></i>
                </div>
            </a>
        </li>
    }

    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vOs"))
    {
        <li class="col-12 card">
            <div class="grid-blak h-100">
                <a asp-controller="Os" asp-action="Index" class="text-decoration-none" title="Ordens">
                    <div class="text-center">
                        <div class="numbers N-tittle">Ordens</div>
                        <div class="cardName">F4</div>
                    </div>
                </a>
            </div>
            <a asp-controller="Os" asp-action="Index" class="text-decoration-none" title="Ordens">
                <div class="lord-icon04 p-3">
                    <i class="bx bx-file iconBx04"></i>
                </div>
            </a>
        </li>
    }

    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vVenda"))
    {
        <li class="col-12 card">
            <div class="grid-blak h-100">
                <a asp-controller="Venda" asp-action="Index" class="text-decoration-none" title="Vendas">
                    <div class="text-center">
                        <div class="numbers N-tittle">Vendas</div>
                        <div class="cardName">F5</div>
                    </div>
                </a>
            </div>
            <a asp-controller="Venda" asp-action="Index" class="text-decoration-none" title="Vendas">
                <div class="lord-icon05 p-3">
                    <i class="bx bx-cart-alt iconBx05"></i>
                </div>
            </a>
        </li>
    }

    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "vLancamento"))
    {
        <li class="col-12 card">
            <div class="grid-blak h-100">
                <a href="#" class="text-decoration-none" title="Lançamentos">
                    <div class="text-center">
                        <div class="numbers N-tittle">Lançamentos</div>
                        <div class="cardName">F6</div>
                    </div>
                </a>
            </div>
            <a href="#" class="text-decoration-none" title="Lançamentos">
                <div class="lord-icon06 p-3">
                    <i class="bx bx-bar-chart-alt-2 iconBx06"></i>
                </div>
            </a>
        </li>
    }

</ul>
<!--End Cards-->

<div class="row">
    <div class="col-md-8">
        <div class="widget-box2 mt-2">
            <h5 class="cardHeader">OS em aberto</h5>
            <div class="table-responsive" style="height: 300px;">
                <div class="widget-content">
                    <table>
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th>Cliente</th>
                                <th>Qtd</th>
                                <th>Valor</th>
                                <th>Solicitado em</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Os == null || Model.Os.Count == 0)
                            {
                                <tr>
                                    <td colspan="7">Nenhuma OS cadastrada</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var os in Model.Os)
                                {
                                    <tr>
                                        <td>@os.Id</td>
                                        <td>@os.Clientes.Nome</td>
                                        <td><span class="badge">@os.Status</span></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="new-statisc mt-2">
            <div class="widget-box-new widbox-blak h-100">
                <h5 class="cardHeader">Estatísticas</h5>
                <div class="new-bottons p-2">
                    <a href="#" class="card tip-top text-decoration-none m-1" title="Add clientes e fornecedores">
                        <div><i class='bx bxs-group iconBx'></i></div>
                        <div>
                            <div class="cardName2">@Model.Clientes.Count()</div>
                            <div class="cardName">Clientes</div>
                        </div>
                    </a>

                    <a href="#" class="card tip-top text-decoration-none m-1" title="Adicionar produtos">
                        <div><i class='bx bxs-package iconBx2'></i></div>
                        <div>
                            <div class="cardName2">@Model.Produtos.Count()</div>
                            <div class="cardName">Produtos</div>
                        </div>
                    </a>

                    <a href="#" class="card tip-top text-decoration-none m-1" title="Adicionar pedido">
                        <div><i class='bx bxs-cart-alt iconBx5'></i></div>
                        <div>
                            <div class="cardName2">@Model.Os.Count()</div>
                            <div class="cardName">Pedidos</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="widget-box0 widbox-blak mt-2" style="height: 300px;">
            <div>
                <h5 class="cardHeader">Pedidos em andamento</h5>
            </div>
            <div class="widget-content table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Cliente</th>
                            <th style="text-align: center;">Qtd</th>
                            <th style="text-align: center;">Valor</th>
                            <th>Solicitado em</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7">Nenhum pedido entregue</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="widget-box0 widbox-blak  mt-2" style="height: 300px; overflow-x: auto;">
            <div>
                <h5 class="cardHeader">Pedidos entregues</h5>
            </div>
            <div class="widget-content table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Cliente</th>
                            <th style="text-align: center;">Qtd</th>
                            <th style="text-align: center;">Valor</th>
                            <th>Solicitado em</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7">Nenhum pedido entregue</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>