@using SIGES.Helpers
@using SIGES.ViewModel
@model EmitenteViewModel

@{
    ViewData["Titulo"] = "Emitente";
}

<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Emitente</h5>
    </div>
    <div class="span12" style="margin-left: 0">
        <div class="span3">
            <a role="button" class="button btn btn-mini btn-success" style="max-width: 100px" asp-controller="Emitente" asp-action="Adicionar">
                <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                <span class="button__text2">Emitente</span>
            </a>
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content">
            <table id="tabela">
                <thead>
                    <tr>
                        <th style="width: 70%;">Nome</th>
                        <th style="width: 10%;">Cnpj</th>
                        <th style="width: 10%;">Ie</th>
                        <th style="width: 10%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Emitentes == null || Model.Emitentes.Count == 0)
                    {
                        <tr>
                            <td colspan="4">Nenhum emitente cadastrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var emitente in Model.Emitentes)
                        {
                            <tr>
                                <td>@emitente.Nome</td>
                                <td>@emitente.Cnpj</td>
                                <td>@emitente.Ie</td>
                                <td>
                                    <a href="#" data-entidade="EmitenteModel" data-id="@emitente.Id" style="margin-right: 1%" class="btn-nwe7 btn-exibir-log text-decoration-none" title="Exibir histórico">
                                        <i class='bx bx-history'></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")