@using SIGES.Helpers
@using SIGES.ViewModel
@model PermissaoViewModel

@{
    ViewData["Titulo"] = "Permissões";
}



<div class="new122">
    <div class="widget-title" style="margin: -20px 0 0">
        <span class="icon">
            <i class="fas fa-user"></i>
        </span>
        <h5>Permissões</h5>
    </div>
    <div class="col-lg-12" style="margin-left: 0">
        <div class="col-md-2">
            @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "aPermissao"))
            {
                <a role="button" class="button btn btn-mini btn-success w-100" asp-controller="Permissao" asp-action="Adicionar">
                    <span class="button__icon"><i class='bx bx-plus-circle'></i></span>
                    <span class="button__text2">Permissão</span>
                </a>
            }
        </div>
    </div>

    <div class="widget-box">
        <h5 style="padding: 3px 0"></h5>
        <div class="widget-content nopadding tab-content table-responsive">
            <table id="tabela">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nome</th>
                        <th>Data de Criação</th>
                        <th>Situação</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Permissoes == null || Model.Permissoes.Count == 0)
                    {
                        <tr>
                            <td colspan="3">Nenhuma permissão cadastrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var permissao in Model.Permissoes)
                        {
                            <tr>
                                <td>@permissao.Id</td>
                                <td>@permissao.Nome</td>
                                <td>@permissao.Data?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge rounded-pill @(permissao.Situacao.Equals(0) ? "text-bg-danger" : "text-bg-success")">
                                        @(permissao.Situacao.Equals(0) ? "Inativo" : "Ativo")
                                    </span>
                                </td>
                                <td>
                                    <a href="#" data-entidade="PermissaoModel" data-id="@permissao.Id" style="margin-right: 1%" class="btn-nwe7 btn-exibir-log text-decoration-none" title="Exibir histórico">
                                        <i class='bx bx-history'></i>
                                    </a>
                                    @if (PermissaoHelper.TemPermissao(ViewContext.HttpContext, "ePermissao"))
                                    {
                                        <a asp-controller="Permissao" asp-action="Editar" asp-route-id="@permissao.Id" style="margin-right: 1%" class="btn-nwe3 text-decoration-none" title="Editar permissão">
                                            <i class="bx bx-edit bx-xs"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a role="button" class="btn-nwe3-disabled text-decoration-none disabled" style="margin-right: 1%" title="Você não tem permissão para editar">
                                            <i class="bx bx-edit bx-xs"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalLog")