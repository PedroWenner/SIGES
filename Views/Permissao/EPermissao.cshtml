@model PermissaoModel

@{
    ViewData["Titulo"] = "Editar permissão";

    @if (Model.Situacao.Equals(1))
    {
        var sim = "selected";
        var nao = "";
    }
    else
    {
        var sim = "";
        var nao = "selected";
    }
}

<style>
    .accordion .widget-box {
        margin-top: 10px;
        margin-bottom: 0;
        border-radius: 6px;
    }

    .accordion {
        margin-top: -25px;
    }

    .collapse.in {
        top: -15px
    }
</style>

<div class="container mt-4">
    <form id="formPermissao" method="post">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex align-items-center">
                <i class="fas fa-lock me-2"></i>
                <h5 class="mb-0">Editar permissão</h5>
            </div>
            <div class="card-body">
                <!-- Nome da Permissão -->
                <div class="mb-3 d-flex">
                    <div class="col-md-4 me-2">
                        <label for="nome" class="form-label">Nome da Permissão</label>
                        <input asp-for="Id" type="hidden">
                        <input asp-for="Nome" type="text" id="nome" class="form-control" required>
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 me-2">
                        <label for="situacao" class="form-label">Situação</label>
                        <select asp-for="Situacao" id="situacao" required>
                            <option value="1" sim>Ativo</option>
                            <option value="0" nao>Inativo</option>
                        </select>
                    </div>
                    <div class="col-md-4 align-content-end">
                        <input class="form-check-input" type="checkbox" value="1" id="marcarTodos">
                        <label class="form-check-label" for="marcarTodos">Marcar todos</label>
                    </div>
                </div>
                <br /><br />
                <!-- Accordion -->
                <div class="accordion accordion-flush" id="permissionsAccordion">

                    <!-- Pedidos -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingPedidos">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePedidos" aria-expanded="true" aria-controls="collapsePedidos">
                                <i class="bx bx-package me-2"></i> Pedidos
                            </button>
                        </h2>
                        <div id="collapsePedidos" class="accordion-collapse collapse show" aria-labelledby="headingPedidos" data-bs-parent="#permissionsAccordion">
                            <div class="accordion-body">
                                <table>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <div class="form-check">
                                                    <input class="form-check-input marcar" type="checkbox" name="vPedido" value="1" @if (ViewData["vPedido"]?.ToString() == "checked")
                                                    {
                                                        <text>checked</text>
                                                    } />
                                                    <label class="form-check-label">Visualizar Pedido</label>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-check">
                                                    <input class="form-check-input marcar" type="checkbox" name="aPedido" value="1" @if (ViewData["aPedido"]?.ToString() == "checked")
                                                    {
                                                        <text>checked</text>
                                                    } />
                                                    <label class="form-check-label">Adicionar Pedido</label>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-check">
                                                    <input class="form-check-input marcar" type="checkbox" name="ePedido" value="1"
                                                    @if (ViewData["ePedido"]?.ToString() == "checked")
                                                    {
                                                        <text>checked</text>
                                                    } />
                                                    <label class="form-check-label">Editar Pedido</label>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-check">
                                                    <input class="form-check-input marcar" type="checkbox" name="dPedido" value="1" @if (ViewData["dPedido"]?.ToString() == "checked")
                                                    {
                                                        <text>checked</text>
                                                    } />
                                                    <label class="form-check-label">Excluir Pedido</label>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

